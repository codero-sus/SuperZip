// G0D SZIP — CLI (g0dszip). Own encoder/decoder; no third-party code.
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <string>

#include "szip.h"

namespace {

const char *err_name(int e) {
  switch (e) {
  case SZIP_OK: return "ok";
  case SZIP_ERR_IO: return "i/o error";
  case SZIP_ERR_FORMAT: return "bad format";
  case SZIP_ERR_CORRUPT: return "corrupt archive";
  case SZIP_ERR_UNSUPPORTED: return "unsupported feature";
  case SZIP_ERR_NOMEM: return "out of memory";
  case SZIP_ERR_TRUNCATED: return "truncated archive";
  case SZIP_ERR_BUFFER: return "buffer too small";
  default: return "unknown error";
  }
}

void usage() {
  std::fprintf(stderr,
               "G0D SZIP — SuperZip compressor (format .szip)\n"
               "\n"
               "usage:\n"
               "  g0dszip c|compress  [-f] [-b blocksize] <input> <output.szip>\n"
               "  g0dszip d|decompress <input.szip> <output>\n"
               "  g0dszip t|test       <input.szip>\n"
               "  g0dszip i|info       <input.szip>\n"
               "  g0dszip g|gui        [port]     lightweight web GUI\n"
               "\n"
               "  -f     fast parse (quicker encode, slightly larger output)\n"
               "  -b N   raw block size in bytes (default 1048576, max 16777216)\n");
}

bool parse_u32(const char *s, uint32_t *v) {
  char *end = nullptr;
  const unsigned long long x = std::strtoull(s, &end, 10);
  if (!end || *end != 0 || x == 0 || x > 0xFFFFFFFFull) return false;
  *v = static_cast<uint32_t>(x);
  return true;
}

int cmd_info(const char *path) {
  uint64_t raw = 0;
  // test_file validates and returns the raw size
  const int e = szip::test_file(path, &raw);
  if (e != SZIP_OK) {
    std::fprintf(stderr, "info: %s: %s\n", path, err_name(e));
    return 1;
  }
  std::FILE *f = std::fopen(path, "rb");
  if (!f) {
    std::fprintf(stderr, "info: cannot open %s\n", path);
    return 1;
  }
  std::fseek(f, 0, SEEK_END);
  const long comp = std::ftell(f);
  std::fclose(f);
  std::printf("file       : %s\n", path);
  std::printf("format     : .szip v%d\n", SZIP_VERSION);
  std::printf("codec      : SZLZRC v3 (LZ77 + rep-matches + context-mixing literals)\n");
  std::printf("raw size   : %llu bytes\n", (unsigned long long)raw);
  std::printf("archive    : %ld bytes\n", comp);
  if (raw > 0)
    std::printf("ratio      : %.2f%%  (%.3f bits/byte)\n",
                100.0 * (double)comp / (double)raw,
                8.0 * (double)comp / (double)raw);
  std::printf("integrity  : CRC32 verified\n");
  return 0;
}

} // namespace

int main(int argc, char **argv) {
  if (argc < 2) {
    // GUI is the default entry point: plain `g0dszip` opens it.
    return szip::run_gui(8848);
  }
  const std::string cmd = argv[1];

  if (cmd == "-h" || cmd == "--help" || cmd == "help") {
    usage();
    return 0;
  }

  if (cmd == "g" || cmd == "gui") {
    unsigned short port = 8848;
    if (argc >= 3) {
      uint32_t v = 0;
      if (!parse_u32(argv[2], &v) || v > 65535) {
        std::fprintf(stderr, "bad port: %s\n", argv[2]);
        return 2;
      }
      port = static_cast<unsigned short>(v);
    }
    return szip::run_gui(port);
  }

  if (cmd == "c" || cmd == "compress") {
    uint32_t block_size = SZIP_DEFAULT_BLOCK_SIZE;
    int fast = 0;
    int i = 2;
    while (i < argc && argv[i][0] == '-') {
      if (std::strcmp(argv[i], "-b") == 0 && i + 1 < argc) {
        if (!parse_u32(argv[i + 1], &block_size)) {
          std::fprintf(stderr, "bad block size: %s\n", argv[i + 1]);
          return 2;
        }
        i += 2;
      } else if (std::strcmp(argv[i], "-f") == 0 ||
                 std::strcmp(argv[i], "--fast") == 0) {
        fast = 1;
        i += 1;
      } else {
        std::fprintf(stderr, "unknown option: %s\n", argv[i]);
        return 2;
      }
    }
    if (argc - i != 2) {
      usage();
      return 2;
    }
    szip::set_parse_fast(fast);
    const int e = szip::compress_file(argv[i], argv[i + 1], block_size);
    if (e != SZIP_OK) {
      std::fprintf(stderr, "compress: %s\n", err_name(e));
      return 1;
    }
    return 0;
  }

  if (cmd == "d" || cmd == "decompress") {
    if (argc != 4) {
      usage();
      return 2;
    }
    const int e = szip::decompress_file(argv[2], argv[3], nullptr, nullptr);
    if (e != SZIP_OK) {
      std::fprintf(stderr, "decompress: %s\n", err_name(e));
      return 1;
    }
    return 0;
  }

  if (cmd == "t" || cmd == "test") {
    if (argc != 3) {
      usage();
      return 2;
    }
    uint64_t raw = 0;
    const int e = szip::test_file(argv[2], &raw);
    if (e != SZIP_OK) {
      std::fprintf(stderr, "test: %s: %s\n", argv[2], err_name(e));
      return 1;
    }
    std::printf("%s: ok (%llu bytes)\n", argv[2], (unsigned long long)raw);
    return 0;
  }

  if (cmd == "i" || cmd == "info") {
    if (argc != 3) {
      usage();
      return 2;
    }
    return cmd_info(argv[2]);
  }

  usage();
  return 2;
}
// G0D SZIP — SZLZRC v3 block codec, .szip container, C ABI.
// Original implementation for SuperZip; no third-party compression code.
//
// SZLZRC v3: LZ77 (hash chains, lazy) + last-3 rep offsets + context-mixing
// literals + adaptive binary range coder.
#include "szip.h"

#include <algorithm>
#include <cstdio>
#include <cstring>
#include <thread>
#include <chrono>
#include <sstream>
#include <memory>
#include <fstream>
#include <vector>

#include "crc32.hpp"
#include "lz77.hpp"
#include "mix.hpp"
#ifndef SZ_MATCHBIAS
#define SZ_MATCHBIAS 16
#endif
#ifndef SZ_NOMATCH
#define SZ_NOMATCH 0
#endif
#include "rc.hpp"

#ifndef SZ_STATS
#define SZ_STATS 0
#endif
#if SZ_STATS
static uint64_t st_lit, st_rep[3], st_norm, st_repb, st_nmb, st_bytes;
static uint64_t st_nhist[24];
static uint64_t st_offbits, st_lenbits, st_litbits, st_tokbits;
#endif

namespace szip {
namespace {

// ---------------------------------------------------------------- models --

struct Model {
  Prob is_match = kProbInit;
  Prob is_rep = kProbInit;
  Prob rep_sel[2] = {kProbInit, kProbInit}; // 0: rep0|rep12, 1: rep1|rep2
  Prob len_unary[10];             // gamma of (len - 2)
  Prob len_bits[10];
  Prob off_mode = kProbInit;      // 0: tiny (off 1-4), 1: slot+direct
  Prob tiny_unary[8];             // gamma of (off), x in [1, 4]
  Prob tiny_bits[8];
  Prob slot_unary[12];            // gamma of (n - 2), x in [1, 18]
  Prob slot_bits[10];
  Prob off_direct[19];            // raw high bits of off-1
  Prob off_align[16];             // 4-bit align tree for the low bits

  Model() {
    std::fill(std::begin(len_unary), std::end(len_unary), static_cast<Prob>(kProbInit));
    std::fill(std::begin(len_bits), std::end(len_bits), static_cast<Prob>(kProbInit));
    std::fill(std::begin(tiny_unary), std::end(tiny_unary), static_cast<Prob>(kProbInit));
    std::fill(std::begin(tiny_bits), std::end(tiny_bits), static_cast<Prob>(kProbInit));
    std::fill(std::begin(slot_unary), std::end(slot_unary), static_cast<Prob>(kProbInit));
    std::fill(std::begin(slot_bits), std::end(slot_bits), static_cast<Prob>(kProbInit));
    std::fill(std::begin(off_direct), std::end(off_direct), static_cast<Prob>(kProbInit));
    std::fill(std::begin(off_align), std::end(off_align), static_cast<Prob>(kProbInit));
  }

};

#ifndef SZ_ALIGN
#define SZ_ALIGN 1
#endif

// ------------------------------------------------------------- primitives --

// Elias gamma for x >= 1: n one-bits, one zero-bit, then n low bits MSB first.
void encode_gamma(RcEncoder &rc, Prob *unary, Prob *bits, uint32_t x) {
  uint32_t n = 0;
  while ((2u << n) <= x) ++n;
  for (uint32_t i = 0; i < n; ++i) rc.encode_bit(unary[i], 1);
  rc.encode_bit(unary[n], 0);
  for (uint32_t i = n; i-- > 0;) rc.encode_bit(bits[i], (x >> i) & 1u);
}

int decode_gamma(RcDecoder &rc, Prob *unary, Prob *bits, uint32_t n_max,
                 uint32_t *out) {
  uint32_t n = 0;
  while (rc.decode_bit(unary[n]) == 1) {
    ++n;
    if (n > n_max) return SZIP_ERR_CORRUPT;
  }
  uint32_t x = 1;
  for (uint32_t i = n; i-- > 0;) x = (x << 1) | rc.decode_bit(bits[i]);
  *out = x;
  return SZIP_OK;
}

// Offset: u = off - 1, n = bitlen(u).
//   tiny mode  (off 1-4):      gamma(off)
//   slot mode  (off >= 5):     gamma(n - 2), then n-1 direct low bits of u
void encode_offset(RcEncoder &rc, Model &m, uint32_t off) {
  const uint32_t u = off - 1;
#if SZ_STATS
  { uint32_t nn = 0; while ((1u << nn) <= u) ++nn; ++st_nhist[nn]; }
#endif
  if (u < 4) {
    rc.encode_bit(m.off_mode, 0);
    encode_gamma(rc, m.tiny_unary, m.tiny_bits, off);
    return;
  }
  rc.encode_bit(m.off_mode, 1);
  uint32_t n = 0;
  while ((1u << n) <= u) ++n;
  encode_gamma(rc, m.slot_unary, m.slot_bits, n - 2);
  const uint32_t ncoded = n - 1;
  const uint32_t ntree = ncoded < 4 ? ncoded : 4;
  if (SZ_ALIGN) {
    uint32_t idx = 1;
    for (uint32_t t = ntree; t-- > 0;) {
      const uint32_t bit = (u >> t) & 1u;
      rc.encode_bit(m.off_align[idx], bit);
      idx = (idx << 1) | bit;
    }
    for (uint32_t i = ncoded; i-- > ntree;)
      rc.encode_bit(m.off_direct[i], (u >> i) & 1u);
  } else {
    for (uint32_t i = n - 1; i-- > 0;)
      rc.encode_bit(m.off_direct[i], (u >> i) & 1u);
  }
}

// ---- model-only training twins (no RC) for parse planning -----------------
static inline void bit_train(Prob &p, uint32_t bit) {
  if (bit == 0) p = (Prob)(p + ((2048 - p) >> 5));
  else p = (Prob)(p - (p >> 5));
}

static void train_gamma(Prob *unary, Prob *bits, uint32_t x) {
  uint32_t n = 0;
  while ((2u << n) <= x) ++n;
  for (uint32_t i = 0; i < n; ++i) bit_train(unary[i], 1);
  bit_train(unary[n], 0);
  for (uint32_t i = n; i-- > 0;) bit_train(bits[i], (x >> i) & 1u);
}

static void train_offset(Model &m, uint32_t off) {
  const uint32_t u = off - 1;
  if (u < 4) {
    bit_train(m.off_mode, 0);
    train_gamma(m.tiny_unary, m.tiny_bits, off);
    return;
  }
  bit_train(m.off_mode, 1);
  uint32_t n = 0;
  while ((1u << n) <= u) ++n;
  train_gamma(m.slot_unary, m.slot_bits, n - 2);
  for (uint32_t i = n - 1; i-- > 0;)
    bit_train(m.off_direct[i], (u >> i) & 1u);
}

static void train_rep_token(Model &m, uint32_t idx, uint32_t len) {
  bit_train(m.is_match, 1);
  bit_train(m.is_rep, 1);
  bit_train(m.rep_sel[0], idx == 0 ? 0u : 1u);
  if (idx != 0) bit_train(m.rep_sel[1], idx == 1 ? 0u : 1u);
  train_gamma(m.len_unary, m.len_bits, len - 2);
}

static void train_norm_token(Model &m, uint32_t off, uint32_t len) {
  bit_train(m.is_match, 1);
  bit_train(m.is_rep, 0);
  train_offset(m, off);
  train_gamma(m.len_unary, m.len_bits, len - 2);
}

// ---- read-only token prices (1/16-bit units) for parse decisions ----------
static inline uint32_t price_bit(Prob p, uint32_t bit) {
  return kBitPrice[bit == 0 ? p : 2048u - (uint32_t)p];
}

static uint32_t price_gamma_p(const Prob *unary, const Prob *bits, uint32_t x) {
  uint32_t n = 0;
  while ((2u << n) <= x) ++n;
  uint32_t price = 0;
  for (uint32_t i = 0; i < n; ++i) price += price_bit(unary[i], 1);
  price += price_bit(unary[n], 0);
  for (uint32_t i = n; i-- > 0;) price += price_bit(bits[i], (x >> i) & 1u);
  return price;
}

static uint32_t price_offset_p(const Model &m, uint32_t off) {
  const uint32_t u = off - 1;
  if (u < 4) {
    return price_bit(m.off_mode, 0) +
           price_gamma_p(m.tiny_unary, m.tiny_bits, off);
  }
  uint32_t price = price_bit(m.off_mode, 1);
  uint32_t n = 0;
  while ((1u << n) <= u) ++n;
  price += price_gamma_p(m.slot_unary, m.slot_bits, n - 2);
  const uint32_t ncoded = n - 1;
  const uint32_t ntree = ncoded < 4 ? ncoded : 4;
  if (SZ_ALIGN) {
    uint32_t idx = 1;
    for (uint32_t t = ntree; t-- > 0;) {
      const uint32_t bit = (u >> t) & 1u;
      price += price_bit(m.off_align[idx], bit);
      idx = (idx << 1) | bit;
    }
    for (uint32_t i = ncoded; i-- > ntree;)
      price += price_bit(m.off_direct[i], (u >> i) & 1u);
  } else {
    for (uint32_t i = n - 1; i-- > 0;)
      price += price_bit(m.off_direct[i], (u >> i) & 1u);
  }
  return price;
}

[[maybe_unused]] static uint32_t price_rep_token(const Model &m, uint32_t idx, uint32_t len) {
  uint32_t price = price_bit(m.is_match, 1) + price_bit(m.is_rep, 1);
  price += price_bit(m.rep_sel[0], idx == 0 ? 0u : 1u);
  if (idx != 0) price += price_bit(m.rep_sel[1], idx == 1 ? 0u : 1u);
  price += price_gamma_p(m.len_unary, m.len_bits, len - 2);
  return price;
}

[[maybe_unused]] static uint32_t price_norm_token(const Model &m, uint32_t off, uint32_t len) {
  uint32_t price = price_bit(m.is_match, 1) + price_bit(m.is_rep, 0);
  price += price_offset_p(m, off);
  price += price_gamma_p(m.len_unary, m.len_bits, len - 2);
  return price;
}

int decode_offset(RcDecoder &rc, Model &m, uint32_t *out) {
  if (rc.decode_bit(m.off_mode) == 0) {
    uint32_t off = 0;
    int e = decode_gamma(rc, m.tiny_unary, m.tiny_bits, 6, &off);
    if (e != SZIP_OK) return e;
    if (off == 0 || off > 4) return SZIP_ERR_CORRUPT;
    *out = off;
    return SZIP_OK;
  }
  uint32_t x = 0;
  int e = decode_gamma(rc, m.slot_unary, m.slot_bits, 10, &x);
  if (e != SZIP_OK) return e;
  if (x < 1 || x > 18) return SZIP_ERR_CORRUPT;
  const uint32_t n = x + 2;
  uint32_t u = 1u << (n - 1);
  const uint32_t ncoded = n - 1;
  const uint32_t ntree = ncoded < 4 ? ncoded : 4;
  if (SZ_ALIGN) {
    uint32_t idx = 1;
    for (uint32_t t = ntree; t-- > 0;) {
      const uint32_t bit = rc.decode_bit(m.off_align[idx]);
      idx = (idx << 1) | bit;
      u |= bit << t;
    }
    for (uint32_t i = ncoded; i-- > ntree;)
      u |= rc.decode_bit(m.off_direct[i]) << i;
  } else {
    for (uint32_t i = n - 1; i-- > 0;)
      u |= rc.decode_bit(m.off_direct[i]) << i;
  }
  if (u + 1 > SZIP_MAX_OFFSET) return SZIP_ERR_CORRUPT;
  *out = u + 1;
  return SZIP_OK;
}

// ------------------------------------------------------------ block codec --

struct RepPick {
  uint32_t len = 0;
  uint32_t idx = 0;
};

RepPick rep_match(const uint8_t *src, uint32_t n, uint32_t pos,
                  const uint32_t reps[3]) {
  RepPick best;
  const uint32_t max_len = std::min<uint32_t>(kMaxMatch, n - pos);
  for (uint32_t i = 0; i < 3; ++i) {
    const uint32_t off = reps[i];
    if (off == 0 || off > pos) continue;
    uint32_t len = 0;
    while (len < max_len && src[pos + len] == src[pos - off + len]) ++len;
    if (len >= kMinMatch && len > best.len) {
      best.len = len;
      best.idx = i;
    }
  }
  return best;
}

void reps_after_normal(uint32_t reps[3], uint32_t off) {
  reps[2] = reps[1];
  reps[1] = reps[0];
  reps[0] = off;
}

void reps_after_rep(uint32_t reps[3], uint32_t idx) {
  if (idx > 0) {
    const uint32_t tmp = reps[idx];
    for (uint32_t j = idx; j > 0; --j) reps[j] = reps[j - 1];
    reps[0] = tmp;
  }
}

// ---------------------------------------------------------------------------
// DP optimal parse: shortest path over byte positions.
//
// Nodes are "arrivals" at a position carrying their rep-offset state.
// Edges: literal (exact mixed-model price), rep match, normal match (token
// prices from an online-calibrated token model). The mixed literal model is a
// pure function of the raw prefix, so its per-byte peek prices are exact
// regardless of parse. The decoder is agnostic to all of this.
// ---------------------------------------------------------------------------

struct PlanTok {
  uint32_t len;      // 0 = literal
  uint32_t off;      // normal-match offset (unused for literal/rep)
  uint32_t rep_idx;  // 0..2 for rep tokens, UINT32_MAX for normal/literal
};

struct DPNode {
  uint64_t cost;     // 1/16-bit units
  uint32_t prev;     // pool index, UINT32_MAX = start
  uint32_t reps[3];
  uint32_t len;      // transition INTO this node: 0 = literal
  uint32_t off;
  uint32_t rep_idx;
};

#ifndef SZ_DP_NO_REP
#define SZ_DP_NO_REP 0
#endif
#ifndef SZ_DP_NO_NORM
#define SZ_DP_NO_NORM 0
#endif
#ifndef SZ_ABEAM
#define SZ_ABEAM 8
#endif
constexpr uint32_t kDPBeam = SZ_ABEAM;
constexpr uint32_t kBeamSlots = 32; // allocation stride (>= any beam_cap)
double plan_cost_estimate = 0;

// lengths whose tokens are evaluated as match edges
#ifndef SZ_ALLLEN
#define SZ_ALLLEN 1
#endif
#ifndef SZ_LCAP
#define SZ_LCAP 0
#endif
// Encoder-side parse knob (set_parse_fast): 0 = max ratio, 1 = fast parse.
static int g_parse_fast = 0;
// rank 0 = best candidate (fine lengths); rank > 0 = secondary (coarse).
static void collect_lens(uint32_t max_len, uint32_t rank,
                         std::vector<uint32_t> &lens) {
  lens.clear();
  // fast parse: coarse length sets (best candidate finer than the rest)
  const uint32_t fine =
      g_parse_fast ? (rank == 0 ? 64u : 24u) : 4096u;
  if (SZ_ALLLEN && !g_parse_fast && rank == 0 && !SZ_LCAP) {
    for (uint32_t l = kMinMatch; l <= max_len; ++l) lens.push_back(l);
    return;
  }
  const uint32_t hi = max_len < fine ? max_len : fine;
  for (uint32_t l = kMinMatch; l <= hi; ++l) lens.push_back(l);
  for (uint32_t b = 4; b <= 15; ++b) {
    const uint32_t l = (1u << b) + 2;
    if (l > fine && l < max_len) lens.push_back(l);
  }
  if (max_len > fine) lens.push_back(max_len);
}

// guide != nullptr: calibrate the price model EXACTLY along the guide plan's
// token history (matching the emit walk's training), instead of the noisy
// leading-arrival heuristic. Returns the plan via `plan`.
// Match candidates depend only on (src, pos): build once, share across all
// planning passes and both modes. Canonical insertion order (positions 0..n-1)
// makes the finder deterministic and cacheable.
#ifndef SZ_CANDW
#define SZ_CANDW 24 // finder cache width (match candidates per position)
#endif
#ifndef SZ_PASSES
#define SZ_PASSES 6 // DP parse passes (pass 1 online, rest exact-along-plan)
#endif
#ifndef SZ_GBEAM
#define SZ_GBEAM 32 // DP beam width for the guided passes
#endif
#ifndef SZ_MCAND
#define SZ_MCAND 12 // match candidates offered to the parse
#endif
struct CandCache {
  std::vector<uint8_t> cnt;
  std::vector<Match> m; // SZ_CANDW per position
};
static void build_cand_cache(const uint8_t *src, uint32_t n, CandCache &cc) {
  cc.cnt.assign(n, 0);
  cc.m.assign((size_t)n * SZ_CANDW, Match{0, 0});
  MatchFinder mf;
  mf.prepare(n);
  for (uint32_t pos = 0; pos < n; ++pos) {
    mf.insert(src, n, pos);
    Match tmp[SZ_CANDW];
    const uint32_t k = mf.find_multi(src, n, pos, tmp, SZ_CANDW);
    cc.cnt[pos] = (uint8_t)k;
    for (uint32_t i = 0; i < k; ++i) cc.m[(size_t)pos * SZ_CANDW + i] = tmp[i];
  }
}

void plan_block_pass(const uint8_t *src, uint32_t n, std::vector<PlanTok> &plan,
                     const std::vector<PlanTok> *guide, uint32_t mode,
                     const CandCache &cc, std::vector<uint32_t> &litp_cache) {
  plan.clear();
  plan_cost_estimate = 0;
  if (n == 0) return;

  // precompute guide token boundaries: gin[pos] = guide token ending at pos
  std::vector<int32_t> gin;
  std::vector<uint32_t> greps0;
  if (guide) {
    gin.assign(n + 1, -1);
    greps0.assign(n + 1, 0);
    uint32_t reps[3] = {0, 0, 0};
    uint32_t pos = 0;
    for (uint32_t i = 0; i < guide->size(); ++i) {
      const PlanTok &t = (*guide)[i];
      if (t.len == 0) {
        gin[pos + 1] = (int32_t)i;
        greps0[pos + 1] = reps[0];
        pos += 1;
      } else {
        if (t.rep_idx != UINT32_MAX) reps_after_rep(reps, t.rep_idx);
        else reps_after_normal(reps, t.off);
        gin[pos + t.len] = (int32_t)i;
        greps0[pos + t.len] = reps[0];
        pos += t.len;
      }
    }
  }

  Model ms;                 // online-calibrated price model
  std::unique_ptr<MixLit> mix; // live literal prices (unguided pass only)
  if (!guide) mix.reset(new MixLit(mode));
  Hist hist;

  std::vector<DPNode> pool;
  pool.reserve((size_t)n * 6 + 64);
  std::vector<uint32_t> free_nodes;
  free_nodes.reserve(256);
  std::vector<uint32_t> best_cnt(n + 1, 0);
  std::vector<uint32_t> best_slot((size_t)(n + 1) * kBeamSlots, 0);

  DPNode start;
  start.cost = 0;
  start.prev = UINT32_MAX;
  start.reps[0] = start.reps[1] = start.reps[2] = 0;
  start.len = start.off = start.rep_idx = 0;
  pool.push_back(start);
  best_slot[0] = 0;
  best_cnt[0] = 1;

  const uint32_t beam_cap =
      g_parse_fast ? 4u
      : (guide ? ((uint32_t)SZ_GBEAM < kBeamSlots ? (uint32_t)SZ_GBEAM
                                               : kBeamSlots)
               : kDPBeam);
  // Recycle nodes dropped from a best list (replaced or evicted): such nodes
  // are provably never prev-ancestors of anything (lists freeze before their
  // position is processed), so reuse is exact.
  auto new_node = [&](const DPNode &nd) -> uint32_t {
    if (!free_nodes.empty()) {
      const uint32_t idx = free_nodes.back();
      free_nodes.pop_back();
      pool[idx] = nd;
      return idx;
    }
    pool.push_back(nd);
    return (uint32_t)(pool.size() - 1);
  };
  auto try_insert = [&](uint32_t q, const DPNode &nd) {
    uint32_t *lst = &best_slot[(size_t)q * kBeamSlots];
    uint32_t &cnt = best_cnt[q];
    for (uint32_t i = 0; i < cnt; ++i) {
      const uint32_t old = lst[i];
      const DPNode &o = pool[old];
      if (o.reps[0] == nd.reps[0] && o.reps[1] == nd.reps[1] &&
          o.reps[2] == nd.reps[2]) {
        if (nd.cost < o.cost) {
          lst[i] = new_node(nd);
          free_nodes.push_back(old);
        }
        return;
      }
    }
    if (cnt < beam_cap) {
      lst[cnt++] = new_node(nd);
      return;
    }
    uint32_t worst = 0;
    for (uint32_t i = 1; i < cnt; ++i)
      if (pool[lst[i]].cost > pool[lst[worst]].cost) worst = i;
    if (nd.cost < pool[lst[worst]].cost) {
      const uint32_t old = lst[worst];
      lst[worst] = new_node(nd);
      free_nodes.push_back(old);
    }
  };

  std::vector<uint32_t> lens;
  lens.reserve(64);
  std::vector<uint32_t> lenp(kMaxMatch + 1, 0);

  for (uint32_t pos = 0; pos < n; ++pos) {
    if (best_cnt[pos] == 0) continue;

    // calibrate the price model
    uint8_t mb = 0;
    uint8_t st = 0;
    if (guide) {
      if (gin[pos] >= 0) {
        const PlanTok &g = (*guide)[(uint32_t)gin[pos]];
        if (g.len == 0) { bit_train(ms.is_match, 0); st = 0; }
        else if (g.rep_idx != UINT32_MAX) { train_rep_token(ms, g.rep_idx, g.len); st = 1; }
        else { train_norm_token(ms, g.off, g.len); st = 2; }
      }
      mb = (uint8_t)((pos >= greps0[pos]) ? src[pos - greps0[pos]] : 0);
    } else {
      uint32_t lead = best_slot[(size_t)pos * kBeamSlots];
      for (uint32_t i = 0; i < best_cnt[pos]; ++i) {
        uint32_t idx = best_slot[(size_t)pos * kBeamSlots + i];
        if (pool[idx].cost < pool[lead].cost) lead = idx;
      }
      const DPNode &L = pool[lead];
      if (L.prev != UINT32_MAX) {
        if (L.len == 0) { bit_train(ms.is_match, 0); st = 0; }
        else if (L.rep_idx != UINT32_MAX) { train_rep_token(ms, L.rep_idx, L.len); st = 1; }
        else { train_norm_token(ms, L.off, L.len); st = 2; }
      }
      mb = (uint8_t)((pos >= L.reps[0]) ? src[pos - L.reps[0]] : 0);
    }

    uint32_t litp;
    if (guide) {
      litp = litp_cache[pos]; // exact price cached by the unguided pass
    } else {
      litp = mix->peek(hist, src[pos], mb, st);
      litp_cache[pos] = litp;
    }
#if SZ_STATS
    plan_cost_estimate += (double)litp; // debug: sum of literal prices
#endif
    Match cands[16];
    const uint32_t mcc = g_parse_fast ? 6u : (uint32_t)SZ_MCAND;
    const uint32_t ncand = SZ_DP_NO_NORM ? 0u : cc.cnt[pos];
    for (uint32_t i = 0; i < ncand && i < mcc; ++i)
      cands[i] = cc.m[(size_t)pos * SZ_CANDW + i];

    // ms is constant within a position: pre-price every length and every
    // candidate distance ONCE instead of per (arrival, candidate, length).
    // Only price the lengths this position can actually offer.
    uint32_t norm_prefix[16];
    uint32_t max_need = kMinMatch;
    for (uint32_t ci = 0; ci < ncand && ci < mcc; ++ci) {
      norm_prefix[ci] = price_bit(ms.is_match, 1) + price_bit(ms.is_rep, 0) +
                        price_offset_p(ms, cands[ci].off);
      if (cands[ci].len > max_need) max_need = cands[ci].len;
    }
    if (!SZ_DP_NO_REP) {
      // the rep branch runs per arrival; cheap bound: cover all lengths once
      if (kMaxMatch > max_need) max_need = max_need; // capped below by needs
    }
    for (uint32_t l = kMinMatch; l <= max_need && l <= kMaxMatch; ++l)
      lenp[l] = price_gamma_p(ms.len_unary, ms.len_bits, l - 2);

    for (uint32_t bi = 0; bi < best_cnt[pos]; ++bi) {
      uint32_t idx = best_slot[(size_t)pos * kBeamSlots + bi];
      const DPNode A = pool[idx]; // copy: try_insert may realloc pool

      // literal edge (guided pass prices the is_match=0 bit too: exact there)
      {
        DPNode nd = A;
        nd.cost = A.cost + litp + (guide ? price_bit(ms.is_match, 0) : 0u);
        nd.prev = idx;
        nd.len = 0;
        nd.off = 0;
        nd.rep_idx = 0;
        try_insert(pos + 1, nd);
      }

      // rep edges from this arrival's offsets
      if (!SZ_DP_NO_REP) {
        const RepPick rep = rep_match(src, n, pos, A.reps);
        if (rep.len >= kMinMatch) {
          const uint32_t rep_prefix =
              price_bit(ms.is_match, 1) + price_bit(ms.is_rep, 1) +
              price_bit(ms.rep_sel[0], rep.idx == 0 ? 0u : 1u) +
              (rep.idx != 0 ? price_bit(ms.rep_sel[1], rep.idx == 1 ? 0u : 1u) : 0u);
          collect_lens(rep.len, 0, lens);
          DPNode nd = A;
          nd.prev = idx;
          nd.off = 0;
          nd.rep_idx = rep.idx;
          reps_after_rep(nd.reps, rep.idx);
          for (uint32_t l : lens) {
            nd.cost = A.cost + rep_prefix +
                      (l <= max_need ? lenp[l]
                                     : price_gamma_p(ms.len_unary, ms.len_bits,
                                                     l - 2));
            nd.len = l;
            try_insert(pos + l, nd);
          }
        }
      }

      // normal-match edges: every candidate distance, priced exactly
      for (uint32_t ci = 0; ci < ncand && ci < mcc; ++ci) {
        const Match &nm = cands[ci];
        collect_lens(nm.len, ci, lens);
        DPNode nd = A;
        nd.prev = idx;
        nd.off = nm.off;
        nd.rep_idx = UINT32_MAX;
        reps_after_normal(nd.reps, nm.off);
        const uint32_t npref = norm_prefix[ci];
        for (uint32_t l : lens) {
          nd.cost = A.cost + npref +
                    (l <= max_need ? lenp[l]
                                   : price_gamma_p(ms.len_unary, ms.len_bits,
                                                   l - 2));
          nd.len = l;
          try_insert(pos + l, nd);
        }
      }
    }

    // advance the raw-prefix model after pricing this position (unguided only)
    if (!guide) mix->train_byte(hist, src[pos], mb, st);
  }

#if SZ_STATS
  fprintf(stderr, "[pool] mode=%u guide=%d n=%u pool=%zu cap=%zu\n",
          mode, guide ? 1 : 0, n, pool.size(), pool.capacity());
#endif
  // reconstruct the cheapest full-coverage path
  const uint32_t *fin = &best_slot[(size_t)n * kBeamSlots];
  const uint32_t fin_cnt = best_cnt[n];
  if (fin_cnt == 0) {
    // unreachable in practice; fall back to all-literals
    plan.reserve(n);
    for (uint32_t i = 0; i < n; ++i) plan.push_back(PlanTok{0, 0, 0});
    return;
  }
  uint32_t lead = fin[0];
  for (uint32_t i = 0; i < fin_cnt; ++i)
    if (pool[fin[i]].cost < pool[lead].cost) lead = fin[i];
  std::vector<PlanTok> rev;
  for (uint32_t i = lead; pool[i].prev != UINT32_MAX; i = pool[i].prev) {
    PlanTok t;
    t.len = pool[i].len;
    t.off = pool[i].off;
    t.rep_idx = pool[i].len == 0 ? 0 : pool[i].rep_idx;
    if (pool[i].len == 0) t.rep_idx = UINT32_MAX;
    rev.push_back(t);
  }
  plan.assign(rev.rbegin(), rev.rend());
#if SZ_STATS
  fprintf(stderr, "[stats] sum_litp=%.0f chosen_cost=%.0f\n",
          plan_cost_estimate, (double)pool[lead].cost);
#endif
  plan_cost_estimate = (double)pool[lead].cost;
}

static void emit_plan(const uint8_t *src, uint32_t n,
                      const std::vector<PlanTok> &plan,
                      std::vector<uint8_t> &out, uint32_t mode) {
  (void)n;
  RcEncoder rc(out);
  Model m;
  MixLit mix(mode);
  Hist hist;
  uint32_t pos = 0;
  uint32_t reps[3] = {0, 0, 0};
  uint8_t st = 0;
  double dp_est = plan_cost_estimate; (void)dp_est;

  for (const PlanTok &tok : plan) {
    if (tok.len == 0) {
#if SZ_STATS
      ++st_lit; ++st_bytes;
#endif
      rc.encode_bit(m.is_match, 0);
      {
        const uint8_t mb = (uint8_t)((pos >= reps[0]) ? src[pos - reps[0]] : 0);
        mix.encode(rc, hist, src[pos], mb, st);
      }
      st = 0;
      ++pos;
    } else if (tok.rep_idx != UINT32_MAX) {
#if SZ_STATS
      ++st_rep[tok.rep_idx]; st_repb += tok.len;
#endif
      rc.encode_bit(m.is_match, 1);
      rc.encode_bit(m.is_rep, 1);
      rc.encode_bit(m.rep_sel[0], tok.rep_idx == 0 ? 0u : 1u);
      if (tok.rep_idx != 0) rc.encode_bit(m.rep_sel[1], tok.rep_idx == 1 ? 0u : 1u);
      encode_gamma(rc, m.len_unary, m.len_bits, tok.len - 2);
      reps_after_rep(reps, tok.rep_idx);
      st = 1;
      for (uint32_t i = pos; i < pos + tok.len; ++i) {
        const uint8_t mb = (uint8_t)((i >= reps[0]) ? src[i - reps[0]] : 0);
        mix.train_byte(hist, src[i], mb, st);
      }
      pos += tok.len;
    } else {
#if SZ_STATS
      ++st_norm; st_nmb += tok.len;
      if (st_norm <= 12) {
        fprintf(stderr, "[dbg] norm tok off=%u len=%u live_price=%u\n",
                tok.off, tok.len, price_norm_token(m, tok.off, tok.len));
      }
#endif
      rc.encode_bit(m.is_match, 1);
      rc.encode_bit(m.is_rep, 0);
      encode_offset(rc, m, tok.off);
      encode_gamma(rc, m.len_unary, m.len_bits, tok.len - 2);
      reps_after_normal(reps, tok.off);
      st = 2;
      for (uint32_t i = pos; i < pos + tok.len; ++i) {
        const uint8_t mb = (uint8_t)((i >= reps[0]) ? src[i - reps[0]] : 0);
        mix.train_byte(hist, src[i], mb, st);
      }
      pos += tok.len;
    }
  }
  rc.flush();
#if SZ_STATS
  fprintf(stderr, "[stats] enc_price_sum=%.0f\n", g_enc_price_sum);
  fprintf(stderr, "[stats] dp_est=%.0f actual=%llu (1/16 bits)\n",
          dp_est, (unsigned long long)rc.bits * 16);
  fprintf(stderr, "[stats] nhist:");
  for (int i = 0; i < 32; ++i) fprintf(stderr, " %d:%llu", i, (unsigned long long)st_nhist[i]);
  fprintf(stderr, "\n[stats] lit=%llu rep0=%llu(%lluB) rep1=%llu rep2=%llu norm=%llu(%lluB)\n",
          (unsigned long long)st_lit,
          (unsigned long long)st_rep[0], (unsigned long long)st_repb,
          (unsigned long long)st_rep[1], (unsigned long long)st_rep[2],
          (unsigned long long)st_norm, (unsigned long long)st_nmb);
#endif
}

static bool same_plan(const std::vector<PlanTok> &a,
                      const std::vector<PlanTok> &b) {
  if (a.size() != b.size()) return false;
  for (size_t i = 0; i < a.size(); ++i) {
    if (a[i].len != b[i].len || a[i].off != b[i].off ||
        a[i].rep_idx != b[i].rep_idx)
      return false;
  }
  return true;
}

#ifndef SZ_TIME
#define SZ_TIME 0
#endif
#if SZ_TIME
#define SZ_TIC(name) auto name = std::chrono::steady_clock::now()
#define SZ_TOC(name, msg)                                                     \
  do {                                                                        \
    double dt = std::chrono::duration<double>(                                \
                    std::chrono::steady_clock::now() - name)                  \
                    .count();                                                 \
    fprintf(stderr, "[time] %-22s %7.2fs\n", msg, dt);                        \
  } while (0)
#else
#define SZ_TIC(name) (void)0
#define SZ_TOC(name, msg) (void)0
#endif

static void encode_one_mode(const uint8_t *src, uint32_t n, uint32_t mode,
                            const CandCache &cc, std::vector<uint8_t> &out) {
  std::vector<uint32_t> litp_cache(n, 0);
  std::vector<PlanTok> plans[8];
  SZ_TIC(t0);
  plan_block_pass(src, n, plans[0], nullptr, mode, cc, litp_cache);
  size_t nplans = 1;
  for (size_t k = 1; k < (size_t)SZ_PASSES; ++k) {
    plan_block_pass(src, n, plans[k], &plans[k - 1], mode, cc, litp_cache);
    nplans = k + 1;
    if (same_plan(plans[k], plans[k - 1])) break; // converged: later passes repeat
  }
  SZ_TOC(t0, mode ? "passes (mode B)" : "passes (mode A)");
  SZ_TIC(t1);
  std::vector<uint8_t> bestp;
  std::vector<std::vector<uint8_t>> emitted(nplans);
  emit_plan(src, n, plans[0], emitted[0], mode);
  bestp.swap(emitted[0]);
  for (size_t k = 1; k < nplans; ++k) {
    emit_plan(src, n, plans[k], emitted[k], mode);
    if (emitted[k].size() < bestp.size()) bestp.swap(emitted[k]);
  }
  SZ_TOC(t1, mode ? "emits (mode B)" : "emits (mode A)");
  out.swap(bestp);
}

// v4 payload = 1 mode byte (0 = word-shape t5, 1 = gap order-1 t5) + RC stream.
// Both modes are coded; the actual smaller one ships (per-block self-tuning).
void encode_block_szlzrc(const uint8_t *src, uint32_t n,
                         std::vector<uint8_t> &out) {
  out.clear();
  if (n == 0) return;
  SZ_TIC(tc);
  CandCache cc;
  build_cand_cache(src, n, cc);
  SZ_TOC(tc, "finder cache");
  std::vector<uint8_t> a, b;
  std::thread ta([&] { encode_one_mode(src, n, 0, cc, a); });
  std::thread tb([&] { encode_one_mode(src, n, 1, cc, b); });
  ta.join();
  tb.join();
  const bool gap = b.size() < a.size();
  out.push_back(gap ? 1 : 0);
  const std::vector<uint8_t> &pick = gap ? b : a;
  out.insert(out.end(), pick.begin(), pick.end());
}

int decode_block_szlzrc(const uint8_t *src, size_t src_len, uint8_t *dst,
                        uint32_t n) {
  if (src_len < 6) return SZIP_ERR_TRUNCATED;
  const uint32_t mode = src[0];
  if (mode > 1) return SZIP_ERR_CORRUPT;
  RcDecoder rc(src + 1, src_len - 1);
  if (!rc.init()) return SZIP_ERR_TRUNCATED;

  Model m;
  MixLit mix(mode);
  Hist hist;
  uint32_t out_pos = 0;
  uint32_t reps[3] = {0, 0, 0};
  uint8_t st = 0;

  while (out_pos < n) {
    if (rc.decode_bit(m.is_match) == 0) {
      const uint8_t mb = (uint8_t)((out_pos >= reps[0]) ? dst[out_pos - reps[0]] : 0);
      dst[out_pos] = mix.decode(rc, hist, mb, st);
      hist.push(dst[out_pos]);
      st = 0;
      ++out_pos;
    } else if (rc.decode_bit(m.is_rep) == 1) {
      uint32_t idx = 0;
      if (rc.decode_bit(m.rep_sel[0]) == 1)
        idx = (rc.decode_bit(m.rep_sel[1]) == 0) ? 1u : 2u;

      uint32_t xlen = 0;
      int e = decode_gamma(rc, m.len_unary, m.len_bits, 10, &xlen);
      if (e != SZIP_OK) return e;
      if (!rc.ok()) return SZIP_ERR_TRUNCATED;
      const uint32_t len = xlen + 2;
      if (len < kMinMatch || len > kMaxMatch) return SZIP_ERR_CORRUPT;
      const uint32_t off = reps[idx];
      if (off == 0 || off > out_pos) return SZIP_ERR_CORRUPT;
      if (len > n - out_pos) return SZIP_ERR_CORRUPT;

      reps_after_rep(reps, idx);
      st = 1;
      for (uint32_t i = 0; i < len; ++i) {
        const uint8_t b = dst[out_pos - off + i];
        dst[out_pos + i] = b;
        const uint8_t mb = (uint8_t)(((out_pos + i) >= reps[0]) ? dst[out_pos + i - reps[0]] : 0);
        mix.train_byte(hist, b, mb, st);
      }
      out_pos += len;
    } else {
      uint32_t off = 0;
      int e = decode_offset(rc, m, &off);
      if (e != SZIP_OK) return e;
      uint32_t xlen = 0;
      e = decode_gamma(rc, m.len_unary, m.len_bits, 10, &xlen);
      if (e != SZIP_OK) return e;
      if (!rc.ok()) return SZIP_ERR_TRUNCATED;
      const uint32_t len = xlen + 2;
      if (len < kMinMatch || len > kMaxMatch) return SZIP_ERR_CORRUPT;
      if (off == 0 || off > out_pos) return SZIP_ERR_CORRUPT;
      if (len > n - out_pos) return SZIP_ERR_CORRUPT;

      reps_after_normal(reps, off);
      st = 2;
      for (uint32_t i = 0; i < len; ++i) {
        const uint8_t b = dst[out_pos - off + i];
        dst[out_pos + i] = b;
        const uint8_t mb = (uint8_t)(((out_pos + i) >= reps[0]) ? dst[out_pos + i - reps[0]] : 0);
        mix.train_byte(hist, b, mb, st);
      }
      out_pos += len;
    }
    if (!rc.ok()) return SZIP_ERR_TRUNCATED;
  }
  if (!rc.ok()) return SZIP_ERR_TRUNCATED;
  if (rc.pos() != src_len - 1) return SZIP_ERR_CORRUPT;
  return SZIP_OK;
}

// ------------------------------------------------------------- le helpers --

void put_u16(std::ostream &os, uint16_t v) {
  char b[2] = {static_cast<char>(v & 0xFF), static_cast<char>((v >> 8) & 0xFF)};
  os.write(b, 2);
}
void put_u32(std::ostream &os, uint32_t v) {
  char b[4] = {static_cast<char>(v & 0xFF), static_cast<char>((v >> 8) & 0xFF),
               static_cast<char>((v >> 16) & 0xFF),
               static_cast<char>((v >> 24) & 0xFF)};
  os.write(b, 4);
}
void put_u64(std::ostream &os, uint64_t v) {
  put_u32(os, static_cast<uint32_t>(v & 0xFFFFFFFFu));
  put_u32(os, static_cast<uint32_t>(v >> 32));
}
bool get_u16(std::istream &is, uint16_t *v) {
  unsigned char b[2];
  if (!is.read(reinterpret_cast<char *>(b), 2)) return false;
  *v = static_cast<uint16_t>(b[0] | (b[1] << 8));
  return true;
}
bool get_u32(std::istream &is, uint32_t *v) {
  unsigned char b[4];
  if (!is.read(reinterpret_cast<char *>(b), 4)) return false;
  *v = static_cast<uint32_t>(b[0]) | (static_cast<uint32_t>(b[1]) << 8) |
       (static_cast<uint32_t>(b[2]) << 16) |
       (static_cast<uint32_t>(b[3]) << 24);
  return true;
}
bool get_u64(std::istream &is, uint64_t *v) {
  uint32_t lo = 0, hi = 0;
  if (!get_u32(is, &lo) || !get_u32(is, &hi)) return false;
  *v = static_cast<uint64_t>(lo) | (static_cast<uint64_t>(hi) << 32);
  return true;
}

bool write_header(std::ostream &os, uint32_t block_size, uint64_t total_raw) {
  char magic[4] = {SZIP_MAGIC0, SZIP_MAGIC1, SZIP_MAGIC2, SZIP_MAGIC3};
  os.write(magic, 4);
  char ver = SZIP_VERSION, flags = 0;
  os.write(&ver, 1);
  os.write(&flags, 1);
  put_u16(os, 0);
  put_u32(os, block_size);
  put_u64(os, total_raw);
  return static_cast<bool>(os);
}

int read_and_check_header(std::istream &is, uint32_t *block_size,
                          uint64_t *total_raw) {
  unsigned char magic[4];
  if (!is.read(reinterpret_cast<char *>(magic), 4)) return SZIP_ERR_TRUNCATED;
  if (magic[0] != SZIP_MAGIC0 || magic[1] != SZIP_MAGIC1 ||
      magic[2] != SZIP_MAGIC2 || magic[3] != SZIP_MAGIC3)
    return SZIP_ERR_FORMAT;
  unsigned char ver = 0, flags = 0;
  if (!is.read(reinterpret_cast<char *>(&ver), 1) ||
      !is.read(reinterpret_cast<char *>(&flags), 1))
    return SZIP_ERR_TRUNCATED;
  if (ver != SZIP_VERSION) return SZIP_ERR_UNSUPPORTED;
  uint16_t reserved = 0;
  if (!get_u16(is, &reserved)) return SZIP_ERR_TRUNCATED;
  if (!get_u32(is, block_size)) return SZIP_ERR_TRUNCATED;
  if (!get_u64(is, total_raw)) return SZIP_ERR_TRUNCATED;
  if (*block_size == 0 || *block_size > (1u << 24)) return SZIP_ERR_FORMAT;
  return SZIP_OK;
}

int read_and_check_block_header(std::istream &is, uint8_t *type,
                                uint32_t *raw_size, uint32_t *comp_size) {
  unsigned char bh[SZIP_BLOCK_HEADER_SIZE];
  if (!is.read(reinterpret_cast<char *>(bh), SZIP_BLOCK_HEADER_SIZE))
    return SZIP_ERR_TRUNCATED;
  *type = bh[0];
  *raw_size = static_cast<uint32_t>(bh[2]) | (static_cast<uint32_t>(bh[3]) << 8) |
              (static_cast<uint32_t>(bh[4]) << 16) |
              (static_cast<uint32_t>(bh[5]) << 24);
  *comp_size = static_cast<uint32_t>(bh[6]) | (static_cast<uint32_t>(bh[7]) << 8) |
               (static_cast<uint32_t>(bh[8]) << 16) |
               (static_cast<uint32_t>(bh[9]) << 24);
  return SZIP_OK;
}

} // namespace

// ------------------------------------------------------------- container --

void set_parse_fast(int fast) { g_parse_fast = fast ? 1 : 0; }

int compress_file(const std::string &in_path, const std::string &out_path,
                  uint32_t block_size) {
  if (block_size == 0 || block_size > (1u << 24)) return SZIP_ERR_FORMAT;

  std::ifstream is(in_path, std::ios::binary);
  if (!is) return SZIP_ERR_IO;
  is.seekg(0, std::ios::end);
  const uint64_t total = static_cast<uint64_t>(is.tellg());
  is.seekg(0, std::ios::beg);

  std::ofstream os(out_path, std::ios::binary | std::ios::trunc);
  if (!os) return SZIP_ERR_IO;

  if (!write_header(os, block_size, total)) return SZIP_ERR_IO;

  std::vector<uint8_t> block(block_size);
  std::vector<uint8_t> payload;
  uint32_t crc = 0;
  uint64_t remaining = total;

  while (remaining > 0) {
    const uint32_t want =
        static_cast<uint32_t>(std::min<uint64_t>(block_size, remaining));
    if (!is.read(reinterpret_cast<char *>(block.data()), want)) return SZIP_ERR_IO;
    crc = szip_crc32_update(crc, block.data(), want);

    // DP optimal parse is parameter-free; encoder-side only.
    encode_block_szlzrc(block.data(), want, payload);
    const bool store = payload.size() >= want;
    const uint32_t comp_size =
        store ? want : static_cast<uint32_t>(payload.size());

    // Block header, explicitly little-endian.
    char hdr[SZIP_BLOCK_HEADER_SIZE];
    hdr[0] = store ? SZIP_BLOCK_STORED : SZIP_BLOCK_SZLZRC;
    hdr[1] = 0;
    hdr[2] = static_cast<char>(want & 0xFF);
    hdr[3] = static_cast<char>((want >> 8) & 0xFF);
    hdr[4] = static_cast<char>((want >> 16) & 0xFF);
    hdr[5] = static_cast<char>((want >> 24) & 0xFF);
    hdr[6] = static_cast<char>(comp_size & 0xFF);
    hdr[7] = static_cast<char>((comp_size >> 8) & 0xFF);
    hdr[8] = static_cast<char>((comp_size >> 16) & 0xFF);
    hdr[9] = static_cast<char>((comp_size >> 24) & 0xFF);
    os.write(hdr, SZIP_BLOCK_HEADER_SIZE);

    if (store)
      os.write(reinterpret_cast<const char *>(block.data()), want);
    else
      os.write(reinterpret_cast<const char *>(payload.data()), comp_size);
    if (!os) return SZIP_ERR_IO;

    remaining -= want;
  }

  put_u32(os, crc);
  char magic[4] = {SZIP_MAGIC0, SZIP_MAGIC1, SZIP_MAGIC2, SZIP_MAGIC3};
  os.write(magic, 4);
  return os ? SZIP_OK : SZIP_ERR_IO;
}

// In-memory container encode/decode (used by the built-in GUI).
int compress_buffer(const uint8_t *data, size_t len,
                    std::vector<uint8_t> &out, uint32_t block_size) {
  if (block_size == 0 || block_size > (1u << 24)) return SZIP_ERR_FORMAT;
  if (len > (size_t)1 << 32) return SZIP_ERR_FORMAT;
  std::ostringstream os(std::ios::binary);
  if (!write_header(os, block_size, len)) return SZIP_ERR_IO;
  std::vector<uint8_t> payload;
  uint32_t crc = 0;
  size_t off = 0;
  while (off < len) {
    const uint32_t want = static_cast<uint32_t>(
        std::min<size_t>(block_size, len - off));
    const uint8_t *blk = data + off;
    crc = szip_crc32_update(crc, blk, want);
    encode_block_szlzrc(blk, want, payload);
    const bool store = payload.size() >= want;
    const uint32_t comp_size = store ? want : (uint32_t)payload.size();
    char hdr[SZIP_BLOCK_HEADER_SIZE];
    hdr[0] = store ? SZIP_BLOCK_STORED : SZIP_BLOCK_SZLZRC;
    hdr[1] = 0;
    hdr[2] = (char)(want & 0xFF);        hdr[3] = (char)((want >> 8) & 0xFF);
    hdr[4] = (char)((want >> 16) & 0xFF); hdr[5] = (char)((want >> 24) & 0xFF);
    hdr[6] = (char)(comp_size & 0xFF);   hdr[7] = (char)((comp_size >> 8) & 0xFF);
    hdr[8] = (char)((comp_size >> 16) & 0xFF);
    hdr[9] = (char)((comp_size >> 24) & 0xFF);
    os.write(hdr, SZIP_BLOCK_HEADER_SIZE);
    if (store) os.write((const char *)blk, want);
    else os.write((const char *)payload.data(), comp_size);
    off += want;
  }
  put_u32(os, crc);
  char magic[4] = {SZIP_MAGIC0, SZIP_MAGIC1, SZIP_MAGIC2, SZIP_MAGIC3};
  os.write(magic, 4);
  const std::string &tmp = os.str(); // ostringstream::str() returns a copy
  out.assign(tmp.begin(), tmp.end());
  return SZIP_OK;
}

int decompress_buffer(const uint8_t *data, size_t len,
                      std::vector<uint8_t> &out) {
  std::istringstream is(std::string((const char *)data, len), std::ios::binary);
  uint32_t block_size = 0;
  uint64_t total = 0;
  int e = read_and_check_header(is, &block_size, &total);
  if (e != SZIP_OK) return e;
  if (total > (size_t)1 << 32) return SZIP_ERR_FORMAT;
  out.clear();
  out.reserve((size_t)total);
  std::vector<uint8_t> raw;
  uint64_t remaining = total;
  while (remaining > 0) {
    uint8_t type = 0; uint32_t raw_size = 0, comp_size = 0;
    e = read_and_check_block_header(is, &type, &raw_size, &comp_size);
    if (e != SZIP_OK) return e;
    if (raw_size == 0 || raw_size > block_size || raw_size > remaining)
      return SZIP_ERR_CORRUPT;
    if (type == SZIP_BLOCK_STORED) {
      raw.resize(raw_size);
      if (!is.read((char *)raw.data(), raw_size)) return SZIP_ERR_TRUNCATED;
    } else if (type == SZIP_BLOCK_SZLZRC) {
      std::vector<uint8_t> payload(comp_size);
      if (!is.read((char *)payload.data(), comp_size)) return SZIP_ERR_TRUNCATED;
      raw.resize(raw_size);
      e = decode_block_szlzrc(payload.data(), comp_size, raw.data(), raw_size);
      if (e != SZIP_OK) return e;
    } else return SZIP_ERR_CORRUPT;
    out.insert(out.end(), raw.begin(), raw.end());
    remaining -= raw_size;
  }
  uint32_t crc = 0;
  if (!get_u32(is, &crc)) return SZIP_ERR_TRUNCATED;
  char magic[4];
  if (!is.read(magic, 4) || magic[0] != SZIP_MAGIC0 || magic[1] != SZIP_MAGIC1 ||
      magic[2] != SZIP_MAGIC2 || magic[3] != SZIP_MAGIC3)
    return SZIP_ERR_FORMAT;
  if (crc != szip_crc32(out.data(), out.size())) return SZIP_ERR_CORRUPT;
  return SZIP_OK;
}

int decompress_file(const std::string &in_path, const std::string &out_path,
                    uint64_t *raw_out, uint32_t *crc_out) {
  std::ifstream is(in_path, std::ios::binary);
  if (!is) return SZIP_ERR_IO;

  uint32_t block_size = 0;
  uint64_t total_raw = 0;
  int e = read_and_check_header(is, &block_size, &total_raw);
  if (e != SZIP_OK) return e;

  std::ofstream os(out_path, std::ios::binary | std::ios::trunc);
  if (!os) return SZIP_ERR_IO;

  std::vector<uint8_t> payload, raw;
  uint32_t crc = 0;
  uint64_t produced = 0;

  while (produced < total_raw) {
    uint8_t type = 0;
    uint32_t raw_size = 0, comp_size = 0;
    e = read_and_check_block_header(is, &type, &raw_size, &comp_size);
    if (e != SZIP_OK) return e;

    if (raw_size == 0 || raw_size > block_size) return SZIP_ERR_CORRUPT;
    if (raw_size > total_raw - produced) return SZIP_ERR_CORRUPT;
    if (type == SZIP_BLOCK_STORED) {
      if (comp_size != raw_size) return SZIP_ERR_CORRUPT;
    } else if (type == SZIP_BLOCK_SZLZRC) {
      if (comp_size < 5 || comp_size > szip_compress_bound(raw_size))
        return SZIP_ERR_CORRUPT;
    } else {
      return SZIP_ERR_UNSUPPORTED;
    }

    payload.resize(comp_size);
    if (!is.read(reinterpret_cast<char *>(payload.data()), comp_size))
      return SZIP_ERR_TRUNCATED;

    raw.resize(raw_size);
    if (type == SZIP_BLOCK_STORED) {
      std::memcpy(raw.data(), payload.data(), raw_size);
    } else {
      e = decode_block_szlzrc(payload.data(), comp_size, raw.data(), raw_size);
      if (e != SZIP_OK) return e;
    }

    crc = szip_crc32_update(crc, raw.data(), raw_size);
    if (!os.write(reinterpret_cast<const char *>(raw.data()), raw_size))
      return SZIP_ERR_IO;
    produced += raw_size;
  }

  uint32_t stored_crc = 0;
  if (!get_u32(is, &stored_crc)) return SZIP_ERR_TRUNCATED;
  unsigned char end_magic[4];
  if (!is.read(reinterpret_cast<char *>(end_magic), 4)) return SZIP_ERR_TRUNCATED;
  if (end_magic[0] != SZIP_MAGIC0 || end_magic[1] != SZIP_MAGIC1 ||
      end_magic[2] != SZIP_MAGIC2 || end_magic[3] != SZIP_MAGIC3)
    return SZIP_ERR_FORMAT;
  if (stored_crc != crc) return SZIP_ERR_CORRUPT;

  if (raw_out) *raw_out = produced;
  if (crc_out) *crc_out = crc;
  return SZIP_OK;
}

int test_file(const std::string &in_path, uint64_t *raw_out) {
  std::ifstream is(in_path, std::ios::binary);
  if (!is) return SZIP_ERR_IO;

  uint32_t block_size = 0;
  uint64_t total_raw = 0;
  int e = read_and_check_header(is, &block_size, &total_raw);
  if (e != SZIP_OK) return e;

  std::vector<uint8_t> payload, raw;
  uint32_t crc = 0;
  uint64_t produced = 0;

  while (produced < total_raw) {
    uint8_t type = 0;
    uint32_t raw_size = 0, comp_size = 0;
    e = read_and_check_block_header(is, &type, &raw_size, &comp_size);
    if (e != SZIP_OK) return e;

    if (raw_size == 0 || raw_size > block_size) return SZIP_ERR_CORRUPT;
    if (raw_size > total_raw - produced) return SZIP_ERR_CORRUPT;
    if (type == SZIP_BLOCK_STORED) {
      if (comp_size != raw_size) return SZIP_ERR_CORRUPT;
    } else if (type == SZIP_BLOCK_SZLZRC) {
      if (comp_size < 5 || comp_size > szip_compress_bound(raw_size))
        return SZIP_ERR_CORRUPT;
    } else {
      return SZIP_ERR_UNSUPPORTED;
    }
    payload.resize(comp_size);
    if (!is.read(reinterpret_cast<char *>(payload.data()), comp_size))
      return SZIP_ERR_TRUNCATED;
    raw.resize(raw_size);
    if (type == SZIP_BLOCK_STORED) {
      std::memcpy(raw.data(), payload.data(), raw_size);
    } else {
      e = decode_block_szlzrc(payload.data(), comp_size, raw.data(), raw_size);
      if (e != SZIP_OK) return e;
    }
    crc = szip_crc32_update(crc, raw.data(), raw_size);
    produced += raw_size;
  }

  uint32_t stored_crc = 0;
  if (!get_u32(is, &stored_crc)) return SZIP_ERR_TRUNCATED;
  unsigned char end_magic[4];
  if (!is.read(reinterpret_cast<char *>(end_magic), 4)) return SZIP_ERR_TRUNCATED;
  if (end_magic[0] != SZIP_MAGIC0 || end_magic[1] != SZIP_MAGIC1 ||
      end_magic[2] != SZIP_MAGIC2 || end_magic[3] != SZIP_MAGIC3)
    return SZIP_ERR_FORMAT;
  if (stored_crc != crc) return SZIP_ERR_CORRUPT;
  if (raw_out) *raw_out = produced;
  return SZIP_OK;
}

} // namespace szip

// ---------------------------------------------------------------- C ABI ----

extern "C" {

size_t szip_compress_bound(size_t raw_len) {
  return raw_len + raw_len / 2 + 64;
}

int szip_compress_block(const uint8_t *src, size_t src_len, uint8_t *dst,
                        size_t dst_cap, size_t *dst_len) {
  if (!dst_len) return SZIP_ERR_FORMAT;
  if (src_len == 0) {
    *dst_len = 0;
    return SZIP_OK;
  }
  if (src_len > (1u << 24)) return SZIP_ERR_FORMAT;
  try {
    std::vector<uint8_t> payload;
    szip::encode_block_szlzrc(src, static_cast<uint32_t>(src_len), payload);
    if (payload.size() > dst_cap) return SZIP_ERR_BUFFER;
    std::memcpy(dst, payload.data(), payload.size());
    *dst_len = payload.size();
    return SZIP_OK;
  } catch (const std::bad_alloc &) {
    return SZIP_ERR_NOMEM;
  } catch (...) {
    return SZIP_ERR_NOMEM;
  }
}

int szip_decompress_block(const uint8_t *src, size_t src_len, uint8_t *dst,
                          size_t raw_len) {
  if (raw_len == 0) return SZIP_OK;
  if (raw_len > (1u << 24)) return SZIP_ERR_FORMAT;
  return szip::decode_block_szlzrc(src, src_len, dst,
                                   static_cast<uint32_t>(raw_len));
}

uint32_t szip_crc32_update(uint32_t crc, const uint8_t *data, size_t len) {
  return szip::crc32_table().update(crc, data, len);
}

uint32_t szip_crc32(const uint8_t *data, size_t len) {
  return szip::crc32_table().update(0, data, len);
}

} /* extern "C" */
// G0D SZIP — IEEE CRC-32 (poly 0xEDB88320). Original implementation.
#pragma once

#include <cstddef>
#include <cstdint>

namespace szip {

class Crc32 {
public:
  Crc32() {
    for (uint32_t i = 0; i < 256; ++i) {
      uint32_t c = i;
      for (int k = 0; k < 8; ++k)
        c = (c & 1u) ? (0xEDB88320u ^ (c >> 1)) : (c >> 1);
      table_[i] = c;
    }
  }

  uint32_t update(uint32_t crc, const uint8_t *data, size_t n) const {
    crc ^= 0xFFFFFFFFu;
    for (size_t i = 0; i < n; ++i)
      crc = table_[(crc ^ data[i]) & 0xFFu] ^ (crc >> 8);
    return crc ^ 0xFFFFFFFFu;
  }

private:
  uint32_t table_[256];
};

inline const Crc32 &crc32_table() {
  static const Crc32 table;
  return table;
}

} // namespace szip
// G0D SZIP — very lightweight built-in GUI.
// A tiny HTTP server (no dependencies: one file, plain sockets) that serves a
// single embedded page and runs the same in-tree encoder/decoder in-process.
//   g0dszip g [port]      ->  http://localhost:8848
#include "szip.h"

#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cctype>
#include <cstring>
#include <string>
#include <thread>
#include <vector>

#ifdef _WIN32
#include <winsock2.h>
#include <ws2tcpip.h>
#pragma comment(lib, "ws2_32.lib")
using sock_t = SOCKET;
static void sock_close(sock_t s) { closesocket(s); }
static int sock_send(sock_t s, const char *p, int n) {
  return send(s, p, n, 0);
}
static void sock_init() {
  WSADATA w;
  WSAStartup(MAKEWORD(2, 2), &w);
}
#else
#include <arpa/inet.h>
#include <netinet/in.h>
#include <signal.h>
#include <sys/socket.h>
#include <unistd.h>
using sock_t = int;
static void sock_close(sock_t s) { close(s); }
static int sock_send(sock_t s, const char *p, int n) {
  return (int)send(s, p, (size_t)n, MSG_NOSIGNAL);
}
static void sock_init() { signal(SIGPIPE, SIG_IGN); }
#endif

namespace szip {
namespace {

// ---------------------------------------------------------------- the page --
const char kPage[] = R"HTML(<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>G0D SZIP</title>
<style>
:root{--bg:#0f1216;--card:#171c22;--acc:#4fd1c5;--txt:#e6edf3;--dim:#8b98a5}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--txt);
 font:15px/1.5 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
 display:flex;flex-direction:column;align-items:center;min-height:100vh}
h1{margin:28px 0 2px;font-size:26px;letter-spacing:.5px}
h1 b{color:var(--acc)}
.sub{color:var(--dim);margin:0 0 22px;font-size:13px}
.card{background:var(--card);border:1px solid #232a33;border-radius:14px;
 padding:22px;width:min(560px,92vw);margin-bottom:16px}
#drop{border:2px dashed #2c3542;border-radius:12px;padding:38px 18px;
 text-align:center;color:var(--dim);cursor:pointer;transition:.15s}
#drop.hot{border-color:var(--acc);color:var(--txt);background:#14202a}
#drop b{color:var(--acc)}
.row{display:flex;gap:10px;margin-top:16px;flex-wrap:wrap}
button{flex:1;min-width:130px;padding:11px 14px;border:0;border-radius:9px;
 font-size:14px;font-weight:600;cursor:pointer;background:#232a33;color:var(--txt)}
button:disabled{opacity:.45;cursor:default}
button.primary{background:var(--acc);color:#08222b}
button.ghost{background:transparent;border:1px solid #2c3542}
.toggle{display:flex;align-items:center;gap:9px;margin-top:14px;color:var(--dim);font-size:13px}
.toggle input{accent-color:var(--acc);width:16px;height:16px}
#stat{margin-top:14px;font-size:13px;color:var(--dim);min-height:20px;white-space:pre-line}
#stat.ok{color:var(--acc)}#stat.err{color:#f28b82}
.spin{display:inline-block;width:13px;height:13px;border:2px solid var(--acc);
 border-top-color:transparent;border-radius:50%;animation:sp .7s linear infinite;
 vertical-align:-2px;margin-right:7px}
@keyframes sp{to{transform:rotate(360deg)}}
.foot{color:#5b6672;font-size:12px;margin:6px 0 26px}
a{color:var(--acc)}
</style></head><body>
<h1>G0D <b>SZIP</b></h1>
<p class="sub">own encoder &middot; own decoder &middot; .szip format v4</p>
<div class="card">
  <div id="drop">drop a file here, or <b>browse</b><br>
    <input id="file" type="file" style="display:none"></div>
  <div class="toggle"><input id="fast" type="checkbox">
    <label for="fast">Fast parse &mdash; quicker, slightly larger output</label></div>
  <div class="row">
    <button id="cbtn" class="primary" disabled>Compress &rarr; .szip</button>
    <button id="dbtn" disabled>Decompress</button>
    <button id="dl" class="ghost" disabled>Download result</button>
  </div>
  <div id="stat"></div>
</div>
<p class="foot">runs 100% in this process &mdash; nothing leaves your machine</p>
<script>
const $=id=>document.getElementById(id);
let f=null,out=null,outName='';
const stat=(t,cls)=>{const s=$('stat');s.className=cls||'';s.textContent=t;};
const ready=()=>{$('cbtn').disabled=!f;$('dbtn').disabled=!f;
  $('dl').disabled=!out;};
$('drop').onclick=()=>$('file').click();
$('file').onchange=e=>{f=e.target.files[0];if(f){out=null;
  $('drop').innerHTML='<b>'+f.name+'</b> — '+(f.size<1024?f.size+' B':
  (f.size/1048576).toFixed(2)+' MB');stat('');ready();}};
['dragover','dragenter'].forEach(ev=>$('drop').addEventListener(ev,e=>{
  e.preventDefault();$('drop').classList.add('hot');}));
['dragleave','drop'].forEach(ev=>$('drop').addEventListener(ev,e=>{
  e.preventDefault();$('drop').classList.remove('hot');}));
$('drop').addEventListener('drop',e=>{f=e.dataTransfer.files[0];
  if(f){out=null;$('drop').innerHTML='<b>'+f.name+'</b> — '+(f.size<1024?
  f.size+' B':(f.size/1048576).toFixed(2)+' MB');stat('');ready();}});

async function run(path,label){
  if(!f)return;
  $('cbtn').disabled=$('dbtn').disabled=true;
  stat('','');$('stat').innerHTML='<span class="spin"></span>'+label+'…';
  const t0=performance.now();
  try{
    const r=await fetch(path,{method:'POST',body:f});
    if(!r.ok)throw new Error('server error '+r.status);
    out=await r.blob();
    const dt=((performance.now()-t0)/1000).toFixed(2);
    const a=+r.headers.get('X-Original-Size')||f.size;
    const b=+r.headers.get('X-Result-Size')||out.size;
    const pct=a?((100*b)/a).toFixed(2):'—';
    outName=f.name+(path.endsWith('/c')?'.szip':'.out');
    stat(f.name+': '+a+' B → '+b+' B  ('+pct+'% of input)  in '+dt+' s','ok');
    $('dl').disabled=false;
  }catch(e){stat('failed: '+e.message,'err');out=null;}
  ready();
}
$('cbtn').onclick=()=>run('api/c'+($('fast').checked?'?fast=1':''),'compressing');
$('dbtn').onclick=()=>run('api/d','decompressing');
$('dl').onclick=()=>{if(!out)return;const u=URL.createObjectURL(out);
  const a=document.createElement('a');a.href=u;a.download=outName;a.click();
  URL.revokeObjectURL(u);};
</script></body></html>)HTML";

// ----------------------------------------------------------------- server --
constexpr size_t kMaxHead = 64 * 1024;
constexpr size_t kMaxBody = (size_t)256 << 20;

bool send_all(sock_t s, const std::string &hdr, const char *body, size_t n) {
  size_t off = 0;
  while (off < hdr.size()) {
    int k = sock_send(s, hdr.data() + off, (int)(hdr.size() - off));
    if (k <= 0) return false;
    off += (size_t)k;
  }
  off = 0;
  while (off < n) {
    int k = sock_send(s, body + off, (int)std::min<size_t>(n - off, 1 << 20));
    if (k <= 0) return false;
    off += (size_t)k;
  }
  return true;
}

void respond(sock_t s, int code, const char *type,
             const std::string &extra, const char *body, size_t n) {
  const char *msg = code == 200 ? "OK" : code == 204 ? "No Content" : "Error";
  std::string h = "HTTP/1.1 " + std::to_string(code) + " " + msg +
                  "\r\nContent-Type: " + type +
                  "\r\nContent-Length: " + std::to_string(n) +
                  "\r\nAccess-Control-Allow-Origin: *" +
                  "\r\nAccess-Control-Allow-Methods: GET, POST, OPTIONS" +
                  "\r\nAccess-Control-Allow-Headers: *" +
                  "\r\nConnection: close\r\n" + extra + "\r\n";
  send_all(s, h, body, n);
}

void handle_client(sock_t s) {
  // read head
  std::string head;
  char buf[4096];
  size_t body_off = 0;
  std::string pending; // bytes after the head within the same reads
  while (head.find("\r\n\r\n") == std::string::npos) {
    int k = (int)recv(s, buf, (int)sizeof(buf), 0);
    if (k <= 0) { sock_close(s); return; }
    head.append(buf, (size_t)k);
    if (head.size() > kMaxHead) { sock_close(s); return; }
  }
  body_off = head.find("\r\n\r\n") + 4;
  pending = head.substr(body_off);

  // request line
  const size_t sp1 = head.find(' ');
  const size_t sp2 = head.find(' ', sp1 + 1);
  if (sp1 == std::string::npos || sp2 == std::string::npos) {
    respond(s, 400, "text/plain", "", "bad request", 12);
    sock_close(s);
    return;
  }
  const std::string method = head.substr(0, sp1);
  std::string path = head.substr(sp1 + 1, sp2 - sp1 - 1);

  if (method == "OPTIONS") {
    respond(s, 204, "text/plain", "", "", 0);
    sock_close(s);
    return;
  }

  // content-length
  size_t clen = 0;
  {
    std::string lower = head;
    for (auto &c : lower) c = (char)tolower((unsigned char)c);
    const size_t p = lower.find("content-length:");
    if (p != std::string::npos) clen = (size_t)strtoull(lower.c_str() + p + 15, nullptr, 10);
  }

  if (method == "GET" && (path == "/" || path == "/index.html")) {
    respond(s, 200, "text/html; charset=utf-8", "", kPage, sizeof(kPage) - 1);
    sock_close(s);
    return;
  }

  const bool is_c = path.rfind("/api/c", 0) == 0;
  const bool is_d = path.rfind("/api/d", 0) == 0;
  if ((method != "POST") || (!is_c && !is_d) || clen > kMaxBody) {
    respond(s, 404, "text/plain", "", "not found", 10);
    sock_close(s);
    return;
  }

  // read body
  std::vector<uint8_t> body;
  body.reserve(clen + 1);
  body.assign(pending.begin(), pending.end());
  while (body.size() < clen) {
    int k = (int)recv(s, buf, (int)sizeof(buf), 0);
    if (k <= 0) { sock_close(s); return; }
    body.insert(body.end(), buf, buf + k);
    if (body.size() > kMaxBody) { sock_close(s); return; }
  }

  const int fast = path.find("fast=1") != std::string::npos;
  std::vector<uint8_t> out;
  int e;
  if (is_c) {
    set_parse_fast(fast);
    e = compress_buffer(body.data(), body.size(), out);
    set_parse_fast(0);
  } else {
    e = decompress_buffer(body.data(), body.size(), out);
  }
  if (e != SZIP_OK) {
    const std::string msg = std::string("codec error ") + std::to_string(e);
    respond(s, 400, "text/plain", "", msg.data(), msg.size());
    sock_close(s);
    return;
  }
  const std::string extra =
      "X-Original-Size: " + std::to_string(body.size()) + "\r\n" +
      "X-Result-Size: " + std::to_string(out.size()) + "\r\n" +
      "Content-Disposition: attachment\r\n";
  respond(s, 200, "application/octet-stream", extra,
          (const char *)out.data(), out.size());
  sock_close(s);
}

} // namespace

int run_gui(unsigned short port) {
  sock_init();
  sock_t l = socket(AF_INET, SOCK_STREAM, 0);
  if (l == (sock_t)-1) {
    std::fprintf(stderr, "gui: cannot create socket\n");
    return 1;
  }
  int one = 1;
  setsockopt(l, SOL_SOCKET, SO_REUSEADDR, (const char *)&one, sizeof(one));
  sockaddr_in addr;
  std::memset(&addr, 0, sizeof(addr));
  addr.sin_family = AF_INET;
  addr.sin_addr.s_addr = INADDR_ANY;
  addr.sin_port = htons(port);
  if (bind(l, (sockaddr *)&addr, sizeof(addr)) < 0) {
    std::fprintf(stderr, "gui: cannot bind port %u\n", (unsigned)port);
    return 1;
  }
  listen(l, 16);
  std::printf("G0D SZIP GUI: http://localhost:%u  (Ctrl+C to stop)\n",
              (unsigned)port);
  std::fflush(stdout);
  // best-effort browser open (the GUI is the default entry point)
  {
    const std::string url = "http://localhost:" + std::to_string(port);
#ifdef _WIN32
    std::string cmd = "start \"\" " + url;
#elif defined(__APPLE__)
    std::string cmd = "open " + url;
#else
    std::string cmd = "xdg-open " + url + " >/dev/null 2>&1 &";
#endif
    std::thread([cmd]() { (void)std::system(cmd.c_str()); }).detach();
  }
  for (;;) {
    sockaddr_in ca;
#ifdef _WIN32
    int cl = sizeof(ca);
#else
    socklen_t cl = sizeof(ca);
#endif
    sock_t c = accept(l, (sockaddr *)&ca, &cl);
    if (c < 0) continue;
    std::thread(handle_client, c).detach();
  }
}

} // namespace szip
// G0D SZIP — LZ77 hash-chain match finder. Original implementation.
#pragma once

#include <algorithm>
#include <cstdint>
#include <cstdint>
#include <vector>

#include "szip.h"

namespace szip {

constexpr uint32_t kMinMatch = SZIP_MIN_MATCH;   // 3
constexpr uint32_t kMaxMatch = SZIP_MAX_MATCH; // 2048
constexpr uint32_t kWindowLog = 20;              // 1 MiB
constexpr uint32_t kWindow = 1u << kWindowLog;
constexpr uint32_t kHashBits = 18;
constexpr uint32_t kHashSize = 1u << kHashBits;
#ifndef SZ_CHAIN
#define SZ_CHAIN 400
#endif
#ifndef SZ_NICE
#define SZ_NICE 128
#endif
constexpr uint32_t kMaxChain = SZ_CHAIN;
constexpr uint32_t kNiceLen = SZ_NICE;

struct Match {
  uint32_t len = 0;
  uint32_t off = 0; // 1-based
};

class MatchFinder {
public:
  // prev_ is indexed modulo the block size; call prepare() once per block.
  void prepare(uint32_t block_len) {
    head_.assign(kHashSize, 0);
    prev_.assign(block_len ? block_len : 1, 0);
  }

  void insert(const uint8_t *data, uint32_t n, uint32_t pos) {
    if (pos + kMinMatch > n) return;
    const uint32_t h = hash3(data + pos);
    prev_[pos % prev_.size()] = head_[h];
    head_[h] = pos + 1; // store pos+1 so 0 means empty
  }

  Match find(const uint8_t *data, uint32_t n, uint32_t pos) const {
    Match best;
    int64_t best_score = INT64_MIN;
    if (pos + kMinMatch > n) return best;

    const uint32_t max_len = std::min<uint32_t>(kMaxMatch, n - pos);
    const uint32_t limit =
        (pos > kWindow) ? pos - kWindow : 0;

    uint32_t cand = head_[hash3(data + pos)];
    for (uint32_t depth = 0; depth < kMaxChain && cand != 0; ++depth) {
      const uint32_t mpos = cand - 1;
      if (mpos < limit) break;
      if (mpos >= pos) {
        // current position (or lazy look-ahead) is in the chain: skip it
        cand = prev_[mpos % prev_.size()];
        continue;
      }

      // cheap reject: first 3 bytes must match
      if (data[mpos] != data[pos] || data[mpos + 1] != data[pos + 1] ||
          data[mpos + 2] != data[pos + 2]) {
        cand = prev_[mpos % prev_.size()];
        continue;
      }

      uint32_t len = 3;
      while (len < max_len && data[mpos + len] == data[pos + len]) ++len;

      // price-aware: prefer longer matches, but a much nearer match can win
      const uint32_t off = pos - mpos;
      uint32_t bl = 0;
      for (uint32_t t = off; t; t >>= 1) ++bl;
      const int64_t score = (int64_t)len * 8 - (int64_t)bl * 3;
      if (best.len == 0 || score > best_score) {
        best.len = len;
        best.off = off;
        best_score = score;
      }
      if (len >= kNiceLen || len == max_len) break;
      cand = prev_[mpos % prev_.size()];
    }
    return best;
  }

  // Up to kmax distinct-distance candidates, best-score first. Each entry
  // carries its own maximal length at that distance. kmax == 1 reproduces
  // find() exactly. Also force-includes the longest and nearest matches.
  uint32_t find_multi(const uint8_t *data, uint32_t n, uint32_t pos,
                      Match *out, uint32_t kmax) const {
    if (pos + kMinMatch > n) return 0;
    const uint32_t max_len = std::min<uint32_t>(kMaxMatch, n - pos);
    const uint32_t limit = (pos > kWindow) ? pos - kWindow : 0;

    Match all[kMaxChain];
    int64_t sc[kMaxChain];
    uint32_t cnt = 0;
    uint32_t longest_i = 0, nearest_i = 0;

    uint32_t cand = head_[hash3(data + pos)];
    for (uint32_t depth = 0; depth < kMaxChain && cand != 0; ++depth) {
      const uint32_t mpos = cand - 1;
      if (mpos < limit) break;
      if (mpos >= pos) {
        cand = prev_[mpos % prev_.size()];
        continue;
      }
      if (data[mpos] != data[pos] || data[mpos + 1] != data[pos + 1] ||
          data[mpos + 2] != data[pos + 2]) {
        cand = prev_[mpos % prev_.size()];
        continue;
      }
      uint32_t len = 3;
      while (len < max_len && data[mpos + len] == data[pos + len]) ++len;
      const uint32_t off = pos - mpos;
      uint32_t bl = 0;
      for (uint32_t t = off; t; t >>= 1) ++bl;
      const int64_t score = (int64_t)len * 8 - (int64_t)bl * 3;
      all[cnt] = {len, off};
      sc[cnt] = score;
      if (len > all[longest_i].len) longest_i = cnt;
      if (off < all[nearest_i].off) nearest_i = cnt;
      ++cnt;
      if ((len >= kNiceLen || len == max_len) && cnt >= kmax) break;
      cand = prev_[mpos % prev_.size()];
    }
    if (cnt == 0) return 0;

    // selection: top kmax by score (first-seen wins ties), then force-include
    // the longest and nearest candidates for diversity
    bool used[kMaxChain] = {false};
    uint32_t pick_order[2 + 32];
    uint32_t np = 0;
    for (uint32_t t = 0; t < cnt && np < kmax; ++t) {
      int64_t bs = INT64_MIN;
      uint32_t bi = UINT32_MAX;
      for (uint32_t i = 0; i < cnt; ++i)
        if (!used[i] && sc[i] > bs) { bs = sc[i]; bi = i; }
      if (bi == UINT32_MAX) break;
      used[bi] = true;
      pick_order[np++] = bi;
    }
    for (uint32_t extra : {longest_i, nearest_i}) {
      if (np >= kmax) break;
      if (!used[extra]) { used[extra] = true; pick_order[np++] = extra; }
    }
    // trim to kmax but keep the forced extras: drop the worst-score non-forced
    while (np > kmax) {
      uint32_t drop = 0;
      for (uint32_t j = 1; j < np; ++j)
        if (sc[pick_order[j]] < sc[pick_order[drop]]) drop = j;
      for (uint32_t j = drop; j + 1 < np; ++j) pick_order[j] = pick_order[j + 1];
      --np;
    }
    for (uint32_t j = 0; j < np; ++j) out[j] = all[pick_order[j]];
    return np;
  }

private:
  static uint32_t hash3(const uint8_t *p) {
    const uint32_t v = static_cast<uint32_t>(p[0]) |
                       (static_cast<uint32_t>(p[1]) << 8) |
                       (static_cast<uint32_t>(p[2]) << 16);
    return (v * 2654435761u) >> (32 - kHashBits);
  }

  std::vector<uint32_t> head_;
  std::vector<uint32_t> prev_;
};

} // namespace szip
// G0D SZIP — integer context-mixing literal coder (SZLZRC v3 "GOD stage").
// Original implementation; deterministic fixed-point math only.
#pragma once

#include <cstdint>
#include <vector>

#include "rc.hpp"
#include "tables.hpp"

namespace szip {

double g_enc_price_sum = 0;

#ifndef SZ_WSHIFT
#define SZ_WSHIFT 13
#endif
constexpr int32_t kWShift = SZ_WSHIFT;
#ifndef SZ_ERRSHIFT
#define SZ_ERRSHIFT 18
#endif
#ifndef SZ_WSHIFT_B
#define SZ_WSHIFT_B 13
#endif
#ifndef SZ_ERRSHIFT_B
#define SZ_ERRSHIFT_B 20
#endif
#ifndef SZ_TREESHIFT
#define SZ_TREESHIFT 5
#endif
constexpr int32_t kErrShift = SZ_ERRSHIFT;
constexpr int32_t kTreeShift = SZ_TREESHIFT;
#ifndef SZ_TREESHIFT_B
#define SZ_TREESHIFT_B 4
#endif
#ifndef SZ_T5B
#define SZ_T5B 1
#endif
#ifndef SZ_NO5_B
#define SZ_NO5_B 0
#endif
#ifndef SZ_WCLAMP
#define SZ_WCLAMP 20
#endif
constexpr int32_t kWClamp = 1 << SZ_WCLAMP;

#ifndef SZ_MB
#define SZ_MB 0
#endif
#ifndef SZ_MBW
#define SZ_MBW 0
#endif
#ifndef SZ_WS
#define SZ_WS 1
#endif
#ifndef SZ_STATE
#define SZ_STATE 0
#endif
#ifndef SZ_WSTATE
#define SZ_WSTATE 0
#endif
#ifndef SZ_MB2
#define SZ_MB2 0
#endif
#ifndef SZ_O1EXACT
#define SZ_O1EXACT 1
#endif
#ifndef SZ_BNS
#define SZ_BNS 0
#endif
#ifndef SZ_T5GAP
#define SZ_T5GAP 0
#endif
#ifndef SZ_O1GAP
#define SZ_O1GAP 0
#endif
#ifndef SZ_GAPALL
#define SZ_GAPALL 0
#endif

// Rolling history of the last 5 raw bytes (hist[0] = most recent).
struct Hist {
  uint8_t b[5] = {0, 0, 0, 0, 0};
  uint8_t wpos = 0; // bytes since last space, clamped to 7
  uint8_t bns = 0;  // last non-whitespace byte
  void push(uint8_t v) {
    b[4] = b[3];
    b[3] = b[2];
    b[2] = b[1];
    b[1] = b[0];
    b[0] = v;
    const bool ws = (v == 32) || (v == 9) || (v == 10) || (v == 13);
    const bool wsb = SZ_WS ? ws : (v == 32);
    wpos = wsb ? 0 : (wpos < 7 ? (uint8_t)(wpos + 1) : wpos);
    if (!ws) bns = v;
  }
};

#ifndef SZ_O3BITS
#define SZ_O3BITS 18
#endif
#ifndef SZ_O4BITS
#define SZ_O4BITS 18
#endif
#ifndef SZ_O5BITS
#define SZ_O5BITS 18
#endif

#ifndef SZ_WCTX
#define SZ_WCTX 64
#endif
constexpr uint32_t kWCtx = SZ_WSTATE ? 256u : (uint32_t)SZ_WCTX;

#ifndef SZ_ORDER5
#define SZ_ORDER5 1
#endif

struct MixLit {
  std::vector<Prob> t[6];
  int32_t w[kWCtx][6];
  uint32_t gap_mode = 0;
  int32_t ts_ = SZ_TREESHIFT;
  int32_t wsh_ = SZ_WSHIFT;
  int32_t esh_ = SZ_ERRSHIFT;

  explicit MixLit(uint32_t mode = 0) : gap_mode(mode) {
    ts_ = gap_mode ? SZ_TREESHIFT_B : SZ_TREESHIFT;
    wsh_ = gap_mode ? SZ_WSHIFT_B : SZ_WSHIFT;
    esh_ = gap_mode ? SZ_ERRSHIFT_B : SZ_ERRSHIFT;
    t[0].assign((SZ_STATE ? 96u : 32u) * 256, static_cast<Prob>(kProbInit));
    t[1].assign((SZ_O1EXACT ? 65536u : 8192u) * 256, static_cast<Prob>(kProbInit));
    t[2].assign((1u << SZ_O3BITS) * 256, static_cast<Prob>(kProbInit));
    t[3].assign((1u << SZ_O4BITS) * 256, static_cast<Prob>(kProbInit));
    if (SZ_ORDER5) t[4].assign((1u << SZ_O5BITS) * 256, static_cast<Prob>(kProbInit));
    t[5].assign(65536 * 256, static_cast<Prob>(kProbInit)); // (wpos, prev, pprev>>3) word shape
    for (auto &row : w)
      for (auto &x : row) x = (1 << kWShift) / 6; // start as equal mix
  }

#ifndef SZ_WCTX_WPOS
#define SZ_W_CTX_WPOS 0
#endif
  static uint32_t wctx(uint32_t bitpos, const Hist &h, uint8_t st) {
    if (SZ_WCTX <= 8 && !SZ_WSTATE) return bitpos;
    uint32_t band = SZ_W_CTX_WPOS ? h.wpos : ((uint32_t)h.b[0] >> 5);
    if (SZ_WSTATE) band += 8u * st;
    return bitpos + 8 * band;
  }


  static uint32_t h1(uint8_t a) { return (uint32_t)a >> 3; }
  static uint32_t h2(uint8_t a, uint8_t b, uint8_t wp, uint8_t mb, uint8_t st,
                     uint8_t bns) {
    if (SZ_O1EXACT) {
      if (SZ_O1GAP) return (((uint32_t)a << 8) | bns); // gap order-1 (mode B)
      return (((uint32_t)a << 8) | b);                  // 65536 exact contexts
    }
    const bool use_mb = SZ_MB || (SZ_MB2 && st != 0);
    const uint32_t bb = SZ_BNS ? bns : b;
    return ((uint32_t)a * 2654435761u ^ (uint32_t)bb * 40503u ^
            (uint32_t)wp * 2246822519u ^
            (use_mb ? (uint32_t)mb * 805459861u : 0u)) >> 19;
  }
  static uint32_t h3(uint8_t a, uint8_t b, uint8_t c, uint8_t wp, uint8_t mb) {
    return ((uint32_t)a * 2654435761u ^ (uint32_t)b * 40503u ^
            (uint32_t)c * 805459861u ^ (uint32_t)wp * 2246822519u ^
            (SZ_MB ? (uint32_t)mb * 3266489917u : 0u)) >> (32 - SZ_O3BITS);
  }
  static uint32_t h4(uint8_t a, uint8_t b, uint8_t c, uint8_t d, uint8_t wp) {
    return ((uint32_t)a * 2654435761u ^ (uint32_t)b * 40503u ^
            (uint32_t)c * 805459861u ^ (uint32_t)d * 1013904223u ^
            (uint32_t)wp * 2246822519u) >> (32 - SZ_O4BITS);
  }
  static uint32_t h5(uint8_t a, uint8_t b, uint8_t c, uint8_t d, uint8_t e,
                     uint8_t wp) {
    return ((uint32_t)a * 2654435761u ^ (uint32_t)b * 40503u ^
            (uint32_t)c * 805459861u ^ (uint32_t)d * 1013904223u ^
            (uint32_t)e * 2246822519u ^ (uint32_t)wp * 3266489917u) >> (32 - SZ_O5BITS);
  }
  uint32_t hw(const Hist &h, uint8_t mb) const {
    if (SZ_T5GAP || gap_mode) {
      if (SZ_T5B == 1) return (((uint32_t)h.b[0] << 8) | h.bns); // exact gap o1
      return (((uint32_t)h.wpos << 13) | ((uint32_t)h.b[0] << 5) | ((uint32_t)h.bns >> 3)); // word-shape gap
    }
    const uint32_t last = SZ_MBW ? mb : h.b[1];
    return (((uint32_t)h.wpos << 13) | ((uint32_t)h.b[0] << 5) | (last >> 3));
  }

  // p0 = P(bit == 0) in [1, 2047]
  uint32_t mix(uint32_t wk, const Prob *n0, const Prob *n1, const Prob *n2,
               const Prob *n3, const Prob *n4, const Prob *n5) const {
    const int64_t x0 = kStretch[*n0], x1 = kStretch[*n1];
    const int64_t x2 = kStretch[*n2], x3 = kStretch[*n3];
    const int64_t x4 = n4 ? kStretch[*n4] : 0;
    const int64_t x5 = kStretch[*n5];
    int64_t x = (w[wk][0] * x0 + w[wk][1] * x1 + w[wk][2] * x2 +
                 w[wk][3] * x3 + w[wk][4] * x4 + w[wk][5] * x5) >>
                kWShift;
    if (x > SZIP_SQUASH_BIAS) x = SZIP_SQUASH_BIAS;
    if (x < -SZIP_SQUASH_BIAS) x = -SZIP_SQUASH_BIAS;
    return (uint32_t)kSquash[(x + SZIP_SQUASH_BIAS) >> SZIP_SQUASH_SHIFT];
  }

  void train(uint32_t wk, Prob *n0, Prob *n1, Prob *n2, Prob *n3, Prob *n4,
             Prob *n5, uint32_t bit, uint32_t p) {
    if (bit == 0) {
      *n0 = (Prob)(*n0 + ((2048 - *n0) >> ts_));
      *n1 = (Prob)(*n1 + ((2048 - *n1) >> ts_));
      *n2 = (Prob)(*n2 + ((2048 - *n2) >> ts_));
      *n3 = (Prob)(*n3 + ((2048 - *n3) >> ts_));
      if (n4) *n4 = (Prob)(*n4 + ((2048 - *n4) >> ts_));
      *n5 = (Prob)(*n5 + ((2048 - *n5) >> ts_));
    } else {
      *n0 = (Prob)(*n0 - (*n0 >> ts_));
      *n1 = (Prob)(*n1 - (*n1 >> ts_));
      *n2 = (Prob)(*n2 - (*n2 >> ts_));
      *n3 = (Prob)(*n3 - (*n3 >> ts_));
      if (n4) *n4 = (Prob)(*n4 - (*n4 >> ts_));
      *n5 = (Prob)(*n5 - (*n5 >> ts_));
    }
    const int32_t err = (int32_t)(bit == 0 ? 2048 - p : 0 - p);
    const int64_t xs[6] = {kStretch[*n0], kStretch[*n1], kStretch[*n2],
                           kStretch[*n3], n4 ? kStretch[*n4] : 0,
                           kStretch[*n5]};
    for (int i = 0; i < 6; ++i) {
      int32_t nw = w[wk][i] + (int32_t)((err * xs[i]) >> esh_);
      if (nw > kWClamp) nw = kWClamp;
      if (nw < -kWClamp) nw = -kWClamp;
      w[wk][i] = nw;
    }
  }

  // Update models for one raw byte (no coding). Called for bytes covered by
  // matches too, so prices stay calibrated.
  void train_byte(Hist &h, uint8_t b, uint8_t mb, uint8_t st) {
    const uint32_t c0 = h1(h.b[0]) + (SZ_STATE ? 32u * st : 0u);
    const uint32_t c1 = h2(h.b[0], h.b[1], h.wpos, mb, st, h.bns);
    const uint32_t c2 = h3(h.b[0], h.b[1], h.b[2], h.wpos, mb);
    const uint32_t c3 = h4(h.b[0], h.b[1], h.b[2], h.b[3], h.wpos);
    const uint32_t c5 = SZ_ORDER5 ? h5(h.b[0], h.b[1], h.b[2], h.b[3], h.b[4], h.wpos) : 0;
    const uint32_t cw = hw(h, mb);
    uint32_t sym = 1;
    for (int k = 7; k >= 0; --k) {
      const uint32_t bit = (b >> k) & 1;
      Prob *n0 = &t[0][c0 * 256 + sym], *n1 = &t[1][c1 * 256 + sym];
      Prob *n2 = &t[2][c2 * 256 + sym], *n3 = &t[3][c3 * 256 + sym];
      Prob *n4 = (SZ_ORDER5 && !(gap_mode && SZ_NO5_B)) ? &t[4][c5 * 256 + sym] : nullptr;
      Prob *n5 = &t[5][cw * 256 + sym];
      const uint32_t wk = wctx((uint32_t)(7 - k), h, st);
      const uint32_t p = mix(wk, n0, n1, n2, n3, n4, n5);
      train(wk, n0, n1, n2, n3, n4, n5, bit, p);
      sym = (sym << 1) | bit;
    }
    h.push(b);
  }

  void encode(RcEncoder &rc, Hist &h, uint8_t b, uint8_t mb, uint8_t st) {
    const uint32_t c0 = h1(h.b[0]) + (SZ_STATE ? 32u * st : 0u);
    const uint32_t c1 = h2(h.b[0], h.b[1], h.wpos, mb, st, h.bns);
    const uint32_t c2 = h3(h.b[0], h.b[1], h.b[2], h.wpos, mb);
    const uint32_t c3 = h4(h.b[0], h.b[1], h.b[2], h.b[3], h.wpos);
    const uint32_t c5 = SZ_ORDER5 ? h5(h.b[0], h.b[1], h.b[2], h.b[3], h.b[4], h.wpos) : 0;
    const uint32_t cw = hw(h, mb);
    uint32_t sym = 1;
    for (int k = 7; k >= 0; --k) {
      const uint32_t bit = (b >> k) & 1;
      Prob *n0 = &t[0][c0 * 256 + sym], *n1 = &t[1][c1 * 256 + sym];
      Prob *n2 = &t[2][c2 * 256 + sym], *n3 = &t[3][c3 * 256 + sym];
      Prob *n4 = (SZ_ORDER5 && !(gap_mode && SZ_NO5_B)) ? &t[4][c5 * 256 + sym] : nullptr;
      Prob *n5 = &t[5][cw * 256 + sym];
      const uint32_t wk = wctx((uint32_t)(7 - k), h, st);
      const uint32_t p = mix(wk, n0, n1, n2, n3, n4, n5);
#if SZ_STATS
      g_enc_price_sum += (double)kBitPrice[bit == 0 ? p : 2048 - p];
#endif
      rc.encode_bit_p(p, bit);
      train(wk, n0, n1, n2, n3, n4, n5, bit, p);
      sym = (sym << 1) | bit;
    }
    h.push(b);
  }

  uint8_t decode(RcDecoder &rc, Hist &h, uint8_t mb, uint8_t st) {
    const uint32_t c0 = h1(h.b[0]) + (SZ_STATE ? 32u * st : 0u);
    const uint32_t c1 = h2(h.b[0], h.b[1], h.wpos, mb, st, h.bns);
    const uint32_t c2 = h3(h.b[0], h.b[1], h.b[2], h.wpos, mb);
    const uint32_t c3 = h4(h.b[0], h.b[1], h.b[2], h.b[3], h.wpos);
    const uint32_t c5 = SZ_ORDER5 ? h5(h.b[0], h.b[1], h.b[2], h.b[3], h.b[4], h.wpos) : 0;
    const uint32_t cw = hw(h, mb);
    uint32_t sym = 1;
    for (int k = 0; k < 8; ++k) {
      Prob *n0 = &t[0][c0 * 256 + sym], *n1 = &t[1][c1 * 256 + sym];
      Prob *n2 = &t[2][c2 * 256 + sym], *n3 = &t[3][c3 * 256 + sym];
      Prob *n4 = (SZ_ORDER5 && !(gap_mode && SZ_NO5_B)) ? &t[4][c5 * 256 + sym] : nullptr;
      Prob *n5 = &t[5][cw * 256 + sym];
      const uint32_t wk = wctx((uint32_t)k, h, st);
      const uint32_t p = mix(wk, n0, n1, n2, n3, n4, n5);
      const uint32_t bit = rc.decode_bit_p(p);
      train(wk, n0, n1, n2, n3, n4, n5, bit, p);
      sym = (sym << 1) | bit;
    }
    return (uint8_t)(sym & 0xFFu);
  }

  // Exact cost in 1/16 bits of coding `b` from history `h`. Mirrors encode()
  // bit-for-bit (intra-byte adaptation included) via a shadow training walk,
  // then restores all touched state.
  uint32_t peek(const Hist &h, uint8_t b, uint8_t mb, uint8_t st) {
    const uint32_t c0 = h1(h.b[0]) + (SZ_STATE ? 32u * st : 0u);
    const uint32_t c1 = h2(h.b[0], h.b[1], h.wpos, mb, st, h.bns);
    const uint32_t c2 = h3(h.b[0], h.b[1], h.b[2], h.wpos, mb);
    const uint32_t c3 = h4(h.b[0], h.b[1], h.b[2], h.b[3], h.wpos);
    const uint32_t c5 = SZ_ORDER5 ? h5(h.b[0], h.b[1], h.b[2], h.b[3], h.b[4], h.wpos) : 0;
    const uint32_t cw = hw(h, mb);

    // snapshot the exact state this byte will touch (8 steps x 6 models)
    Prob *nodes[8][6];
    Prob saved_n[8][6];
    uint32_t wks[8];
    int32_t saved_w[8][6];
    uint32_t sym = 1;
    for (int k = 7; k >= 0; --k) {
      const int step = 7 - k;
      nodes[step][0] = &t[0][c0 * 256 + sym];
      nodes[step][1] = &t[1][c1 * 256 + sym];
      nodes[step][2] = &t[2][c2 * 256 + sym];
      nodes[step][3] = &t[3][c3 * 256 + sym];
      nodes[step][4] = (SZ_ORDER5 && !(gap_mode && SZ_NO5_B)) ? &t[4][c5 * 256 + sym] : nullptr;
      nodes[step][5] = &t[5][cw * 256 + sym];
      for (int j = 0; j < 6; ++j) saved_n[step][j] = nodes[step][j] ? *nodes[step][j] : 0;
      const uint32_t wk = wctx((uint32_t)(7 - k), h, st);
      wks[step] = wk;
      for (int j = 0; j < 6; ++j) saved_w[step][j] = w[wk][j];
      sym = (sym << 1) | ((b >> k) & 1u);
    }

    // shadow walk: identical to encode()'s updates, accumulating price
    sym = 1;
    uint32_t price = 0;
    for (int k = 7; k >= 0; --k) {
      const uint32_t bit = (b >> k) & 1;
      const uint32_t wk = wctx((uint32_t)(7 - k), h, st);
      Prob *n0 = nodes[7 - k][0], *n1 = nodes[7 - k][1], *n2 = nodes[7 - k][2];
      Prob *n3 = nodes[7 - k][3], *n4 = nodes[7 - k][4], *n5 = nodes[7 - k][5];
      const uint32_t p = mix(wk, n0, n1, n2, n3, n4, n5);
      price += kBitPrice[bit == 0 ? p : 2048 - p];
      train(wk, n0, n1, n2, n3, n4, n5, bit, p);
      sym = (sym << 1) | bit;
    }

    // restore
    for (int step = 0; step < 8; ++step) {
      for (int j = 0; j < 6; ++j)
        if (nodes[step][j]) *nodes[step][j] = saved_n[step][j];
      for (int j = 0; j < 6; ++j) w[wks[step]][j] = saved_w[step][j];
    }
    return price;
  }
};

} // namespace szip
// G0D SZIP — adaptive binary range coder (carryless, 11-bit probabilities).
// Original implementation for SuperZip; no third-party code.
#pragma once

#include <cstddef>
#include <cstdint>
#include <vector>

namespace szip {

using Prob = uint16_t;

constexpr uint32_t kProbInit = 1024; // 50% prior
constexpr uint32_t kProbBits = 11;
constexpr uint32_t kProbMoveBits = 5;
constexpr uint32_t kTop = 1u << 24;

class RcEncoder {
public:
  explicit RcEncoder(std::vector<uint8_t> &out) : out_(out) {}

  uint64_t bits = 0;

  void encode_bit(Prob &p, uint32_t bit) {
    ++bits;
    const uint32_t bound = (range_ >> kProbBits) * static_cast<uint32_t>(p);
    if (bit == 0) {
      range_ = bound;
      p = static_cast<Prob>(p + ((2048u - p) >> kProbMoveBits));
    } else {
      low_ += bound;
      range_ -= bound;
      p = static_cast<Prob>(p - (p >> kProbMoveBits));
    }
    while (range_ < kTop) {
      range_ <<= 8;
      shift_low();
    }
  }

  void flush() {
    for (int i = 0; i < 5; ++i) shift_low();
  }

  // Encode with an external probability (no prob update); p in [1, 2047]
  // is P(bit == 0).
  void encode_bit_p(uint32_t p, uint32_t bit) {
    ++bits;
    const uint32_t bound = (range_ >> kProbBits) * p;
    if (bit == 0) {
      range_ = bound;
    } else {
      low_ += bound;
      range_ -= bound;
    }
    while (range_ < kTop) {
      range_ <<= 8;
      shift_low();
    }
  }

private:
  void shift_low() {
    const uint32_t high = static_cast<uint32_t>(low_ >> 32);
    if (static_cast<uint32_t>(low_) < 0xFF000000u || high != 0) {
      uint8_t temp = cache_;
      do {
        out_.push_back(static_cast<uint8_t>(temp + static_cast<uint8_t>(high)));
        temp = 0xFF;
      } while (--cache_size_ != 0);
      cache_ = static_cast<uint8_t>(static_cast<uint32_t>(low_) >> 24);
    }
    ++cache_size_;
    low_ = static_cast<uint64_t>(static_cast<uint32_t>(low_) << 8);
  }

  std::vector<uint8_t> &out_;
  uint64_t low_ = 0;
  uint32_t range_ = 0xFFFFFFFFu;
  uint8_t cache_ = 0;
  uint64_t cache_size_ = 1;
};

class RcDecoder {
public:
  RcDecoder(const uint8_t *in, size_t n) : in_(in), in_size_(n) {}

  // Reads the 5-byte prologue (first byte must be 0). False on truncation.
  bool init() {
    if (in_size_ < 5) return false;
    if (in_[0] != 0) return false;
    in_pos_ = 1;
    code_ = 0;
    for (int i = 0; i < 4; ++i) code_ = (code_ << 8) | next_byte();
    return ok_;
  }

  uint32_t decode_bit(Prob &p) {
    const uint32_t bound = (range_ >> kProbBits) * static_cast<uint32_t>(p);
    uint32_t bit;
    if (code_ < bound) {
      range_ = bound;
      p = static_cast<Prob>(p + ((2048u - p) >> kProbMoveBits));
      bit = 0;
    } else {
      code_ -= bound;
      range_ -= bound;
      p = static_cast<Prob>(p - (p >> kProbMoveBits));
      bit = 1;
    }
    while (range_ < kTop) {
      range_ <<= 8;
      code_ = (code_ << 8) | next_byte();
    }
    return bit;
  }

  // Decode with an external probability (no prob update); p in [1, 2047]
  // is P(bit == 0).
  uint32_t decode_bit_p(uint32_t p) {
    const uint32_t bound = (range_ >> kProbBits) * p;
    uint32_t bit;
    if (code_ < bound) {
      range_ = bound;
      bit = 0;
    } else {
      code_ -= bound;
      range_ -= bound;
      bit = 1;
    }
    while (range_ < kTop) {
      range_ <<= 8;
      code_ = (code_ << 8) | next_byte();
    }
    return bit;
  }

  bool ok() const { return ok_; }
  size_t pos() const { return in_pos_; }

private:
  uint8_t next_byte() {
    if (in_pos_ >= in_size_) {
      ok_ = false;
      return 0;
    }
    return in_[in_pos_++];
  }

  const uint8_t *in_;
  size_t in_size_;
  size_t in_pos_ = 0;
  uint32_t range_ = 0xFFFFFFFFu;
  uint32_t code_ = 0;
  bool ok_ = true;
};

} // namespace szip
/* G0D SZIP — C ABI for the SZLZRC block engine (SuperZip project).
 * Own encoder/decoder, no third-party compression code.
 */
#ifndef SZIP_H
#define SZIP_H

#include <stddef.h>
#include <stdint.h>

#ifdef __cplusplus
extern "C" {
#endif

/* Error codes (shared with the Rust engines). */
#define SZIP_OK 0
#define SZIP_ERR_IO (-1)
#define SZIP_ERR_FORMAT (-2)
#define SZIP_ERR_CORRUPT (-3)
#define SZIP_ERR_UNSUPPORTED (-4)
#define SZIP_ERR_NOMEM (-5)
#define SZIP_ERR_TRUNCATED (-6)
#define SZIP_ERR_BUFFER (-7)

/* Container constants. */
#define SZIP_VERSION 4
#define SZIP_MAGIC0 0x53 /* 'S' */
#define SZIP_MAGIC1 0x5A /* 'Z' */
#define SZIP_MAGIC2 0x50 /* 'P' */
#define SZIP_MAGIC3 0x31 /* '1' */
#define SZIP_HEADER_SIZE 20
#define SZIP_FOOTER_SIZE 8
#define SZIP_BLOCK_HEADER_SIZE 10
#define SZIP_BLOCK_STORED 0
#define SZIP_BLOCK_SZLZRC 1
#define SZIP_DEFAULT_BLOCK_SIZE (1u << 20)

/* Codec limits (SZLZRC v1). */
#define SZIP_MIN_MATCH 3
#define SZIP_MAX_MATCH 2048
#define SZIP_MAX_OFFSET (1u << 20)

/* Upper bound for the compressed size of `raw_len` bytes. */
size_t szip_compress_bound(size_t raw_len);

/* Compress one block. dst_len receives the payload size written to dst.
 * Returns SZIP_OK, SZIP_ERR_BUFFER if dst_cap is too small. */
int szip_compress_block(const uint8_t *src, size_t src_len, uint8_t *dst,
                        size_t dst_cap, size_t *dst_len);

/* Decompress one SZLZRC block. `raw_len` is the expected raw size from the
 * block header. Returns SZIP_OK, or a negative error for corrupt input. */
int szip_decompress_block(const uint8_t *src, size_t src_len, uint8_t *dst,
                          size_t raw_len);

/* IEEE CRC-32 (poly 0xEDB88320). */
uint32_t szip_crc32(const uint8_t *data, size_t len);
uint32_t szip_crc32_update(uint32_t crc, const uint8_t *data, size_t len);

#ifdef __cplusplus
} /* extern "C" */

#include <string>
#include <vector>

namespace szip {

/* ---- container (.szip file layout) — C++ reference implementation ---- */

struct Header {
  uint32_t block_size = SZIP_DEFAULT_BLOCK_SIZE;
  uint64_t total_raw = 0;
};

void set_parse_fast(int fast); // 0 = max ratio (default), 1 = fast parse
int compress_file(const std::string &in_path, const std::string &out_path,
                  uint32_t block_size = SZIP_DEFAULT_BLOCK_SIZE);
int compress_buffer(const uint8_t *data, size_t len, std::vector<uint8_t> &out,
                    uint32_t block_size = SZIP_DEFAULT_BLOCK_SIZE);
int decompress_buffer(const uint8_t *data, size_t len, std::vector<uint8_t> &out);
int run_gui(unsigned short port); // built-in lightweight web GUI
int decompress_file(const std::string &in_path, const std::string &out_path,
                    uint64_t *raw_out = nullptr, uint32_t *crc_out = nullptr);
int test_file(const std::string &in_path, uint64_t *raw_out = nullptr);

} /* namespace szip */
#endif /* __cplusplus */

#endif /* SZIP_H */
