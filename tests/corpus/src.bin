  do {                                                                         \
    if (!(cond)) {                                                             \
      std::fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond);     \
      ++g_failures;                                                            \
    }                                                                          \
  } while (0)

static std::vector<uint8_t> block_roundtrip(const std::vector<uint8_t> &src,
                                            int *err_out) {
  std::vector<uint8_t> comp(szip_compress_bound(src.size()) + 16);
  size_t clen = 0;
  int e = szip_compress_block(src.data(), src.size(), comp.data(), comp.size(),
                              &clen);
  if (e != SZIP_OK) {
    *err_out = e;
    return {};
  }
  std::vector<uint8_t> dec(src.size());
  e = szip_decompress_block(comp.data(), clen, dec.data(), src.size());
  *err_out = e;
  if (e != SZIP_OK) return {};
  return dec;
}

static void test_rc_and_block_patterns() {
  int e = 0;
  // edge sizes
  for (size_t n = 0; n <= 40; ++n) {
    std::vector<uint8_t> src(n);
    for (size_t i = 0; i < n; ++i) src[i] = (uint8_t)(i * 7 + 3);
    auto dec = block_roundtrip(src, &e);
    CHECK(e == SZIP_OK);
    CHECK(dec == src);
  }
  // all zeros (RLE-like matches)
  {
    std::vector<uint8_t> src(100000, 0);
    auto dec = block_roundtrip(src, &e);
    CHECK(e == SZIP_OK);
    CHECK(dec == src);
  }
  // repeated pattern
  {
    std::vector<uint8_t> src;
    const char *pat = "the quick brown fox jumps over the lazy dog. ";
    for (int i = 0; i < 2000; ++i)
      for (const char *p = pat; *p; ++p) src.push_back((uint8_t)*p);
    auto dec = block_roundtrip(src, &e);
    CHECK(e == SZIP_OK);
    CHECK(dec == src);
  }
  // incompressible random
  {
    std::mt19937 rng(42);
    std::vector<uint8_t> src(50000);
    for (auto &b : src) b = (uint8_t)rng();
    auto dec = block_roundtrip(src, &e);
    CHECK(e == SZIP_OK);
    CHECK(dec == src);
  }
  // two copies (offset match)
  {
    std::mt19937 rng(7);
    std::vector<uint8_t> half(3000);
    for (auto &b : half) b = (uint8_t)rng();
    std::vector<uint8_t> src = half;
    src.insert(src.end(), half.begin(), half.end());
    auto dec = block_roundtrip(src, &e);
    CHECK(e == SZIP_OK);
    CHECK(dec == src);
  }
  // long run (overlapping match)
  {
    std::vector<uint8_t> src = {'x', 'y', 'z'};
    src.resize(5000, 'a');
    auto dec = block_roundtrip(src, &e);
    CHECK(e == SZIP_OK);
    CHECK(dec == src);
  }
}

static void test_random_roundtrips() {
  std::mt19937 rng(20261023);
  for (int iter = 0; iter < 150; ++iter) {
    const size_t n = rng() % 40000;
    std::vector<uint8_t> src(n);
    // mix: some structured, some raw random
    const int style = iter % 3;
    for (size_t i = 0; i < n; ++i) {
      if (style == 0)
        src[i] = (uint8_t)rng();
      else if (style == 1)
        src[i] = (uint8_t)('a' + (rng() % 4));
      else
        src[i] = (uint8_t)((rng() & 3) ? (i * 13) : (uint8_t)rng());
    }
    int e = 0;
    auto dec = block_roundtrip(src, &e);
    CHECK(e == SZIP_OK);
    CHECK(dec == src);
    if (g_failures) {
      std::fprintf(stderr, "  (iter %d n=%zu style=%d)\n", iter, n, style);
      return;
    }
  }
}

static void test_corruption_rejection() {
  std::mt19937 rng(99);
  // Build a valid compressed block of a structured buffer.
  std::vector<uint8_t> src(20000);
  for (size_t i = 0; i < src.size(); ++i)
    src[i] = (uint8_t)((i % 37 == 0) ? 'Z' : (uint8_t)(i & 0xF));
  std::vector<uint8_t> comp(szip_compress_bound(src.size()) + 16);
  size_t clen = 0;
  CHECK(szip_compress_block(src.data(), src.size(), comp.data(), comp.size(),
                            &clen) == SZIP_OK);
  comp.resize(clen);

  int accepted = 0, rejected = 0;
  for (int iter = 0; iter < 300; ++iter) {
    std::vector<uint8_t> bad = comp;
    // flip 1-3 random payload bytes
    const int flips = 1 + (int)(rng() % 3);
    for (int f = 0; f < flips; ++f)
      bad[rng() % bad.size()] ^= (uint8_t)(1u << (rng() % 8));
    std::vector<uint8_t> dec(src.size());
    const int e = szip_decompress_block(bad.data(), bad.size(), dec.data(),
                                        src.size());
    if (e == SZIP_OK) {
      // decoding garbage to valid-looking output is possible in principle;
      // it must at least never crash (ASan enforces memory safety).
      ++accepted;
    } else {
      ++rejected;
    }
  }
  std::printf("corruption: %d rejected, %d accepted-by-decoder (CRC is the "
              "final gate)\n",
              rejected, accepted);
  CHECK(rejected > 200); // vast majority must be rejected by the codec itself

  // truncated payload must always be rejected
  for (size_t cut = 1; cut < comp.size(); cut += 1 + rng() % 5) {
    std::vector<uint8_t> dec(src.size());
    const int e = szip_decompress_block(comp.data(), cut, dec.data(),
                                        src.size());
    CHECK(e != SZIP_OK);
  }
}

static std::string tmp_path(const char *name) {
  return std::string("build/tmp_") + name;
}

static void write_file(const std::string &path, const std::vector<uint8_t> &d) {
  std::ofstream os(path, std::ios::binary | std::ios::trunc);
  os.write(reinterpret_cast<const char *>(d.data()), (std::streamsize)d.size());
}

static std::vector<uint8_t> read_file(const std::string &path) {
  std::ifstream is(path, std::ios::binary);
  return std::vector<uint8_t>((std::istreambuf_iterator<char>(is)),
                              std::istreambuf_iterator<char>());
}

static void file_roundtrip(const std::vector<uint8_t> &data,
                           uint32_t block_size) {
  const std::string in = tmp_path("in.bin");
  const std::string arc = tmp_path("a.szip");
  const std::string out = tmp_path("out.bin");
  write_file(in, data);
  CHECK(szip::compress_file(in, arc, block_size) == SZIP_OK);
  uint64_t raw = 0;
  uint32_t crc = 0;
  CHECK(szip::decompress_file(arc, out, &raw, &crc) == SZIP_OK);
  CHECK(raw == data.size());
  CHECK(read_file(out) == data);
  CHECK(szip::test_file(arc, nullptr) == SZIP_OK);
}

static void test_container() {
  // empty file
  file_roundtrip({}, 1024);
  // 1 byte
  file_roundtrip({42}, 1024);
  // small blocks force multi-block archives
  std::mt19937 rng(5);
  std::vector<uint8_t> data(100000);
  for (size_t i = 0; i < data.size(); ++i)
    data[i] = (uint8_t)((rng() & 7) ? ('A' + (i % 26)) : rng());
  file_roundtrip(data, 4096);
  file_roundtrip(data, 1048576);
  // pure random (forces stored blocks)
  std::vector<uint8_t> rnd(300000);
  for (auto &b : rnd) b = (uint8_t)rng();
  file_roundtrip(rnd, 65536);

  // integrity: corrupt footer CRC -> must fail
  {
    const std::string in = tmp_path("in.bin");
    const std::string arc = tmp_path("a.szip");
    write_file(in, data);
    CHECK(szip::compress_file(in, arc, 4096) == SZIP_OK);
    auto bytes = read_file(arc);
    bytes[bytes.size() - 5] ^= 0xFF; // smash CRC
    write_file(arc, bytes);
    CHECK(szip::decompress_file(arc, tmp_path("out.bin"), nullptr, nullptr) ==
          SZIP_ERR_CORRUPT);
  }
  // integrity: bad magic -> must fail
  {
    auto bytes = read_file(tmp_path("a.szip"));
    bytes[0] = 'X';
    write_file(tmp_path("a.szip"), bytes);
    CHECK(szip::decompress_file(tmp_path("a.szip"), tmp_path("out.bin"),
                                nullptr, nullptr) == SZIP_ERR_FORMAT);
  }
  // integrity: truncation -> must fail
  {
    const std::string in = tmp_path("in.bin");
    const std::string arc = tmp_path("a.szip");
    write_file(in, data);
    CHECK(szip::compress_file(in, arc, 4096) == SZIP_OK);
    auto bytes = read_file(arc);
    bytes.resize(bytes.size() / 2);
    write_file(arc, bytes);
    CHECK(szip::decompress_file(arc, tmp_path("out.bin"), nullptr, nullptr) !=
          SZIP_OK);
  }
}

int main() {
  // known-answer CRC32: "123456789" -> 0xCBF43926
  CHECK(szip_crc32(reinterpret_cast<const uint8_t *>("123456789"), 9) ==
        0xCBF43926u);
  CHECK(szip_crc32(nullptr, 0) == 0u);

  test_rc_and_block_patterns();
  std::printf("patterns ok\n");
  test_random_roundtrips();
  std::printf("random roundtrips ok\n");
  test_corruption_rejection();
  std::printf("corruption rejection ok\n");
  test_container();
  std::printf("container ok\n");

  if (g_failures) {
    std::printf("FAILURES: %d\n", g_failures);
    return 1;
  }
  std::printf("all tests passed\n");
  return 0;
}
#!/bin/sh
# G0D SZIP — beat-the-sniper verification (frozen corpora).
#
# Checks, with roundtrip verification on every corpus:
#   1. G0D SZIP beats gzip-9, bzip2-9 and xz-9e on code and text.
#   2. The strict goal: code <= 16,933 B  (4% under xz-9e's 17,640 B).
#
# Exit 0 only if EVERY check passes. Sizes for the snipers were measured on
# tests/corpus/{code,text}.bin and are frozen here as thresholds.
set -e
cd "$(dirname "$0")/.."

CC=${CXX:-g++}
mkdir -p build
./tests/mkcorpus.sh >/dev/null
$CC -std=c++17 -O3 -Wall -Wextra -Wshadow -Wconversion -DNDEBUG -Inative \
    native/codec.cpp native/cli.cpp native/gui.cpp -o build/g0dszip -pthread

# frozen sniper sizes (bytes) on the frozen corpora
GZ_CODE=19289; BZ_CODE=18214; XZ_CODE=17640
GZ_TEXT=86546; BZ_TEXT=53954; XZ_TEXT=76764
GZ_RAND=500114; BZ_RAND=502632; XZ_RAND=500084
TARGET_CODE=16933   # xz-9e * 0.96 = 4% under the best sniper

pass=0; fail=0
check() { # check <label> <cond(0/1)>
  if [ "$2" -eq 1 ]; then echo "   ok: $1"; pass=$((pass+1));
  else echo "   FAIL: $1"; fail=$((fail+1)); fi
}

size() { stat -c%s "$1" 2>/dev/null || wc -c < "$1"; }

for f in code text rand; do
  ./build/g0dszip c "build/corpus_$f.bin" "build/x_$f.szip"
  ./build/g0dszip d "build/x_$f.szip" "build/x_$f.out"
  cmp -s "build/corpus_$f.bin" "build/x_$f.out"
  echo "   ok: roundtrip $f"
  pass=$((pass+1))
done

C=$(size build/x_code.szip); T=$(size build/x_text.szip); R=$(size build/x_rand.szip)
echo ""
echo "   code: $C B  (gzip $GZ_CODE, bzip2 $BZ_CODE, xz $XZ_CODE; target $TARGET_CODE)"
echo "   text: $T B  (gzip $GZ_TEXT, bzip2 $BZ_TEXT, xz $XZ_TEXT)"
echo "   rand: $R B  (gzip $GZ_RAND, bzip2 $BZ_RAND, xz $XZ_RAND)"
echo ""

check "code beats gzip-9"  $([ "$C" -lt "$GZ_CODE" ] && echo 1 || echo 0)
check "code beats bzip2-9" $([ "$C" -lt "$BZ_CODE" ] && echo 1 || echo 0)
check "code beats xz-9e"   $([ "$C" -lt "$XZ_CODE" ] && echo 1 || echo 0)
check "code <= 4% under xz ($TARGET_CODE B)" $([ "$C" -le "$TARGET_CODE" ] && echo 1 || echo 0)
check "text beats gzip-9"  $([ "$T" -lt "$GZ_TEXT" ] && echo 1 || echo 0)
check "text beats bzip2-9" $([ "$T" -lt "$BZ_TEXT" ] && echo 1 || echo 0)
check "text beats xz-9e"   $([ "$T" -lt "$XZ_TEXT" ] && echo 1 || echo 0)
check "rand never expands" $([ "$R" -lt "$GZ_RAND" ] && [ "$R" -lt "$XZ_RAND" ] && echo 1 || echo 0)

echo ""
echo "   $pass passed, $fail failed"
[ "$fail" -eq 0 ]
#!/usr/bin/env python3
"""G0D SZIP — benchmark against every compressor available.

Written, runnable check: builds the frozen corpora (tests/mkcorpus.sh), runs
every compressor that exists on this machine at (near) maximum settings,
verifies each roundtrip byte-exact, and prints an honest scoreboard.

  sh tests/benchall.sh          # wrapper: ensures build/venv deps, then runs this

Non-gating: the strict 4%-under-xz gate lives in tests/beatsniper.sh.
This script reports the universe table; exit code 0 as long as every
roundtrip verifies.
"""
import os
import shutil
import subprocess
import sys
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
BUILD = os.path.join(ROOT, "build")
G0D = os.path.join(BUILD, "g0dszip")


def run(cmd, **kw):
    return subprocess.run(cmd, cwd=ROOT, capture_output=True, **kw)


def fmt(n):
    return f"{n:,}"


class Case:
    def __init__(self, name, compress, decompress):
        self.name = name
        self._c = compress
        self._d = decompress

    def run(self, data):
        t0 = time.perf_counter()
        comp = self._c(data)
        t1 = time.perf_counter()
        raw = self._d(comp)
        t2 = time.perf_counter()
        return comp, raw, t1 - t0, t2 - t1


def g0d_case(fast):
    def c(data):
        p = os.path.join(BUILD, "bench_in")
        open(p, "wb").write(data)
        out = os.path.join(BUILD, "bench_g.szip")
        args = [G0D, "c"] + (["-f"] if fast else []) + [p, out]
        r = run(args)
        if r.returncode != 0:
            raise RuntimeError("g0dszip compress failed")
        return open(out, "rb").read()

    def d(comp):
        pc = os.path.join(BUILD, "bench_comp.szip")
        open(pc, "wb").write(comp)
        out = os.path.join(BUILD, "bench_g.out")
        r = run([G0D, "d", pc, out])
        if r.returncode != 0:
            raise RuntimeError("g0dszip decompress failed")
        return open(out, "rb").read()

    return Case("g0dszip" + (" -f (fast)" if fast else " (best)"), c, d)


def lib_case(name, cfn, dfn):
    return Case(name, cfn, dfn)


def build_cases():
    cases = [g0d_case(False), g0d_case(True)]
    if shutil.which("gzip"):
        cases.append(_shell_case("gzip -9", "gzip -9 -c {inp} > {out}", "gzip -dc {inp} > {out}"))
    if shutil.which("bzip2"):
        cases.append(_shell_case("bzip2 -9", "bzip2 -9 -c {inp} > {out}", "bzip2 -dc {inp} > {out}"))
    if shutil.which("xz"):
        cases.append(_shell_case("xz -9e", "xz -9e -c {inp} > {out}", "xz -dc {inp} > {out}"))
    try:
        import zstandard as zstd

        def zc(data):
            return zstd.compress(data, level=22)

        def zd(comp):
            return zstd.decompress(comp)

        cases.append(lib_case("zstd -22 (ultra)", zc, zd))
    except Exception:
        pass
    try:
        import brotli

        def bc(data):
            return brotli.compress(data, quality=11, lgwin=24)

        def bd(comp):
            return brotli.decompress(comp)

        cases.append(lib_case("brotli -q 11 -w 24", bc, bd))
    except Exception:
        pass
    try:
        import lz4.frame as lz4f

        def lc(data):
            return lz4f.compress(data, compression_level=12, block_linked=True)

        def ld(comp):
            return lz4f.decompress(comp)

        cases.append(lib_case("lz4 hc-12", lc, ld))
    except Exception:
        pass
    try:
        import cramjam

        def sc(data):
            return bytes(cramjam.snappy.compress(data))

        def sd(comp):
            return bytes(cramjam.snappy.decompress(comp))

        cases.append(lib_case("snappy", sc, sd))
    except Exception:
        pass
    return cases


def _shell_case(name, cdecl, ddecl):
    def c(data):
        p = os.path.join(BUILD, "bench_in")
        open(p, "wb").write(data)
        out = os.path.join(BUILD, "bench_c.bin")
        run(["bash", "-c", cdecl.format(inp=p, out=out)])
        return open(out, "rb").read()

    def d(comp):
        pc = os.path.join(BUILD, "bench_comp.bin")
        open(pc, "wb").write(comp)
        out = os.path.join(BUILD, "bench_d.bin")
        r = run(["bash", "-c", ddecl.format(inp=pc, out=out)])
        if r.returncode != 0:
            raise RuntimeError(f"{name} decompress failed")
        return open(out, "rb").read()

    return Case(name, c, d)


def main():
    if not os.path.exists(G0D):
        sys.exit("build/g0dszip missing — run: make  (or the g++ line in the README)")
    run(["bash", "tests/mkcorpus.sh"])
    corpora = [
        ("code", os.path.join(BUILD, "corpus_code.bin")),
        ("text", os.path.join(BUILD, "corpus_text.bin")),
        ("rand", os.path.join(BUILD, "corpus_rand.bin")),
        ("src", os.path.join(BUILD, "corpus_src.bin")),
    ]
    # extra real-world corpus: this repository's own source code
    with open(os.path.join(BUILD, "corpus_src.bin"), "wb") as f:
        for sub in ("native", "tests", "docs", "rust"):
            for root, _, files in os.walk(os.path.join(ROOT, sub)):
                for fn in sorted(files):
                    if fn.endswith((".bin", ".szip")):
                        continue
                    try:
                        f.write(open(os.path.join(root, fn), "rb").read())
                    except OSError:
                        pass
        f.write(open(os.path.join(ROOT, "README.md"), "rb").read())

    cases = build_cases()
    failures = 0
    totals = {}
    print("G0D SZIP — universe benchmark  (single-run wall times, indicative)")
    print(f"compressors found: {len(cases)}")
    for cname, path in corpora:
        data = open(path, "rb").read()
        print(f"\n=== {cname}  ({fmt(len(data))} B) ===")
        rows = []
        for case in cases:
            try:
                comp, raw, tc, td = case.run(data)
                ok = raw == data
            except Exception as e:
                print(f"  {case.name:28s}  FAILED ({e})")
                failures += 1
                continue
            if not ok:
                print(f"  {case.name:28s}  ROUNDTRIP CORRUPT")
                failures += 1
                continue
            rows.append((len(comp), case.name, tc, td))
        rows.sort()
        best_other = None
        for size, name, tc, td in rows:
            ratio = 100.0 * size / len(data) if data else 0
            tag = " <-- G0D" if name.startswith("g0dszip") else ""
            mark = ""
            if not name.startswith("g0dszip") and best_other is None:
                best_other = (size, name)
            print(f"  {name:28s}  {fmt(size):>12s} B  {ratio:6.2f}%"
                  f"  c {tc:6.2f}s  d {td:6.2f}s  roundtrip ok{tag}{mark}")
        g0d = [r for r in rows if r[1].startswith("g0dszip (best)")]
        if g0d and best_other:
            gs = g0d[0][0]
            delta = 100.0 * (best_other[0] - gs) / best_other[0]
            win = gs <= best_other[0]
            totals[cname] = (win, delta, best_other[1])
            print(f"  -> vs best alternative ({best_other[1]} {fmt(best_other[0])} B): "
                  f"{'WIN by %.2f%%' % delta if win else 'behind by %.2f%%' % (-delta)}")
    print("\n=== universe verdict ===")
    wins = sum(1 for v in totals.values() if v[0])
    for k, (win, delta, who) in totals.items():
        print(f"  {k:5s} {'WIN' if win else 'LOSS'}  vs {who}  ({'+' if win else ''}{delta:.2f}%)")
    print(f"\n  {wins}/{len(totals)} first places")
    print("  note: zstd/brotli/lz4/snappy need build/venv (sh tests/benchall.sh);")
    print("        extensible codec IDs in .szip v4 leave room for more models.")
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
#!/bin/sh
# G0D SZIP — universe benchmark (written check).
# Ensures the benchmark venv (zstd/brotli/lz4/snappy bindings) exists, then
# runs tests/benchall.py against every compressor available on this machine.
set -e
cd "$(dirname "$0")/.."
mkdir -p build
if [ ! -x build/venv/bin/python ]; then
  python3 -m venv build/venv
  build/venv/bin/pip install --quiet cramjam zstandard brotli lz4 || true
fi
exec build/venv/bin/python tests/benchall.py "$@"
#!/bin/sh
# G0D SZIP — cross-engine compatibility checks.
# Proves the C++ engine, the Rust engine and the merged Rust+C++ engine
# produce/consume byte-identical .szip archives.
set -e

cd "$(dirname "$0")/.."
mkdir -p build

echo "== building C++ engine =="
make all >/dev/null

# test corpora
cat native/*.cpp native/*.hpp > build/x_code.bin
python3 -c "
import random
random.seed(2)
w='alpha beta gamma delta epsilon zeta eta theta superzip g0d szip compress archive'.split()
out=[]; n=0
while n < 200000:
    x=random.choice(w); out.append(x); n+=len(x)+1
open('build/x_text.bin','w').write(' '.join(out))
" 2>/dev/null || echo "alpha beta gamma delta superzip" > build/x_text.bin
head -c 200000 /dev/urandom > build/x_rand.bin
: > build/x_empty.bin

CPP=build/g0dszip

roundtrip() { # engine_enc engine_dec file
  "$1" c "$3" build/x.szip
  "$2" d build/x.szip build/x.out
  cmp -s "$3" build/x.out
}

echo "== C++ engine self-roundtrips =="
for f in x_empty.bin x_code.bin x_text.bin x_rand.bin; do
  roundtrip "$CPP" "$CPP" "build/$f"
  echo "   ok: $f"
done

if ! command -v cargo >/dev/null 2>&1; then
  echo "== cargo not found: skipping Rust/cross-engine checks =="
  echo "   (the Rust workspace in rust/ is ready; run this script where cargo exists)"
  exit 0
fi

echo "== building Rust workspace (szip-core, szip-sys, CLIs) =="
cargo build --release --manifest-path rust/Cargo.toml >/dev/null

RS=../rust/target/release/g0dszip
RSPP=../rust/target/release/g0dszip-cpp
RS=$(pwd)/rust/target/release/g0dszip
RSPP=$(pwd)/rust/target/release/g0dszip-cpp

echo "== Rust engine self-roundtrips =="
for f in x_empty.bin x_code.bin x_text.bin x_rand.bin; do
  roundtrip "$RS" "$RS" "build/$f"
  echo "   ok: $f"
done

echo "== merged engine (Rust+C++) self-roundtrips =="
for f in x_empty.bin x_code.bin x_text.bin x_rand.bin; do
  roundtrip "$RSPP" "$RSPP" "build/$f"
  echo "   ok: $f"
done

echo "== cross-engine decode matrix =="
for f in x_code.bin x_text.bin x_rand.bin; do
  for enc in "$CPP" "$RS" "$RSPP"; do
    "$enc" c "build/$f" build/x.szip
    for dec in "$CPP" "$RS" "$RSPP"; do
      "$dec" d build/x.szip build/x.out
      cmp -s "build/$f" build/x.out
    done
  done
  echo "   ok: $f decodes on all engines"
done

echo "== determinism: encoders must be byte-identical =="
for f in x_code.bin x_text.bin x_rand.bin; do
  "$CPP" c "build/$f" build/a1.szip
  "$RS" c "build/$f" build/a2.szip
  "$RSPP" c "build/$f" build/a3.szip
  cmp -s build/a1.szip build/a2.szip
  cmp -s build/a1.szip build/a3.szip
  echo "   ok: $f"
done

echo "ALL CROSSCHECKS PASSED"
#!/bin/sh
# G0D SZIP — deterministic benchmark corpora recipes.
# Writes build/corpus_{code,text,rand}.bin
#   code : frozen tests/corpus/code.bin (hand-written sources at freeze time)
#   text : frozen tests/corpus/text.bin (word-salad, python3 seed 1)
#   rand : /dev/urandom 500000 (fresh per run; ratio ~100% is the point)
#
# The code/text corpora are FROZEN bytes committed under tests/corpus/ so
# benchmark claims stay reproducible as the project sources evolve.
set -e
cd "$(dirname "$0")/.."
mkdir -p build
cp tests/corpus/code.bin build/corpus_code.bin
cp tests/corpus/text.bin build/corpus_text.bin
head -c 500000 /dev/urandom > build/corpus_rand.bin
wc -c build/corpus_*.bin
# G0D SZIP — `.szip` Container Format (v4)

Reference project: **SuperZip / G0D SZIP**. This document is normative for the
byte layout of `.szip` archives and the SZLZRC v3 bitstream.

Design goals:

1. **Own everything** — encoder, decoder, entropy coder, match finder and CRC
   are original implementations (C++ engine `native/` and Rust engine
   `rust/szip-core/`). No third-party compression code.
2. **Deterministic** — same input + same settings ⇒ byte-identical output.
3. **Hostile-input safe** — every length is validated; the decoder never reads
   or writes out of bounds.
4. **Extensible** — codec IDs and block framing allow future "GOD stages"
   without breaking v3 files.

All multi-byte integers are **little-endian**. All arithmetic below is exact;
where machine integer wraparound is intended it is written `mod 2^32`.

---

## 1. File layout

```
header (20 bytes) | block* | footer (8 bytes)
```

### 1.1 Header (20 bytes)

| off | size | field |
|-----|------|-------|
| 0   | 4    | magic `"SZP1"` |
| 4   | 1    | `version` = `3` |
| 5   | 1    | flags (bit0 = stream CRC present; always 1) |
| 6   | 2    | reserved, zero |
| 8   | 8    | `raw_size` (total uncompressed bytes, LE u64) |

### 1.2 Block framing

Each block: `type` (1 byte), `pad` (1 byte, zero), `comp_size` (LE u24,
bytes after the 4-byte prefix), payload (`comp_size` bytes).

| type | codec |
|------|-------|
| 0    | stored (raw copy) |
| 1    | SZLZRC v4 payload: 1 mode byte (`0` = word mode, `1` = gap mode) then the RC stream |
| other| reserved |

Sum of block `raw_size` fields must equal the header `raw_size`.

### 1.3 Footer (8 bytes)

`stream_crc` (LE u32, CRC-32/ISO-HDLC of the raw stream) and `reserved`
(LE u32, zero).

---

## 2. Block codec: SZLZRC v4 (`type = 1`)

**S**uper**Z**ip **LZ**77 + **R**ange **C**oder + context mixing, v4.

Pipeline: LZ77 factorization (hash chains, price-aware parse, 1 MiB window,
last-3 rep offsets) → token stream → adaptive binary range coder (carryless,
11-bit probabilities). **Literals** are bit-coded through the integer
context-mixing model of §2.4 ("GOD stage"); token syntax and match/rep coding
are as in SZLZRC v2.

### 2.1 Range coder

State: `low` (u64), `range` (u32, init `0xFFFFFFFF`), `code` (u32, decoder).

Bit coding with probability `p` (u16, init `1024`, updated with shift 5):

```
bound = (range >> 11) * p
bit 0:  range = bound;         p += (2048 - p) >> 5
bit 1:  low += bound; range -= bound; p -= p >> 5   (decoder: code -= bound)
normalize while range < 2^24:  range <<= 8; emit/consume one byte
```

Encoder writes a 5-byte flush tail (`shiftLow` x5). The decoder pre-reads 5
bytes (first must be `0`) and must finish having consumed the payload exactly.

**Fixed-probability bits** (used by the literal mixer): identical bound
arithmetic, but `p` is supplied externally and is *not* updated by the coder.
`p` is the probability that the bit is `0`, in `[1, 2047]`.

### 2.2 Token models (all u16, init `1024`, self-updating as in §2.1)

- `is_match` — literal vs match flag
- `is_rep` — rep match vs normal match
- `rep_sel[2]` — rep index: bit0 `0`→rep0, `1`→rep1/2; bit1 `0`→rep1, `1`→rep2
- `len_unary[12]`, `len_bits[10]` — Elias gamma of `len - 2`
- `off_mode` — offset mode flag
- `tiny_unary[8]`, `tiny_bits[8]` — Elias gamma of `off` (tiny mode)
- `slot_unary[12]`, `slot_bits[10]` — Elias gamma of `n - 2` (slot mode)
- `off_direct[19]` — mantissa bits of `off - 1`

Elias gamma value `x >= 1`, `n = floor(log2 x)`: `n` one-bits, one zero-bit,
then the `n` low bits of `x` MSB-first. Each position `i` uses its own
adaptive probability (`unary[i]`, `bits[i]`).

### 2.3 Token stream

Decoder state: history `hist` (last 5 raw bytes, all `0` initially, plus
`wpos` = bytes since the last whitespace byte (`0x20/0x09/0x0A/0x0D`),
clamped to `7`, init `0`; `bns` = last non-whitespace byte, init `0`),
`rep0,rep1,rep2` (1-based offsets, `0` = none), all zero initially.

```
repeat until raw_size bytes are produced:
  is_match?
  0 -> literal:
       byte = MIXDECODE(hist)                      (section 2.4)
       push(hist, byte)
  1 -> is_rep?
       1 -> rep match:
            rep_sel bits select idx in {0,1,2}
            len  = gamma(len_unary/len_bits) + 2      in [3, 2048]
            offset = rep[idx]                          (must be != 0, <= out_pos)
            rep update: if idx > 0 { tmp=rep[idx]; shift; rep0=tmp }
       0 -> normal match:
            offset code (below)
            len  = gamma(len_unary/len_bits) + 2      in [3, 2048]
            rep update: rep2=rep1; rep1=rep0; rep0=offset
       copy len bytes from out_pos - offset (overlap allowed)
       for each copied byte b in order: MIXTRAIN(hist, b); push(hist, b)
```

`push(hist, b)`: `hist.b[4..1] = hist.b[3..0]; hist.b[0] = b;` then
`wpos = ws(b) ? 0 : min(wpos + 1, 7)` where `ws(b)` is `b` in
`{0x20, 0x09, 0x0A, 0x0D}`; `if !ws(b): bns = b`.

**Offset code** (`u = off - 1`, `n = bitlen(u)`):

- `u < 4` (off 1..4): `off_mode = 0`, then `gamma(off)`
- else: `off_mode = 1`, then `gamma(n - 2)`, then the `n - 1` mantissa bits
  of `u` (top bit of `u` implicitly `1`): the low `min(n-1, 4)` bits are
  coded through the 4-bit **align tree** `off_align` (binary tree, node `idx`
  starts at `1`, `idx = 2*idx + bit`), the remaining high bits with
  `off_direct[i]` (bit `i`, `i` from `n-2` down to `ntree`)

`off` must decode to `[1, 2^20]`.

### 2.4 Literal mixer ("GOD stage", normative)

All probabilities below are integers in `[1, 2047]` (11-bit, `1024` = 50%).
All hashing multiplies are `uint32` (`mod 2^32`); `>>` on negative values is
an arithmetic shift.

**Fixed-point tables** (generated; reference implementation
`native/tables.hpp`, `rust/szip-core/src/tables.rs`):

- `STRETCH[2048]` (i32): `STRETCH[p] = clamp(round(log2(p/(2048-p)) * 4096),
  -45056, 45056)` for `p` in 1..2047, `STRETCH[0] = -45056`.
- `SQUASH[5633]` (i16): `SQUASH[i] = clamp(round(2048 / (1 + 2^(-x/4096))),
  1, 2047)` with `x = i*16 - 45056`.
- `BIT_PRICE[2049]` (u16): `BIT_PRICE[p] = clamp(round(-log2(p/2048) * 256),
  1, 5120)` (1/256-bit units; encoder-only).

**Model state**: six binary trees `t0..t5`, each `num_ctx × 256` u16 nodes
indexed `[ctx * 256 + sym]`, `sym` in 1..255 during the walk (leaf `sym = 0`
is never indexed). All nodes init `1024`. Mixer weights `w[64][6]` init
`(1<<13)/6`, clamp `±2^20`.

Contexts at literal time (`b0..b4 = hist.b[0..4]`, `wp = wpos`, `bn = bns`;
`mode` is the block mode byte):

```
c0 = b0 >> 3                                             (32 ctx)
c1 = (b0 << 8) | b1                                      (65536 exact)
c2 = (b0*2654435761 ^ b1*40503 ^ b2*805459861 ^ wp*2246822519) >> 14
c3 = (b0*2654435761 ^ b1*40503 ^ b2*805459861 ^ b3*1013904223 ^ wp*2246822519) >> 14
c4 = (b0*2654435761 ^ b1*40503 ^ b2*805459861 ^ b3*1013904223
      ^ b4*2246822519 ^ wp*3266489917) >> 14               (262144 ctx)
c5 = mode ? ((b0 << 8) | bn) : ((wp << 13) | (b0 << 5) | (b1 >> 3))   (65536)
```

Tree sizes: `t0` 32, `t1` 65536, `t2` 262144, `t3` 262144, `t4` 262144,
`t5` 65536 contexts.

**Per-mode rates**: tree nodes update `p += (2048-p)>>5` / `p -= p>>5` in
mode `0`, `>>4` in mode `1`. Mixer weight error shift: `>>18` in mode `0`,
`>>20` in mode `1`. Weight scale `>>13` both. (The encoder encodes each
block in both modes and stores the smaller; the mode byte selects which the
decoder applies.)

**Mixer**: weights `w[64][6]` (i32), all init `1365` (= `2^13 / 6`, equal
mix). Weight context `wk = bitpos + 8 * (b0 >> 5)` where `bitpos` counts the
coded bits of the byte MSB-first: the first bit (bit 7) uses `bitpos = 0`,
…, the last (bit 0) uses `bitpos = 7`.

Per bit of a literal byte, `sym` starting at 1 (MSB first, `bit` is the bit):

```
p_i   = t_i[ctx_i * 256 + sym]                 (p_4 valid only if tree exists)
x     = Σ_i w[wk][i] * STRETCH[p_i]            >> 13  (arithmetic)
x     = clamp(x, -45056, 45056)
p_mix = SQUASH[(x + 45056) >> 4]
RC fixed-prob bit with p = p_mix               (MIXDECODE reads the bit here)
// updates, in this exact order:
if bit == 0:  p_i += (2048 - p_i) >> 5         for every tree i
else:         p_i -= p_i >> 5
err = bit == 0 ? 2048 - p_mix : -p_mix
for i in 0..5:
    w[wk][i] = clamp(w[wk][i] + ((err * STRETCH[p_i_after_update]) >> 17),
                     -2^20, 2^20)
sym = (sym << 1) | bit
```

`MIXTRAIN(hist, b)` performs the same per-bit walk and updates (trees and
weights) with `bit` taken from `b`, without touching the range coder; it does
not push `hist` (the caller does). Encoder and decoder must call
`MIXTRAIN` for every match-covered byte so both stay in lock-step.

### 2.5 Encoder parse (advice; decoder-agnostic)

The parse policy is **not** part of the bitstream contract — any factorization
respecting the grammar decodes correctly. The shipped encoder uses
**dynamic-programming optimal parse** per block and mode:

- Match finder: 3-byte hash (`v * 2654435761 >> 14`), 18-bit table, hash
  chains, window `2^20`, chain depth `400`, max match `2048`; up to 8
  distinct-distance candidates per position (top by score, plus longest and
  nearest).
- Per position, three edge kinds: a literal; any rep0-2 family (length
  3..rep_maxlen); normal matches (full length sets 3..max_len at each
  candidate distance).
- Edge prices are exact (the models' live coded costs, `BIT_PRICE` at
  1/256-bit units; literal edges use the mixer's shadow price, trained bit by
  bit while pricing and restored afterwards).
- Four planning passes run per mode (beam width 8); each pass after the
  first calibrates the price model along the previous plan's exact token
  history. Every candidate plan is encoded and the ACTUAL smaller payload
  ships. Both modes (mode byte `0`/`1`) are encoded per block and the smaller
  payload ships there too. The decoder cannot observe any of this.

### 2.6 Stored blocks (`type = 0`)

Raw bytes verbatim. The encoder picks stored whenever the compressed payload
would not be smaller than `raw_size` (incompressible data never expands).

---

## 3. Integrity

The decoder rejects: bad magic/version, truncation, `raw_size`/`comp_size`
violations, range-coder over/under-consumption, invalid offsets/lengths, and a
footer CRC mismatch. A corrupted archive must never cause out-of-bounds access.

## 4. Versioning

`version = 1` (2026-10-23, pre-release) used SZLZRC v1 (no rep offsets, plain
gamma offsets). `version = 2` used SZLZRC v2 (rep offsets + price-aware
parse + order-1 literal trees). Both are rejected by the version field.
`version = 3` replaces literal coding with the §2.4 context mixer; token
syntax is unchanged from v2. `version = 4` (2026-10-24) changes the mixer
(exact order-1, gap/word dual mode with per-mode rates, whitespace `wpos`),
the offset code (align tree), and prefixes each coded payload with its mode
byte. v1-v3 streams are rejected by the version field.
[workspace]
resolver = "2"
members = ["szip-core", "szip-sys", "g0dszip", "g0dszip-cpp"]

[workspace.package]
version = "0.1.0"
edition = "2021"
license = "MIT OR Apache-2.0"
[package]
name = "g0dszip-cpp"
version.workspace = true
edition.workspace = true
license.workspace = true
description = "G0D SZIP CLI — Rust container + C++ SZLZRC engine (the merge)"

[dependencies]
szip-core = { path = "../szip-core" }
szip-sys = { path = "../szip-sys" }
//! g0dszip-cpp — G0D SZIP CLI: Rust container + C++ SZLZRC block engine.
//! This binary is the Rust/C++ merge: Rust owns the .szip layout, safety and
//! CLI; the C++ engine (native/) does the codec math through the C ABI.

use std::env;
use std::fs::File;
use std::io::{BufReader, BufWriter};
use std::process::exit;

use szip_core::codec::SzipError;
use szip_core::container::{compress_with, decompress_with, test_with};
use szip_core::DEFAULT_BLOCK_SIZE;

fn usage() -> ! {
    eprintln!(
        "G0D SZIP — SuperZip compressor (format .szip), Rust+C++ engine\n\
         \n\
         usage:\n\
         \x20 g0dszip-cpp c|compress   [-b blocksize] <input> <output.szip>\n\
         \x20 g0dszip-cpp d|decompress <input.szip> <output>\n\
         \x20 g0dszip-cpp t|test       <input.szip>\n\
         \x20 g0dszip-cpp i|info       <input.szip>\n\
         \n\
         \x20 -b N   raw block size in bytes (default 1048576, max 16777216)"
    );
    exit(2);
}

fn fail(what: &str, path: &str, e: SzipError) -> ! {
    eprintln!("{}: {}: {}", what, path, e);
    exit(1);
}

fn open_in(path: &str) -> BufReader<File> {
    match File::open(path) {
        Ok(f) => BufReader::new(f),
        Err(_) => fail("open", path, SzipError::Io),
    }
}

fn open_out(path: &str) -> BufWriter<File> {
    match File::create(path) {
        Ok(f) => BufWriter::new(f),
        Err(_) => fail("create", path, SzipError::Io),
    }
}

fn enc_cpp(s: &[u8], d: &mut Vec<u8>) -> Result<(), SzipError> {
    match szip_sys::compress_block(s) {
        Ok(v) => {
            d.clear();
            d.extend_from_slice(&v);
            Ok(())
        }
        Err(code) => Err(SzipError::from_code(code)),
    }
}

fn dec_cpp(s: &[u8], d: &mut [u8]) -> Result<(), SzipError> {
    szip_sys::decompress_block(s, d).map_err(SzipError::from_code)
}

fn main() {
    let args: Vec<String> = env::args().collect();
    if args.len() < 2 {
        usage();
    }
    match args[1].as_str() {
        "c" | "compress" => {
            let mut i = 2;
            let mut block_size = DEFAULT_BLOCK_SIZE;
            if i + 1 < args.len() && args[i] == "-b" {
                block_size = match args[i + 1].parse::<u32>() {
                    Ok(v) if v > 0 && v <= (1 << 24) => v,
                    _ => {
                        eprintln!("bad block size: {}", args[i + 1]);
                        exit(2);
                    }
                };
                i += 2;
            }
            if args.len() - i != 2 {
                usage();
            }
            let (input, output) = (&args[i], &args[i + 1]);
            let total = match std::fs::metadata(input) {
                Ok(md) => md.len(),
                Err(_) => fail("open", input, SzipError::Io),
            };
            let mut r = open_in(input);
            let mut w = open_out(output);
            if let Err(e) = compress_with(&mut r, &mut w, total, block_size, &enc_cpp) {
                let _ = std::fs::remove_file(output);
                fail("compress", input, e);
            }
        }
        "d" | "decompress" => {
            if args.len() != 4 {
                usage();
            }
            let (input, output) = (&args[2], &args[3]);
            let mut r = open_in(input);
            let mut w = open_out(output);
            if let Err(e) = decompress_with(&mut r, &mut w, &dec_cpp) {
                let _ = std::fs::remove_file(output);
                fail("decompress", input, e);
            }
        }
        "t" | "test" => {
            if args.len() != 3 {
                usage();
            }
            let mut r = open_in(&args[2]);
            match test_with(&mut r, &dec_cpp) {
                Ok(raw) => println!("{}: ok ({} bytes)", args[2], raw),
                Err(e) => fail("test", &args[2], e),
            }
        }
        "i" | "info" => {
            if args.len() != 3 {
                usage();
            }
            let path = &args[2];
            let mut r = open_in(path);
            match test_with(&mut r, &dec_cpp) {
                Ok(raw) => {
                    let comp = std::fs::metadata(path).map(|m| m.len()).unwrap_or(0);
                    println!("file       : {}", path);
                    println!("format     : .szip v{}", szip_core::VERSION);
                    println!("codec      : SZLZRC v3 (LZ77 + rep-matches + context-mixing literals)");
                    println!("engine     : szip-sys (C++ native + Rust container)");
                    println!("raw size   : {} bytes", raw);
                    println!("archive    : {} bytes", comp);
                    if raw > 0 {
                        println!(
                            "ratio      : {:.2}%  ({:.3} bits/byte)",
                            100.0 * comp as f64 / raw as f64,
                            8.0 * comp as f64 / raw as f64
                        );
                    }
                    println!("integrity  : CRC32 verified");
                }
                Err(e) => fail("info", path, e),
            }
        }
        "-h" | "--help" | "help" => usage(),
        _ => usage(),
    }
}
[package]
name = "g0dszip"
version.workspace = true
edition.workspace = true
license.workspace = true
description = "G0D SZIP CLI — pure-Rust engine (szip-core)"

[dependencies]
szip-core = { path = "../szip-core" }
//! g0dszip — G0D SZIP CLI, pure-Rust engine (szip-core).
//! Own encoder/decoder; no third-party code.

use std::env;
use std::fs::File;
use std::io::{BufReader, BufWriter};
use std::process::exit;

use szip_core::codec::{compress_block, decompress_block, SzipError};
use szip_core::container::{compress_with, decompress_with, test_with};
use szip_core::DEFAULT_BLOCK_SIZE;

fn usage() -> ! {
    eprintln!(
        "G0D SZIP — SuperZip compressor (format .szip), Rust engine\n\
         \n\
         usage:\n\
         \x20 g0dszip c|compress   [-b blocksize] <input> <output.szip>\n\
         \x20 g0dszip d|decompress <input.szip> <output>\n\
         \x20 g0dszip t|test       <input.szip>\n\
         \x20 g0dszip i|info       <input.szip>\n\
         \n\
         \x20 -b N   raw block size in bytes (default 1048576, max 16777216)"
    );
    exit(2);
}

fn fail(what: &str, path: &str, e: SzipError) -> ! {
    eprintln!("{}: {}: {}", what, path, e);
    exit(1);
}

fn open_in(path: &str) -> BufReader<File> {
    match File::open(path) {
        Ok(f) => BufReader::new(f),
        Err(_) => fail("open", path, SzipError::Io),
    }
}

fn open_out(path: &str) -> BufWriter<File> {
    match File::create(path) {
        Ok(f) => BufWriter::new(f),
        Err(_) => fail("create", path, SzipError::Io),
    }
}

fn main() {
    let args: Vec<String> = env::args().collect();
    if args.len() < 2 {
        usage();
    }
    match args[1].as_str() {
        "c" | "compress" => {
            let mut i = 2;
            let mut block_size = DEFAULT_BLOCK_SIZE;
            if i + 1 < args.len() && args[i] == "-b" {
                block_size = match args[i + 1].parse::<u32>() {
                    Ok(v) if v > 0 && v <= (1 << 24) => v,
                    _ => {
                        eprintln!("bad block size: {}", args[i + 1]);
                        exit(2);
                    }
                };
                i += 2;
            }
            if args.len() - i != 2 {
                usage();
            }
            let (input, output) = (&args[i], &args[i + 1]);
            let total = match std::fs::metadata(input) {
                Ok(md) => md.len(),
                Err(_) => fail("open", input, SzipError::Io),
            };
            let mut r = open_in(input);
            let mut w = open_out(output);
            let enc = |s: &[u8], d: &mut Vec<u8>| compress_block(s, d);
            if let Err(e) = compress_with(&mut r, &mut w, total, block_size, &enc) {
                let _ = std::fs::remove_file(output);
                fail("compress", input, e);
            }
        }
        "d" | "decompress" => {
            if args.len() != 4 {
                usage();
            }
            let (input, output) = (&args[2], &args[3]);
            let mut r = open_in(input);
            let mut w = open_out(output);
            let dec = |s: &[u8], d: &mut [u8]| decompress_block(s, d);
            if let Err(e) = decompress_with(&mut r, &mut w, &dec) {
                let _ = std::fs::remove_file(output);
                fail("decompress", input, e);
            }
        }
        "t" | "test" => {
            if args.len() != 3 {
                usage();
            }
            let mut r = open_in(&args[2]);
            let dec = |s: &[u8], d: &mut [u8]| decompress_block(s, d);
            match test_with(&mut r, &dec) {
                Ok(raw) => println!("{}: ok ({} bytes)", args[2], raw),
                Err(e) => fail("test", &args[2], e),
            }
        }
        "i" | "info" => {
            if args.len() != 3 {
                usage();
            }
            let path = &args[2];
            let mut r = open_in(path);
            let dec = |s: &[u8], d: &mut [u8]| decompress_block(s, d);
            match test_with(&mut r, &dec) {
                Ok(raw) => {
                    let comp = std::fs::metadata(path).map(|m| m.len()).unwrap_or(0);
                    println!("file       : {}", path);
                    println!("format     : .szip v{}", szip_core::VERSION);
                    println!("codec      : SZLZRC v3 (LZ77 + rep-matches + context-mixing literals)");
                    println!("engine     : szip-core (Rust)");
                    println!("raw size   : {} bytes", raw);
                    println!("archive    : {} bytes", comp);
                    if raw > 0 {
                        println!(
                            "ratio      : {:.2}%  ({:.3} bits/byte)",
                            100.0 * comp as f64 / raw as f64,
                            8.0 * comp as f64 / raw as f64
                        );
                    }
                    println!("integrity  : CRC32 verified");
                }
                Err(e) => fail("info", path, e),
            }
        }
        "-h" | "--help" | "help" => usage(),
        _ => usage(),
    }
}
[package]
name = "szip-core"
version.workspace = true
edition.workspace = true
license.workspace = true
description = "G0D SZIP (.szip) — pure-Rust encoder/decoder engine, no dependencies"

[dependencies]
//! SZLZRC v3 block codec: LZ77 + rep offsets + context-mixing literal coder.
//! Original implementation, twin of native/codec.cpp block layer.

use crate::lz77::{MatchFinder, NICE_LEN};
use crate::rc::{RcDecoder, RcEncoder, PROB_INIT};
use crate::{MAX_MATCH, MIN_MATCH};

/// Error type shared by the engines and the container layer.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum SzipError {
    Io,
    Format,
    Corrupt,
    Unsupported,
    Nomem,
    Truncated,
    Buffer,
}

impl std::fmt::Display for SzipError {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        let s = match self {
            SzipError::Io => "i/o error",
            SzipError::Format => "bad format",
            SzipError::Corrupt => "corrupt archive",
            SzipError::Unsupported => "unsupported feature",
            SzipError::Nomem => "out of memory",
            SzipError::Truncated => "truncated archive",
            SzipError::Buffer => "buffer too small",
        };
        f.write_str(s)
    }
}

impl std::error::Error for SzipError {}

impl SzipError {
    /// Error codes matching the C ABI in native/szip.h.
    pub fn to_code(self) -> i32 {
        match self {
            SzipError::Io => -1,
            SzipError::Format => -2,
            SzipError::Corrupt => -3,
            SzipError::Unsupported => -4,
            SzipError::Nomem => -5,
            SzipError::Truncated => -6,
            SzipError::Buffer => -7,
        }
    }

    pub fn from_code(code: i32) -> SzipError {
        match code {
            -1 => SzipError::Io,
            -2 => SzipError::Format,
            -3 => SzipError::Corrupt,
            -4 => SzipError::Unsupported,
            -5 => SzipError::Nomem,
            -6 => SzipError::Truncated,
            -7 => SzipError::Buffer,
            _ => SzipError::Corrupt,
        }
    }
}


struct Model {
    is_match: u16,
    is_rep: u16,
    rep_sel: [u16; 2],
    len_unary: [u16; 12],   // gamma of (len - 2), x in [1, 2046]
    len_bits: [u16; 10],
    off_mode: u16,          // 0: tiny (off 1-4), 1: slot+direct
    tiny_unary: [u16; 8],   // gamma of off, x in [1, 4]
    tiny_bits: [u16; 8],
    slot_unary: [u16; 12],  // gamma of (n - 2), x in [1, 18]
    slot_bits: [u16; 10],
    off_direct: [u16; 19],  // low n-1 bits of off-1
}

impl Model {
    fn new() -> Self {
        Model {
            is_match: PROB_INIT,
            is_rep: PROB_INIT,
            rep_sel: [PROB_INIT; 2],
            len_unary: [PROB_INIT; 12],
            len_bits: [PROB_INIT; 10],
            off_mode: PROB_INIT,
            tiny_unary: [PROB_INIT; 8],
            tiny_bits: [PROB_INIT; 8],
            slot_unary: [PROB_INIT; 12],
            slot_bits: [PROB_INIT; 10],
            off_direct: [PROB_INIT; 19],
        }
    }

}

/// Elias gamma for x >= 1: n one-bits, one zero-bit, then n low bits MSB first.
fn encode_gamma(rc: &mut RcEncoder, unary: &mut [u16], bits: &mut [u16], x: u32) {
    let mut n = 0u32;
    while (2u32 << n) <= x {
        n += 1;
    }
    for i in 0..n {
        rc.encode_bit(&mut unary[i as usize], 1);
    }
    rc.encode_bit(&mut unary[n as usize], 0);
    let mut i = n;
    while i > 0 {
        i -= 1;
        let b = (x >> i) & 1;
        rc.encode_bit(&mut bits[i as usize], b);
    }
}

fn decode_gamma(
    rc: &mut RcDecoder,
    unary: &mut [u16],
    bits: &mut [u16],
    n_max: u32,
) -> Result<u32, SzipError> {
    let mut n = 0u32;
    while rc.decode_bit(&mut unary[n as usize]) == 1 {
        n += 1;
        if n > n_max {
            return Err(SzipError::Corrupt);
        }
    }
    let mut x = 1u32;
    let mut i = n;
    while i > 0 {
        i -= 1;
        x = (x << 1) | rc.decode_bit(&mut bits[i as usize]);
    }
    Ok(x)
}

// Offset: u = off - 1, n = bitlen(u).
//   tiny mode (off 1-4):  gamma(off)
//   slot mode (off >= 5): gamma(n - 2), then n-1 direct low bits of u
fn encode_offset(rc: &mut RcEncoder, m: &mut Model, off: u32) {
    let u = off - 1;
    if u < 4 {
        rc.encode_bit(&mut m.off_mode, 0);
        encode_gamma(rc, &mut m.tiny_unary, &mut m.tiny_bits, off);
        return;
    }
    rc.encode_bit(&mut m.off_mode, 1);
    let mut n = 0u32;
    while (1u32 << n) <= u {
        n += 1;
    }
    encode_gamma(rc, &mut m.slot_unary, &mut m.slot_bits, n - 2);
    let mut i = n - 1;
    while i > 0 {
        i -= 1;
        let b = (u >> i) & 1;
        rc.encode_bit(&mut m.off_direct[i as usize], b);
    }
}

fn decode_offset(rc: &mut RcDecoder, m: &mut Model) -> Result<u32, SzipError> {
    if rc.decode_bit(&mut m.off_mode) == 0 {
        let off = decode_gamma(rc, &mut m.tiny_unary, &mut m.tiny_bits, 6)?;
        if off == 0 || off > 4 {
            return Err(SzipError::Corrupt);
        }
        return Ok(off);
    }
    let x = decode_gamma(rc, &mut m.slot_unary, &mut m.slot_bits, 10)?;
    if x < 1 || x > 18 {
        return Err(SzipError::Corrupt);
    }
    let n = x + 2;
    let mut u = 1u32 << (n - 1);
    let mut i = n - 1;
    while i > 0 {
        i -= 1;
        u |= rc.decode_bit(&mut m.off_direct[i as usize]) << i;
    }
    if u + 1 > crate::MAX_OFFSET {
        return Err(SzipError::Corrupt);
    }
    Ok(u + 1)
}

struct RepPick {
    len: u32,
    idx: u32,
}

fn rep_match(src: &[u8], n: usize, pos: usize, reps: &[u32; 3]) -> RepPick {
    let mut best = RepPick { len: 0, idx: 0 };
    let max_len = core::cmp::min(MAX_MATCH as usize, n - pos);
    for i in 0..3 {
        let off = reps[i] as usize;
        if off == 0 || off > pos {
            continue;
        }
        let mut len = 0usize;
        while len < max_len && src[pos + len] == src[pos - off + len] {
            len += 1;
        }
        if len >= MIN_MATCH as usize && len as u32 > best.len {
            best.len = len as u32;
            best.idx = i as u32;
        }
    }
    best
}

fn reps_after_normal(reps: &mut [u32; 3], off: u32) {
    reps[2] = reps[1];
    reps[1] = reps[0];
    reps[0] = off;
}

fn reps_after_rep(reps: &mut [u32; 3], idx: u32) {
    if idx > 0 {
        let tmp = reps[idx as usize];
        let mut j = idx;
        while j > 0 {
            reps[j as usize] = reps[(j - 1) as usize];
            j -= 1;
        }
        reps[0] = tmp;
    }
}

/// bit price of Elias gamma(x): 2*floor(log2 x) + 1
fn price_gamma(x: u32) -> u32 {
    let mut g = 0u32;
    while (2u32 << g) <= x {
        g += 1;
    }
    2 * g + 1
}

/// Compress one block with a given parse bias into `out` (cleared first).
fn encode_block_szlzrc(src: &[u8], out: &mut Vec<u8>, parse_bias: u32) {
    out.clear();
    let n = src.len();
    let mut rc = RcEncoder::new();
    let mut m = Model::new();
    let mut mix = MixLit::new();
    let mut hist = Hist::new();
    let mut mf = MatchFinder::new();
    mf.prepare(n);

    let mut inserted = vec![false; n];
    let mut pos = 0usize;
    let mut reps = [0u32; 3];

    while pos < n {
        if !inserted[pos] {
            inserted[pos] = true;
            mf.insert(src, n, pos);
        }
        let rep = rep_match(src, n, pos, &reps);
        let nm = mf.find(src, n, pos);

        let mut use_rep = false;
        if rep.len >= MIN_MATCH {
            if nm.len < MIN_MATCH || rep.len > nm.len {
                use_rep = true;
            } else {
                let rep_cost = 3 + price_gamma(rep.len - 2);
                let nm_cost = price_gamma(nm.off) + price_gamma(nm.len - 2);
                use_rep = rep_cost + 5 * (nm.len - rep.len) < nm_cost;
            }
        }
        let cur_len = if use_rep { rep.len } else { nm.len };

        // reject matches that cost more than writing literals
        let mut eff_len = cur_len;
        if cur_len >= MIN_MATCH {
            let est = if use_rep {
                3 + price_gamma(cur_len - 2)
            } else {
                1 + price_gamma(nm.off) + price_gamma(cur_len - 2)
            };
            let lit_price = mix.peek_span(&hist, src, pos, cur_len as usize);
            if est * parse_bias > lit_price {
                eff_len = 0;
            }
        }

        if eff_len >= MIN_MATCH {
            let mut skip = false;
            if eff_len < NICE_LEN && pos + 1 < n {
                if !inserted[pos + 1] {
                    inserted[pos + 1] = true;
                    mf.insert(src, n, pos + 1);
                }
                let rep2 = rep_match(src, n, pos + 1, &reps);
                let nm2 = mf.find(src, n, pos + 1);
                let next_len = core::cmp::max(rep2.len, nm2.len);
                if next_len >= eff_len + 1 {
                    skip = true;
                }
            }
            if skip {
                rc.encode_bit(&mut m.is_match, 0);
                mix.encode(&mut rc, &mut hist, src[pos]);
                pos += 1;
                continue;
            }

            if use_rep {
                rc.encode_bit(&mut m.is_match, 1);
                rc.encode_bit(&mut m.is_rep, 1);
                rc.encode_bit(&mut m.rep_sel[0], if rep.idx == 0 { 0 } else { 1 });
                if rep.idx != 0 {
                    rc.encode_bit(&mut m.rep_sel[1], if rep.idx == 1 { 0 } else { 1 });
                }
                encode_gamma(&mut rc, &mut m.len_unary, &mut m.len_bits, rep.len - 2);
                reps_after_rep(&mut reps, rep.idx);
                for p in pos + 1..pos + rep.len as usize {
                    if !inserted[p] {
                        inserted[p] = true;
                        mf.insert(src, n, p);
                    }
                }
                for i in pos..pos + rep.len as usize {
                    mix.train_byte(&mut hist, src[i]);
                }
                pos += rep.len as usize;
            } else {
                rc.encode_bit(&mut m.is_match, 1);
                rc.encode_bit(&mut m.is_rep, 0);
                encode_offset(&mut rc, &mut m, nm.off);
                encode_gamma(&mut rc, &mut m.len_unary, &mut m.len_bits, nm.len - 2);
                reps_after_normal(&mut reps, nm.off);
                for p in pos + 1..pos + nm.len as usize {
                    if !inserted[p] {
                        inserted[p] = true;
                        mf.insert(src, n, p);
                    }
                }
                for i in pos..pos + nm.len as usize {
                    mix.train_byte(&mut hist, src[i]);
                }
                pos += nm.len as usize;
            }
        } else {
            rc.encode_bit(&mut m.is_match, 0);
            mix.encode(&mut rc, &mut hist, src[pos]);
            pos += 1;
        }
    }
    rc.flush();
    *out = rc.into_bytes();
}

/// Compress one block into `out` (cleared first). Encoder-side multi-parse:
/// try several match/literal price biases and keep the smallest payload.
pub fn compress_block(src: &[u8], out: &mut Vec<u8>) -> Result<(), SzipError> {
    out.clear();
    let mut best: Vec<u8> = Vec::new();
    let mut cand: Vec<u8> = Vec::new();
    for bias in [13u32, 16, 20] {
        encode_block_szlzrc(src, &mut cand, bias);
        if best.is_empty() || cand.len() < best.len() {
            core::mem::swap(&mut best, &mut cand);
        }
    }
    *out = best;
    Ok(())
}

/// Decompress one SZLZRC block into `dst` (length = raw size).
pub fn decompress_block(src: &[u8], dst: &mut [u8]) -> Result<(), SzipError> {
    let n = dst.len();
    if n == 0 {
        return Ok(());
    }
    if src.len() < 5 {
        return Err(SzipError::Truncated);
    }
    let mut rc = RcDecoder::new(src);
    if !rc.init() {
        return Err(SzipError::Truncated);
    }

    let mut m = Model::new();
    let mut mix = MixLit::new();
    let mut hist = Hist::new();
    let mut out_pos = 0usize;
    let mut reps = [0u32; 3];

    while out_pos < n {
        if rc.decode_bit(&mut m.is_match) == 0 {
            dst[out_pos] = mix.decode(&mut rc, &hist);
            hist.push(dst[out_pos]);
            out_pos += 1;
        } else if rc.decode_bit(&mut m.is_rep) == 1 {
            let mut idx = 0u32;
            if rc.decode_bit(&mut m.rep_sel[0]) == 1 {
                idx = if rc.decode_bit(&mut m.rep_sel[1]) == 0 { 1 } else { 2 };
            }
            let xlen = decode_gamma(&mut rc, &mut m.len_unary, &mut m.len_bits, 10)?;
            if !rc.ok() {
                return Err(SzipError::Truncated);
            }
            let len = xlen + 2;
            if len < MIN_MATCH || len > MAX_MATCH {
                return Err(SzipError::Corrupt);
            }
            let off = reps[idx as usize];
            if off == 0 || off as usize > out_pos {
                return Err(SzipError::Corrupt);
            }
            if len as usize > n - out_pos {
                return Err(SzipError::Corrupt);
            }
            let off = off as usize;
            for i in 0..len as usize {
                let b = dst[out_pos - off + i];
                dst[out_pos + i] = b;
            }
            reps_after_rep(&mut reps, idx);
            for i in 0..len as usize {
                let b = dst[out_pos + i];
                mix.train_byte(&mut hist, b);
            }
            out_pos += len as usize;
        } else {
            let off = decode_offset(&mut rc, &mut m)?;
            let xlen = decode_gamma(&mut rc, &mut m.len_unary, &mut m.len_bits, 10)?;
            if !rc.ok() {
                return Err(SzipError::Truncated);
            }
            let len = xlen + 2;
            if len < MIN_MATCH || len > MAX_MATCH {
                return Err(SzipError::Corrupt);
            }
            if off == 0 || off as usize > out_pos {
                return Err(SzipError::Corrupt);
            }
            if len as usize > n - out_pos {
                return Err(SzipError::Corrupt);
            }
            let off = off as usize;
            for i in 0..len as usize {
                let b = dst[out_pos - off + i];
                dst[out_pos + i] = b;
            }
            reps_after_normal(&mut reps, off as u32);
            for i in 0..len as usize {
                let b = dst[out_pos + i];
                mix.train_byte(&mut hist, b);
            }
            out_pos += len as usize;
        }
        if !rc.ok() {
            return Err(SzipError::Truncated);
        }
    }
    if !rc.ok() {
        return Err(SzipError::Truncated);
    }
    if rc.pos() != src.len() {
        return Err(SzipError::Corrupt);
    }
    Ok(())
}

/// Upper bound for the compressed size of `raw_len` bytes (C ABI parity).
pub fn compress_bound(raw_len: usize) -> usize {
    raw_len + raw_len / 2 + 64
}

#[cfg(test)]
mod tests {
    use super::*;

    fn roundtrip(src: &[u8]) {
        let mut comp = Vec::new();
        compress_block(src, &mut comp).unwrap();
        let mut dec = vec![0u8; src.len()];
        decompress_block(&comp, &mut dec).unwrap();
        assert_eq!(src, &dec[..], "roundtrip mismatch for len {}", src.len());
    }

    #[test]
    fn patterns() {
        for n in 0..40 {
            let src: Vec<u8> = (0..n).map(|i| (i * 7 + 3) as u8).collect();
            roundtrip(&src);
        }
        roundtrip(&vec![0u8; 100000]);
        let mut v = Vec::new();
        for _ in 0..2000 {
            v.extend_from_slice(b"the quick brown fox jumps over the lazy dog. ");
        }
        roundtrip(&v);
    }

    #[test]
    fn randomish() {
        let mut state = 0x12345678u32;
        let mut rng = move || {
            state ^= state << 13;
            state ^= state >> 17;
            state ^= state << 5;
            state
        };
        for _ in 0..60 {
            let n = (rng() % 20000) as usize;
            let src: Vec<u8> = (0..n).map(|_| rng() as u8).collect();
            roundtrip(&src);
        }
    }

    #[test]
    fn corruption_rejected() {
        let src: Vec<u8> = (0..5000)
            .map(|i| if i % 37 == 0 { b'Z' } else { (i & 0xF) as u8 })
            .collect();
        let mut comp = Vec::new();
        compress_block(&src, &mut comp).unwrap();
        let mut bad = comp.clone();
        bad[bad.len() / 2] ^= 0xFF;
        let mut dec = vec![0u8; src.len()];
        let _ = decompress_block(&bad, &mut dec);
        for cut in [1usize, 2, 5, comp.len() / 2, comp.len() - 1] {
            if cut < comp.len() {
                let mut dec = vec![0u8; src.len()];
                assert!(decompress_block(&comp[..cut], &mut dec).is_err());
            }
        }
    }
}
//! `.szip` container (file layout) — Rust implementation, twin of the C++
//! container layer. The block codec is pluggable so the C++ engine can be
//! used interchangeably (same bytes in, same bytes out).

use std::io::{Read, Write};

use crate::codec::SzipError;
use crate::crc32::crc32_update;
use crate::{
    BLOCK_HEADER_SIZE, BLOCK_STORED, BLOCK_SZLZRC, FOOTER_SIZE, HEADER_SIZE, MAGIC, VERSION,
};

/// Block compressor signature: appends the SZLZRC payload to `out`.
pub type CompressFn<'a> = &'a dyn Fn(&[u8], &mut Vec<u8>) -> Result<(), SzipError>;
/// Block decompressor signature: decodes payload into `dst` (len = raw size).
pub type DecompressFn<'a> = &'a dyn Fn(&[u8], &mut [u8]) -> Result<(), SzipError>;

fn put_u16(out: &mut Vec<u8>, v: u16) {
    out.extend_from_slice(&v.to_le_bytes());
}

fn put_u32(out: &mut Vec<u8>, v: u32) {
    out.extend_from_slice(&v.to_le_bytes());
}

fn put_u64(out: &mut Vec<u8>, v: u64) {
    out.extend_from_slice(&v.to_le_bytes());
}

fn read_exact_n<R: Read>(r: &mut R, n: usize) -> Result<Vec<u8>, SzipError> {
    let mut buf = vec![0u8; n];
    r.read_exact(&mut buf).map_err(|_| SzipError::Truncated)?;
    Ok(buf)
}

fn get_u16(b: &[u8]) -> u16 {
    u16::from_le_bytes([b[0], b[1]])
}

fn get_u32(b: &[u8]) -> u32 {
    u32::from_le_bytes([b[0], b[1], b[2], b[3]])
}

fn get_u64(b: &[u8]) -> u64 {
    u64::from_le_bytes([b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7]])
}

/// Compress `total_raw` bytes from `reader` into a `.szip` stream on `writer`.
pub fn compress_with<R: Read, W: Write>(
    reader: &mut R,
    writer: &mut W,
    total_raw: u64,
    block_size: u32,
    enc: CompressFn<'_>,
) -> Result<(), SzipError> {
    if block_size == 0 || block_size > (1 << 24) {
        return Err(SzipError::Format);
    }

    // header
    let mut hdr = Vec::with_capacity(HEADER_SIZE);
    hdr.extend_from_slice(&MAGIC);
    hdr.push(VERSION);
    hdr.push(0); // flags
    put_u16(&mut hdr, 0); // reserved
    put_u32(&mut hdr, block_size);
    put_u64(&mut hdr, total_raw);
    writer.write_all(&hdr).map_err(|_| SzipError::Io)?;

    let mut payload: Vec<u8> = Vec::new();
    let mut crc = 0u32;
    let mut remaining = total_raw;

    while remaining > 0 {
        let want = std::cmp::min(block_size as u64, remaining) as usize;
        let block = read_exact_n(reader, want)?;
        crc = crc32_update(crc, &block);

        enc(&block, &mut payload)?;
        let store = payload.len() >= want;
        let comp_size = if store { want } else { payload.len() };

        let mut bh = [0u8; BLOCK_HEADER_SIZE];
        bh[0] = if store { BLOCK_STORED } else { BLOCK_SZLZRC };
        bh[1] = 0;
        bh[2..6].copy_from_slice(&(want as u32).to_le_bytes());
        bh[6..10].copy_from_slice(&(comp_size as u32).to_le_bytes());
        writer.write_all(&bh).map_err(|_| SzipError::Io)?;
        if store {
            writer.write_all(&block).map_err(|_| SzipError::Io)?;
        } else {
            writer.write_all(&payload[..comp_size]).map_err(|_| SzipError::Io)?;
        }

        remaining -= want as u64;
    }

    let mut ft = Vec::with_capacity(FOOTER_SIZE);
    put_u32(&mut ft, crc);
    ft.extend_from_slice(&MAGIC);
    writer.write_all(&ft).map_err(|_| SzipError::Io)?;
    Ok(())
}

/// Decompress a `.szip` stream from `reader` into `writer`.
/// Returns the raw size.
pub fn decompress_with<R: Read, W: Write>(
    reader: &mut R,
    writer: &mut W,
    dec: DecompressFn<'_>,
) -> Result<u64, SzipError> {
    let hdr = read_exact_n(reader, HEADER_SIZE)?;
    if hdr[0..4] != MAGIC {
        return Err(SzipError::Format);
    }
    if hdr[4] != VERSION {
        return Err(SzipError::Unsupported);
    }
    let block_size = get_u32(&hdr[8..12]);
    let total_raw = get_u64(&hdr[12..20]);
    if block_size == 0 || block_size > (1 << 24) {
        return Err(SzipError::Format);
    }

    let mut crc = 0u32;
    let mut produced = 0u64;

    while produced < total_raw {
        let bh = read_exact_n(reader, BLOCK_HEADER_SIZE)?;
        let typ = bh[0];
        let raw_size = get_u32(&bh[2..6]) as usize;
        let comp_size = get_u32(&bh[6..10]) as usize;

        if raw_size == 0 || raw_size > block_size as usize {
            return Err(SzipError::Corrupt);
        }
        if raw_size as u64 > total_raw - produced {
            return Err(SzipError::Corrupt);
        }
        if typ == BLOCK_STORED {
            if comp_size != raw_size {
                return Err(SzipError::Corrupt);
            }
        } else if typ == BLOCK_SZLZRC {
            if comp_size < 5 || comp_size > crate::codec::compress_bound(raw_size) {
                return Err(SzipError::Corrupt);
            }
        } else {
            return Err(SzipError::Unsupported);
        }

        let payload = read_exact_n(reader, comp_size)?;
        let mut raw = vec![0u8; raw_size];
        if typ == BLOCK_STORED {
            raw.copy_from_slice(&payload);
        } else {
            dec(&payload, &mut raw)?;
        }

        crc = crc32_update(crc, &raw);
        writer.write_all(&raw).map_err(|_| SzipError::Io)?;
        produced += raw_size as u64;
    }

    let ft = read_exact_n(reader, FOOTER_SIZE)?;
    let stored_crc = get_u32(&ft[0..4]);
    if ft[4..8] != MAGIC {
        return Err(SzipError::Format);
    }
    if stored_crc != crc {
        return Err(SzipError::Corrupt);
    }
    Ok(produced)
}

/// Validate a `.szip` stream without writing output. Returns the raw size.
pub fn test_with<R: Read>(reader: &mut R, dec: DecompressFn<'_>) -> Result<u64, SzipError> {
    let mut sink = std::io::sink();
    decompress_with(reader, &mut sink, dec)
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::codec::{compress_block, decompress_block};

    fn roundtrip(data: &[u8], block_size: u32) {
        let mut arc = Vec::new();
        let mut reader = std::io::Cursor::new(data);
        compress_with(
            &mut reader,
            &mut arc,
            data.len() as u64,
            block_size,
            &|s, d| compress_block(s, d),
        )
        .unwrap();

        let mut out = Vec::new();
        let mut r = std::io::Cursor::new(&arc);
        let n = decompress_with(&mut r, &mut out, &|s, d| decompress_block(s, d)).unwrap();
        assert_eq!(n, data.len() as u64);
        assert_eq!(out, data);
    }

    #[test]
    fn container_roundtrip() {
        roundtrip(b"", 1024);
        roundtrip(b"A", 1024);
        let mut v = Vec::new();
        for i in 0..100000u32 {
            v.push(if i % 7 == 0 { b'Q' } else { (i % 26 + b'a') as u8 });
        }
        roundtrip(&v, 4096);
        roundtrip(&v, 1 << 20);
    }

    #[test]
    fn rejects_corruption() {
        let mut v = Vec::new();
        for i in 0..20000u32 {
            v.push(if i % 37 == 0 { b'Z' } else { (i & 0xF) as u8 });
        }
        let mut arc = Vec::new();
        let mut reader = std::io::Cursor::new(&v);
        compress_with(
            &mut reader,
            &mut arc,
            v.len() as u64,
            4096,
            &|s, d| compress_block(s, d),
        )
        .unwrap();

        // smash footer CRC
        let mut bad = arc.clone();
        let n = bad.len();
        bad[n - 5] ^= 0xFF;
        let mut out = Vec::new();
        let mut r = std::io::Cursor::new(&bad);
        assert_eq!(
            decompress_with(&mut r, &mut out, &|s, d| decompress_block(s, d)),
            Err(SzipError::Corrupt)
        );

        // bad magic
        let mut bad = arc.clone();
        bad[0] = b'X';
        let mut r = std::io::Cursor::new(&bad);
        assert_eq!(
            decompress_with(&mut r, &mut out, &|s, d| decompress_block(s, d)),
            Err(SzipError::Format)
        );

        // truncation
        let mut bad = arc.clone();
        bad.truncate(arc.len() / 2);
        let mut r = std::io::Cursor::new(&bad);
        assert!(decompress_with(&mut r, &mut out, &|s, d| decompress_block(s, d)).is_err());
    }
}
//! IEEE CRC-32 (poly 0xEDB88320). Original implementation.

const fn make_table() -> [u32; 256] {
    let mut table = [0u32; 256];
    let mut i = 0usize;
    while i < 256 {
        let mut c = i as u32;
        let mut k = 0;
        while k < 8 {
            c = if c & 1 != 0 { 0xEDB8_8320 ^ (c >> 1) } else { c >> 1 };
            k += 1;
        }
        table[i] = c;
        i += 1;
    }
    table
}

static TABLE: [u32; 256] = make_table();

/// Incremental IEEE CRC-32. Chain with the previous output; start at 0.
pub fn crc32_update(crc: u32, data: &[u8]) -> u32 {
    let mut c = crc ^ 0xFFFF_FFFF;
    for &b in data {
        c = TABLE[((c ^ b as u32) & 0xFF) as usize] ^ (c >> 8);
    }
    c ^ 0xFFFF_FFFF
}

/// One-shot IEEE CRC-32.
pub fn crc32(data: &[u8]) -> u32 {
    crc32_update(0, data)
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn known_vectors() {
        // "123456789" -> 0xCBF43926
        assert_eq!(crc32(b"123456789"), 0xCBF4_3926);
        assert_eq!(crc32(b""), 0);
    }
}
//! G0D SZIP — pure-Rust engine for the `.szip` format (SuperZip project).
//!
//! Own encoder and own decoder: LZ77 match finder, adaptive binary range
//! coder, CRC-32 and container layout are all original implementations.
//! No third-party code, no dependencies.

pub mod codec;
pub mod container;
pub mod crc32;
pub mod lz77;
pub mod mix;
pub mod rc;
pub mod tables;

pub use codec::{compress_block, decompress_block, SzipError};
pub use container::{compress_with, decompress_with};

/// Container constants (see docs/SZIP_FORMAT.md).
pub const MAGIC: [u8; 4] = [0x53, 0x5A, 0x50, 0x31]; // "SZP1"
pub const VERSION: u8 = 3;
pub const HEADER_SIZE: usize = 20;
pub const FOOTER_SIZE: usize = 8;
pub const BLOCK_HEADER_SIZE: usize = 10;
pub const BLOCK_STORED: u8 = 0;
pub const BLOCK_SZLZRC: u8 = 1;
pub const DEFAULT_BLOCK_SIZE: u32 = 1 << 20;

/// SZLZRC v3 codec limits.
pub const MIN_MATCH: u32 = 3;
pub const MAX_MATCH: u32 = 2048;
pub const MAX_OFFSET: u32 = 1 << 20;
//! LZ77 hash-chain match finder with price-aware candidate selection.
//! Original implementation, twin of native/lz77.hpp — same parameters, same
//! decisions (deterministic, byte-identical output).

use crate::{MAX_MATCH, MIN_MATCH};

const WINDOW_LOG: u32 = 20;
const WINDOW: u32 = 1 << WINDOW_LOG;
const HASH_BITS: u32 = 18;
const HASH_SIZE: usize = 1 << HASH_BITS;
const MAX_CHAIN: u32 = 400;
pub const NICE_LEN: u32 = 128;

#[derive(Clone, Copy, Default)]
pub struct Match {
    pub len: u32,
    pub off: u32, // 1-based
}

pub struct MatchFinder {
    head: Vec<u32>,
    prev: Vec<u32>,
}

#[inline]
fn hash3(p: &[u8]) -> usize {
    let v = (p[0] as u32) | ((p[1] as u32) << 8) | ((p[2] as u32) << 16);
    (v.wrapping_mul(2_654_435_761) >> (32 - HASH_BITS)) as usize
}

impl MatchFinder {
    pub fn new() -> Self {
        MatchFinder {
            head: Vec::new(),
            prev: Vec::new(),
        }
    }

    /// `prev` is indexed modulo the block length; call once per block.
    pub fn prepare(&mut self, block_len: usize) {
        self.head = vec![0u32; HASH_SIZE];
        self.prev = vec![0u32; if block_len == 0 { 1 } else { block_len }];
    }

    pub fn insert(&mut self, data: &[u8], n: usize, pos: usize) {
        if pos + MIN_MATCH as usize > n {
            return;
        }
        let h = hash3(&data[pos..]);
        let prev_len = self.prev.len();
        self.prev[pos % prev_len] = self.head[h];
        self.head[h] = (pos + 1) as u32;
    }

    pub fn find(&self, data: &[u8], n: usize, pos: usize) -> Match {
        let mut best = Match::default();
        let mut best_score = i64::MIN;
        if pos + MIN_MATCH as usize > n {
            return best;
        }

        let max_len = core::cmp::min(MAX_MATCH as usize, n - pos);
        let limit = if pos > WINDOW as usize {
            pos - WINDOW as usize
        } else {
            0
        };

        let prev_len = self.prev.len();
        let mut cand = self.head[hash3(&data[pos..])];
        let mut depth = 0u32;
        while depth < MAX_CHAIN && cand != 0 {
            let mpos = (cand - 1) as usize;
            if mpos < limit {
                break;
            }
            if mpos >= pos {
                // current position (or lazy look-ahead) is in the chain: skip it
                cand = self.prev[mpos % prev_len];
                depth += 1;
                continue;
            }

            // cheap reject: first 3 bytes must match
            if data[mpos] != data[pos]
                || data[mpos + 1] != data[pos + 1]
                || data[mpos + 2] != data[pos + 2]
            {
                cand = self.prev[mpos % prev_len];
                depth += 1;
                continue;
            }

            let mut len = 3usize;
            while len < max_len && data[mpos + len] == data[pos + len] {
                len += 1;
            }

            // price-aware: prefer longer matches, but a much nearer match can win
            let off = (pos - mpos) as u32;
            let mut bl = 0u32;
            let mut t = off;
            while t != 0 {
                bl += 1;
                t >>= 1;
            }
            let score = len as i64 * 8 - bl as i64 * 3;
            if best.len == 0 || score > best_score {
                best.len = len as u32;
                best.off = off;
                best_score = score;
            }
            if len >= NICE_LEN as usize || len == max_len {
                break;
            }
            cand = self.prev[mpos % prev_len];
            depth += 1;
        }
        best
    }
}

impl Default for MatchFinder {
    fn default() -> Self {
        Self::new()
    }
}
//! G0D SZIP — integer context-mixing literal coder (SZLZRC v3 "GOD stage").
//! Mirrors `native/mix.hpp` exactly: deterministic fixed-point math only.

use crate::rc::{RcDecoder, RcEncoder};
use crate::tables::{BIT_PRICE, SQUASH, SQUASH_BIAS, SQUASH_SHIFT, STRETCH};

pub const W_SHIFT: u32 = 13;
pub const ERR_SHIFT: u32 = 17;
pub const TREE_SHIFT: u32 = 5;
pub const W_CLAMP: i32 = 1 << 20;
pub const W_CTX: usize = 64;
const W_INIT: i32 = (1 << W_SHIFT) / 6;

/// Rolling history of the last 5 raw bytes (b[0] = most recent).
#[derive(Clone)]
pub struct Hist {
    pub b: [u8; 5],
    pub wpos: u8,
}

impl Hist {
    pub fn new() -> Self {
        Hist {
            b: [0; 5],
            wpos: 0,
        }
    }

    pub fn push(&mut self, v: u8) {
        self.b[4] = self.b[3];
        self.b[3] = self.b[2];
        self.b[2] = self.b[1];
        self.b[1] = self.b[0];
        self.b[0] = v;
        self.wpos = if v == 32 {
            0
        } else if self.wpos < 7 {
            self.wpos + 1
        } else {
            self.wpos
        };
    }
}

fn h1(a: u8) -> u32 {
    (a as u32) >> 3
}
fn h2(a: u8, b: u8, wp: u8) -> u32 {
    ((a as u32).wrapping_mul(2654435761)
        ^ (b as u32).wrapping_mul(40503)
        ^ (wp as u32).wrapping_mul(2246822519))
        >> 19
}
fn h3(a: u8, b: u8, c: u8, wp: u8) -> u32 {
    ((a as u32).wrapping_mul(2654435761)
        ^ (b as u32).wrapping_mul(40503)
        ^ (c as u32).wrapping_mul(805459861)
        ^ (wp as u32).wrapping_mul(2246822519))
        >> (32 - 17)
}
fn h4(a: u8, b: u8, c: u8, d: u8, wp: u8) -> u32 {
    ((a as u32).wrapping_mul(2654435761)
        ^ (b as u32).wrapping_mul(40503)
        ^ (c as u32).wrapping_mul(805459861)
        ^ (d as u32).wrapping_mul(1013904223)
        ^ (wp as u32).wrapping_mul(2246822519))
        >> (32 - 17)
}
fn h5(a: u8, b: u8, c: u8, d: u8, e: u8, wp: u8) -> u32 {
    ((a as u32).wrapping_mul(2654435761)
        ^ (b as u32).wrapping_mul(40503)
        ^ (c as u32).wrapping_mul(805459861)
        ^ (d as u32).wrapping_mul(1013904223)
        ^ (e as u32).wrapping_mul(2246822519)
        ^ (wp as u32).wrapping_mul(3266489917))
        >> (32 - 17)
}
fn hw(h: &Hist) -> u32 {
    ((h.wpos as u32) << 13) | ((h.b[0] as u32) << 5) | ((h.b[1] as u32) >> 3)
}
fn wctx(bitpos: u32, h: &Hist) -> usize {
    (bitpos + 8 * ((h.b[0] as u32) >> 5)) as usize
}

fn mix_with(w: &[[i32; 6]; W_CTX], wk: usize, ps: [u16; 6]) -> u32 {
    let mut x: i64 = 0;
    for i in 0..6 {
        x += w[wk][i] as i64 * STRETCH[ps[i] as usize] as i64;
    }
    x >>= W_SHIFT;
    if x > SQUASH_BIAS as i64 {
        x = SQUASH_BIAS as i64;
    }
    if x < -(SQUASH_BIAS as i64) {
        x = -(SQUASH_BIAS as i64);
    }
    SQUASH[((x + SQUASH_BIAS as i64) >> SQUASH_SHIFT) as usize] as u32
}

fn train_with(w: &mut [[i32; 6]; W_CTX], ns: [&mut u16; 6], bit: u32, p: u32) {
    let mut xs = [0i64; 6];
    let mut ii = 0usize;
    for n in ns {
        if bit == 0 {
            *n = (*n as u32 + ((2048 - *n as u32) >> TREE_SHIFT)) as u16;
        } else {
            *n = (*n as u32 - ((*n as u32) >> TREE_SHIFT)) as u16;
        }
        xs[ii] = STRETCH[*n as usize] as i64;
        ii += 1;
    }
    let err: i32 = if bit == 0 {
        2048 - p as i32
    } else {
        -(p as i32)
    };
    for i in 0..6 {
        let mut nw = w[wk][i] + ((err as i64 * xs[i]) >> ERR_SHIFT) as i32;
        if nw > W_CLAMP {
            nw = W_CLAMP;
        }
        if nw < -W_CLAMP {
            nw = -W_CLAMP;
        }
        w[wk][i] = nw;
    }
}

pub struct MixLit {
    t: [Vec<u16>; 6],
    w: [[i32; 6]; W_CTX],
}

impl MixLit {
    pub fn new() -> Self {
        MixLit {
            t: [
                vec![1024; 32 * 256],
                vec![1024; 8192 * 256],
                vec![1024; 131072 * 256],
                vec![1024; 131072 * 256],
                vec![1024; 131072 * 256],
                vec![1024; 65536 * 256],
            ],
            w: [[W_INIT; 6]; W_CTX],
        }
    }

    #[inline]
    fn idxs(h: &Hist, sym: u32) -> [usize; 6] {
        let s = sym as usize;
        [
            h1(h.b[0]) as usize * 256 + s,
            h2(h.b[0], h.b[1], h.wpos) as usize * 256 + s,
            h3(h.b[0], h.b[1], h.b[2], h.wpos) as usize * 256 + s,
            h4(h.b[0], h.b[1], h.b[2], h.b[3], h.wpos) as usize * 256 + s,
            h5(h.b[0], h.b[1], h.b[2], h.b[3], h.b[4], h.wpos) as usize * 256 + s,
            hw(h) as usize * 256 + s,
        ]
    }

    fn probs(&self, ix: [usize; 6]) -> [u16; 6] {
        [
            self.t[0][ix[0]],
            self.t[1][ix[1]],
            self.t[2][ix[2]],
            self.t[3][ix[3]],
            self.t[4][ix[4]],
            self.t[5][ix[5]],
        ]
    }

    /// Update models for one raw byte (no coding). Called for bytes covered
    /// by matches too, so prices stay calibrated.
    pub fn train_byte(&mut self, h: &mut Hist, byte: u8) {
        let mut sym: u32 = 1;
        for k in (0u32..8).rev() {
            let bit = ((byte >> k) & 1) as u32;
            let wk = wctx(7 - k, h);
            let ix = Self::idxs(h, sym);
            let p = mix_with(&self.w, wk, self.probs(ix));
            train_with(
                &mut self.w,
                [
                    &mut self.t[0][ix[0]],
                    &mut self.t[1][ix[1]],
                    &mut self.t[2][ix[2]],
                    &mut self.t[3][ix[3]],
                    &mut self.t[4][ix[4]],
                    &mut self.t[5][ix[5]],
                ],
                bit,
                p,
            );
            sym = (sym << 1) | bit;
        }
        h.push(byte);
    }

    pub fn encode(&mut self, rc: &mut RcEncoder, h: &mut Hist, byte: u8) {
        let mut sym: u32 = 1;
        for k in (0u32..8).rev() {
            let bit = ((byte >> k) & 1) as u32;
            let wk = wctx(7 - k, h);
            let ix = Self::idxs(h, sym);
            let p = mix_with(&self.w, wk, self.probs(ix));
            rc.encode_bit_p(p, bit);
            train_with(
                &mut self.w,
                [
                    &mut self.t[0][ix[0]],
                    &mut self.t[1][ix[1]],
                    &mut self.t[2][ix[2]],
                    &mut self.t[3][ix[3]],
                    &mut self.t[4][ix[4]],
                    &mut self.t[5][ix[5]],
                ],
                bit,
                p,
            );
            sym = (sym << 1) | bit;
        }
        h.push(byte);
    }

    pub fn decode(&mut self, rc: &mut RcDecoder, h: &Hist) -> u8 {
        let mut sym: u32 = 1;
        for k in 0u32..8 {
            let wk = wctx(k, h);
            let ix = Self::idxs(h, sym);
            let p = mix_with(&self.w, wk, self.probs(ix));
            let bit = rc.decode_bit_p(p);
            train_with(
                &mut self.w,
                [
                    &mut self.t[0][ix[0]],
                    &mut self.t[1][ix[1]],
                    &mut self.t[2][ix[2]],
                    &mut self.t[3][ix[3]],
                    &mut self.t[4][ix[4]],
                    &mut self.t[5][ix[5]],
                ],
                bit,
                p,
            );
            sym = (sym << 1) | bit;
        }
        (sym & 0xFF) as u8
    }

    /// Cost in 1/16 bits of coding `byte` from history `h` (no state change).
    pub fn peek(&self, h: &Hist, byte: u8) -> u32 {
        let mut sym: u32 = 1;
        let mut price: u32 = 0;
        for k in (0u32..8).rev() {
            let bit = (((byte >> k) & 1) as u32) as usize;
            let wk = wctx(7 - k, h);
            let ix = Self::idxs(h, sym);
            let p = mix_with(&self.w, wk, self.probs(ix));
            price += BIT_PRICE[if bit == 0 {
                p as usize
            } else {
                (2048 - p) as usize
            }];
            sym = (sym << 1) | bit as u32;
        }
        price
    }

    pub fn peek_span(&self, h: &Hist, src: &[u8], pos: usize, len: usize) -> u32 {
        let mut hh = h.clone();
        let mut price = 0u32;
        for i in 0..len {
            price += self.peek(&hh, src[pos + i]);
            hh.push(src[pos + i]);
        }
        price
    }
}
//! Adaptive binary range coder (carryless, 11-bit probabilities).
//! Original implementation, twin of native/rc.hpp.

pub const PROB_INIT: u16 = 1024;
const PROB_BITS: u32 = 11;
const PROB_MOVE_BITS: u32 = 5;
const TOP: u32 = 1 << 24;

pub struct RcEncoder {
    out: Vec<u8>,
    low: u64,
    range: u32,
    cache: u8,
    cache_size: u64,
}

impl RcEncoder {
    pub fn new() -> Self {
        RcEncoder {
            out: Vec::new(),
            low: 0,
            range: 0xFFFF_FFFF,
            cache: 0,
            cache_size: 1,
        }
    }

    pub fn encode_bit(&mut self, p: &mut u16, bit: u32) {
        let bound = (self.range >> PROB_BITS) * (*p as u32);
        if bit == 0 {
            self.range = bound;
            *p = (*p as u32 + ((2048 - *p as u32) >> PROB_MOVE_BITS)) as u16;
        } else {
            self.low += bound as u64;
            self.range -= bound;
            *p = (*p as u32 - ((*p as u32) >> PROB_MOVE_BITS)) as u16;
        }
        while self.range < TOP {
            self.range <<= 8;
            self.shift_low();
        }
    }

    /// Encode with an external probability (no prob update); `p` in
    /// `[1, 2047]` is `P(bit == 0)`.
    pub fn encode_bit_p(&mut self, p: u32, bit: u32) {
        let bound = (self.range >> PROB_BITS) * p;
        if bit == 0 {
            self.range = bound;
        } else {
            self.low += bound as u64;
            self.range -= bound;
        }
        while self.range < TOP {
            self.range <<= 8;
            self.shift_low();
        }
    }

    pub fn flush(&mut self) {
        for _ in 0..5 {
            self.shift_low();
        }
    }

    pub fn into_bytes(self) -> Vec<u8> {
        self.out
    }

    fn shift_low(&mut self) {
        let high = (self.low >> 32) as u32;
        if (self.low as u32) < 0xFF00_0000 || high != 0 {
            let mut temp = self.cache;
            loop {
                self.out.push(temp.wrapping_add(high as u8));
                temp = 0xFF;
                self.cache_size -= 1;
                if self.cache_size == 0 {
                    break;
                }
            }
            self.cache = ((self.low as u32) >> 24) as u8;
        }
        self.cache_size += 1;
        self.low = ((self.low as u32) as u64) << 8;
    }
}

impl Default for RcEncoder {
    fn default() -> Self {
        Self::new()
    }
}

pub struct RcDecoder<'a> {
    inp: &'a [u8],
    pos: usize,
    range: u32,
    code: u32,
    ok: bool,
}

impl<'a> RcDecoder<'a> {
    pub fn new(inp: &'a [u8]) -> Self {
        RcDecoder {
            inp,
            pos: 0,
            range: 0xFFFF_FFFF,
            code: 0,
            ok: true,
        }
    }

    /// Reads the 5-byte prologue (first byte must be 0). False on truncation.
    pub fn init(&mut self) -> bool {
        if self.inp.len() < 5 || self.inp[0] != 0 {
            return false;
        }
        self.pos = 1;
        self.code = 0;
        for _ in 0..4 {
            self.code = (self.code << 8) | self.next_byte() as u32;
        }
        self.ok
    }

    pub fn decode_bit(&mut self, p: &mut u16) -> u32 {
        let bound = (self.range >> PROB_BITS) * (*p as u32);
        let bit;
        if self.code < bound {
            self.range = bound;
            *p = (*p as u32 + ((2048 - *p as u32) >> PROB_MOVE_BITS)) as u16;
            bit = 0;
        } else {
            self.code -= bound;
            self.range -= bound;
            *p = (*p as u32 - ((*p as u32) >> PROB_MOVE_BITS)) as u16;
            bit = 1;
        }
        while self.range < TOP {
            self.range <<= 8;
            self.code = (self.code << 8) | self.next_byte() as u32;
        }
        bit
    }

    /// Decode with an external probability (no prob update); `p` in
    /// `[1, 2047]` is `P(bit == 0)`.
    pub fn decode_bit_p(&mut self, p: u32) -> u32 {
        let bound = (self.range >> PROB_BITS) * p;
        let bit;
        if self.code < bound {
            self.range = bound;
            bit = 0;
        } else {
            self.code -= bound;
            self.range -= bound;
            bit = 1;
        }
        while self.range < TOP {
            self.range <<= 8;
            self.code = (self.code << 8) | self.next_byte() as u32;
        }
        bit
    }

    pub fn ok(&self) -> bool {
        self.ok
    }

    pub fn pos(&self) -> usize {
        self.pos
    }

    fn next_byte(&mut self) -> u8 {
        if self.pos >= self.inp.len() {
            self.ok = false;
            return 0;
        }
        let b = self.inp[self.pos];
        self.pos += 1;
        b
    }
}
